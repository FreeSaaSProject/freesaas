  "widgets": ["stats", "loop"],
  "actions": [],
  "service": "diarize",
  "local_api_port": 18472,
  "capabilities": ["jobs", "results", "source_url"],
  "billing_units": ["audio_sec"],
  "remote_actions": [],
  "log_sources": {},
  "comment": "Embed-only CAM++ vectorizer for voice samples. Plugin id/service stay «diarize» for edge-host JSON. File WeSpeaker diarize is retired — use asr_dia for speakers. Default mode=embed (do not load file-diarize loop)."
