      "optional": false,
      "comment": "WeSpeaker CAM++-LM ONNX 512-d — sample embed + asr_dia ID (shared models path)."
    },
    {
      "id": "voxceleb_resnet34_LM",
      "path": "models/voxceleb_resnet34_LM.onnx",
      "url": "https://huggingface.co/Wespeaker/wespeaker-resnet34-LM/resolve/main/voxceleb_resnet34_LM.onnx?download=true",
      "optional": true,
      "comment": "Legacy ResNet34-LM ONNX 256-d (optional)."
    },
    {
      "id": "voxceleb_resnet34_LM_mlx",
      "path": "models/mlx/weights.npz",
