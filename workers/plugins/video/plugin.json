{
  "id": "video",
  "title": "Video (YOLO)",
  "version": "0.3.0",
  "entrypoint": "worker.py",
  "requirements": "requirements.txt",
  "status_file": "logs/status.json",
  "depends_binaries": ["ffmpeg"],
  "models": [
    {
      "id": "yolo11n",
      "path": "models/yolo11n.pt",
      "source": "ultralytics",
      "optional": true
    }
  ],
  "widgets": ["vpn", "cameras", "jobs", "dataset"],
  "actions": [
    "vpn_up",
    "vpn_down",
    "dataset_start_rtsp",
    "dataset_start_video",
    "dataset_stop",
    "dataset_upload",
    "save_loop"
  ],
  "service": "video",
  "local_api_port": 18472,
  "capabilities": ["jobs", "results", "results_file", "frame"],
  "billing_units": ["frame", "train_sec"],
  "remote_actions": ["vpn_up", "vpn_down"],
  "log_sources": {}
}
