# Storefront-only front controller (use on public vhost / copy).
# Prefer SetEnv FREESAAS_FRONT site on a shared tree instead of replacing .htaccess.

Options -Indexes
DirectorySlash Off
DirectoryIndex site.php index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP:Authorization} .
  RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^modules/[^/]+/assets/.+\.(css|js|png|jpe?g|gif|svg|webp|woff2?|ttf|otf|eot)$ - [L]

  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^themes/[^/]+/assets/.+\.(css|js|png|jpe?g|gif|svg|webp|woff2?|ttf|otf|eot)$ - [L]

  RewriteRule ^modules/?$ site.php [L,QSA]
  RewriteRule ^modules/ site.php [L,QSA]

  # Deny before !-f front controller — existing files under these dirs must not be served.
  # var/ = sessions, dumps, setup.key; log/ = logs; .git/ = clone deploy leak.
  RewriteRule ^(app|cfg|bin|docs|var|log)/ - [F,L]
  RewriteRule ^\.git(/|$) - [F,L]
  RewriteRule ^themes/[^/]+/(layouts|views|partials)/ - [F,L]

  # Legacy 1C proxy PATH_INFO (/api1c.php/client_by_card) → storefront front controller.
  RewriteRule ^api1c\.php(?:/.*)?$ site.php [L,QSA]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ site.php [L,QSA]
</IfModule>
