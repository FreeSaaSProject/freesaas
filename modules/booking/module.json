{
    "id": "booking",
    "name": "booking.module.name",
    "description": "booking.module.description",
    "version": "1.0.0",
    "type": "product",
    "runtime": "both",
    "requires": {
        "core": ">=1.0.0",
        "catalog": ">=1.0.0",
        "clients": ">=1.0.0",
        "workweeks": ">=1.0.0",
        "calendar": ">=1.0.0"
    },
    "optionalRequires": {
        "orders": ">=1.0.0",
        "procedures": ">=1.0.0",
        "rates": ">=1.0.0"
    },
    "provides": [
        "booking.slots",
        "booking.availability",
        "booking.book"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "booking.view",
            "label": "booking.perm.view"
        },
        {
            "id": "booking.edit",
            "label": "booking.perm.edit"
        }
    ],
    "routes": {
        "pages": [
            "/booking/new",
            "/booking/availability",
            "/booking/book",
            "/booking/clients",
            "/booking/orders",
            "/booking/cancel",
            "/booking/settings"
        ]
    },
    "agent": {
        "docs": "docs/agents/booking.md",
        "ops": [
            {
                "id": "booking.new",
                "method": "GET",
                "path": "/booking/new",
                "permission": "booking.edit",
                "description": "Staff booking UI; query date, product_ids[], operator_id|staff, hour, ret"
            },
            {
                "id": "booking.availability",
                "method": "GET",
                "path": "/booking/availability",
                "permission": "booking.view",
                "description": "Slots for date + product_ids (+ optional operator_id); filters by rates/restrict/shifts like legacy shop"
            },
            {
                "id": "booking.book",
                "method": "POST",
                "path": "/booking/book",
                "permission": "booking.edit",
                "side_effect": "write",
                "description": "Create advance order + ensure client card: phone, product_ids, operator_id, dt_start, optional client_name/client_id/comment",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "phone": {
                            "type": "string"
                        },
                        "product_ids": {
                            "type": "array",
                            "items": {
                                "type": "integer"
                            }
                        },
                        "operator_id": {
                            "type": "integer"
                        },
                        "dt_start": {
                            "type": "integer"
                        }
                    },
                    "required": [
                        "phone",
                        "product_ids",
                        "operator_id",
                        "dt_start"
                    ]
                }
            },
            {
                "id": "booking.clients",
                "method": "GET",
                "path": "/booking/clients",
                "permission": "booking.edit",
                "description": "Client phone digit search for booking UI; query q=digits&limit="
            },
            {
                "id": "booking.orders",
                "method": "GET",
                "path": "/booking/orders",
                "permission": "booking.view",
                "side_effect": "read",
                "description": "Future advance orders for client_id",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "client_id": {
                            "type": "integer"
                        }
                    },
                    "required": [
                        "client_id"
                    ]
                }
            },
            {
                "id": "booking.cancel",
                "method": "POST",
                "path": "/booking/cancel",
                "permission": "booking.edit",
                "side_effect": "write",
                "description": "Cancel advance order for client: order_id + client_id → userCancelPay",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "order_id": {
                            "type": "integer"
                        },
                        "client_id": {
                            "type": "integer"
                        }
                    },
                    "required": [
                        "order_id",
                        "client_id"
                    ]
                }
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "calendar.menu.group",
            "num": 15,
            "kind": "work",
            "path": "/booking/new",
            "title": "booking.menu.new",
            "permission": "booking.edit"
        }
    ],
    "configSchema": [],
    "tables": [],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "calendar.settings.sections",
            "calendar.settings.save"
        ],
        "publish": [
            "booking.book.before",
            "booking.book.after"
        ]
    },
    "catalog": {
        "categories": [
            "booking",
            "site"
        ],
        "maturity": "release",
        "tags": [
            "journal"
        ],
        "screenshots": []
    }
}
