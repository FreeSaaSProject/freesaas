{
    "id": "bots",
    "name": "bots.module.name",
    "description": "bots.module.description",
    "version": "1.0.2",
    "type": "product",
    "requires": {
        "core": ">=1.0.0"
    },
    "optionalRequires": {
        "clients": ">=1.0.0",
        "assistant_groups": ">=1.0.0",
        "orders": ">=1.0.0"
    },
    "provides": [
        "bots.transport"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "bots.manage",
            "label": "bots.perm.manage"
        },
        {
            "id": "bots.view",
            "label": "bots.perm.view"
        },
        {
            "id": "bots.message",
            "label": "bots.perm.message"
        }
    ],
    "routes": {
        "pages": [
            "/bots/types/{audience}",
            "/bots/settings",
            "/bots/sends",
            "/bots/sends/work",
            "/bots/sends/test",
            "/bots/plugins",
            "/bots/recipients",
            "/bots/message",
            "/bots/webhook/telegram/{channel}",
            "/bots/webhook/max/{channel}",
            "/agent/bots/settings",
            "/agent/bots/webhook/subscribe",
            "/agent/bots/link-code",
            "/agent/bots/unlink"
        ]
    },
    "agent": {
        "docs": "docs/agents/bots.md",
        "ops": [
            {
                "id": "bots.type.get",
                "method": "GET",
                "path": "/bots/types/{audience}",
                "permission": "bots.view",
                "description": "Bot type overview: channels, plugins, outbound hooks; audience=staff|client"
            },
            {
                "id": "bots.settings.get",
                "method": "GET",
                "path": "/bots/settings",
                "permission": "bots.manage",
                "description": "Channel config (tokens masked), webhook URL hints"
            },
            {
                "id": "bots.settings.save",
                "method": "POST",
                "path": "/bots/settings",
                "permission": "bots.manage",
                "description": "Save cfg/modules/bots.ini channel tokens/secrets"
            },
            {
                "id": "bots.queue.list",
                "method": "GET",
                "path": "/bots/sends",
                "permission": "bots.view",
                "description": "List outbound queue; filters: status, audience, q"
            },
            {
                "id": "bots.queue.drain",
                "method": "POST",
                "path": "/bots/sends/work",
                "permission": "bots.manage",
                "side_effect": "write",
                "assistant": false,
                "description": "Drain pending sends (session SUPERADMIN). Prefer platform POST /cron/tick?job=bots.sends_drain&force=1 with agent_token. Body/query: limit, audience"
            },
            {
                "id": "bots.send.test",
                "method": "POST",
                "path": "/bots/sends/test",
                "permission": "bots.manage",
                "assistant": false,
                "description": "Enqueue+optional drain test message; body: user_id, text, audience"
            },
            {
                "id": "bots.recipients.list",
                "method": "GET",
                "path": "/bots/recipients",
                "permission": "bots.message",
                "description": "Linked staff + linked clients + known Max groups. Filter q=name|phone. Use before bots.message.send"
            },
            {
                "id": "bots.message.send",
                "method": "POST",
                "path": "/bots/message",
                "permission": "bots.message",
                "side_effect": "write",
                "description": "Queue messenger text: user_id (staff), client_id (client bot), or chat_id+platform=max (known group). Only bots.recipients.list. Cron drains. Body: text, user_id|client_id|chat_id, optional dry_run=1"
            },
            {
                "id": "bots.plugins.list",
                "method": "GET",
                "path": "/bots/plugins",
                "permission": "bots.manage",
                "description": "Registered BotPlugins ids, priorities, handler flags"
            }
        ]
    },
    "jobs": [
        "platform Cron::register bots.sends_drain → /cron/tick",
        "POST /bots/sends/work (session)"
    ],
    "menu": [
        {
            "group": "bots.menu.group",
            "kind": "work",
            "num": 10,
            "path": "/bots/types/staff",
            "title": "bots.menu.type.staff",
            "permission": "bots.view",
            "capability": "SUPERADMIN_ACCESS"
        },
        {
            "group": "bots.menu.group",
            "kind": "crud",
            "num": 30,
            "path": "/bots/sends",
            "title": "bots.menu.sends",
            "permission": "bots.view",
            "capability": "SUPERADMIN_ACCESS"
        },
        {
            "group": "bots.menu.group",
            "kind": "settings",
            "num": 40,
            "path": "/bots/settings",
            "title": "bots.menu.settings",
            "permission": "bots.manage",
            "capability": "SUPERADMIN_ACCESS"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_telegram_sends",
        "base_bot_links",
        "base_bot_chat_state",
        "base_bot_webhook_updates",
        "base_bot_link_codes",
        "base_bot_link_throttle"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "core.user_edit.sections",
            "core.user_edit.save",
            "core.user_edit.profile",
            "core.users.list",
            "clients.edit.sections",
            "clients.edit.save",
            "clients.view.profile",
            "clients.list",
            "bots.send",
            "notify.send",
            "assistant.write.preview",
            "assistant.system.hints"
        ],
        "publish": [
            "bots.send",
            "notify.send",
            "bots.cabinet.collect",
            "bots.inbound",
            "bots.ready"
        ]
    },
    "catalog": {
        "categories": [
            "communications"
        ],
        "maturity": "release",
        "tags": [],
        "screenshots": []
    },
    "setup": {
        "steps": [
            {
                "id": "config",
                "title": "bots.setup.step.config",
                "description": "bots.setup.step.config_help",
                "href": "/bots",
                "ask_user": "bots.setup.ask.config",
                "choices": [
                    {
                        "id": "open",
                        "label": "bots.setup.choice.open",
                        "recommended": true
                    },
                    {
                        "id": "defer",
                        "label": "core.modules.setup.choice.defer",
                        "recommended": false
                    }
                ],
                "agent_can": []
            }
        ]
    }
}
