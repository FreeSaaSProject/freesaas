{
    "id": "audio_dicts",
    "name": "audio_dicts.module.name",
    "description": "audio_dicts.module.description",
    "version": "1.0.17",
    "type": "product",
    "requires": {
        "core": ">=1.0.0",
        "audio": ">=1.0.0"
    },
    "optionalRequires": {
        "audio_reports": ">=1.0.0",
        "audio_pipeline": ">=1.0.0",
        "llm": ">=1.0.0"
    },
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "audio_dicts.view",
            "label": "audio_dicts.perm.view"
        },
        {
            "id": "audio_dicts.edit",
            "label": "audio_dicts.perm.edit"
        },
        {
            "id": "audio_dicts.delete",
            "label": "audio_dicts.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/audio/dicts",
            "/audio/dicts/new",
            "/audio/dicts/{id}/edit",
            "/audio/dicts/{id}/suggest-descr",
            "/audio/keys",
            "/audio/keys/new",
            "/audio/keys/{id}/edit",
            "/audio/keys/check-overlap",
            "/audio/tags",
            "/audio/tags/new",
            "/audio/tags/{id}/edit",
            "/audio/trashes",
            "/audio/trashes/new",
            "/audio/trashes/{id}/edit",
            "/audio/scripts",
            "/audio/scripts/new",
            "/audio/scripts/import",
            "/audio/scripts/{id}",
            "/audio/scripts/{id}/parts",
            "/audio/scripts/{id}/download",
            "/audio/scripts/{id}/copy",
            "/agent/audio_dicts/scripts",
            "/agent/audio_dicts/script",
            "/agent/audio_dicts/script/part",
            "/agent/audio_dicts/script/part/delete",
            "/agent/audio_dicts/dicts",
            "/agent/audio_dicts/dict",
            "/agent/audio_dicts/keys",
            "/agent/audio_dicts/key",
            "/agent/audio_dicts/keys/check-overlap",
            "/agent/audio_dicts/key/delete"
        ]
    },
    "agent": {
        "docs": "docs/agents/audio_dicts.md",
        "ops": [
            {
                "id": "audio_dicts.agent.scripts_list",
                "method": "GET",
                "path": "/agent/audio_dicts/scripts",
                "permission": "public",
                "assistant": false,
                "description": "Agent-token: list root scripts (see audio-scripts-debug.md)"
            },
            {
                "id": "audio_dicts.agent.script_get",
                "method": "GET",
                "path": "/agent/audio_dicts/script",
                "permission": "public",
                "assistant": false,
                "description": "Agent-token: script tree + fingerprint; query id="
            },
            {
                "id": "audio_dicts.agent.script_save",
                "method": "POST",
                "path": "/agent/audio_dicts/script",
                "permission": "public",
                "assistant": false,
                "side_effect": "write",
                "description": "Agent-token: full script save; body id, confirm=1, meta{}, parts[]"
            },
            {
                "id": "audio_dicts.agent.script_part_save",
                "method": "POST",
                "path": "/agent/audio_dicts/script/part",
                "permission": "public",
                "assistant": false,
                "side_effect": "write",
                "description": "Agent-token: upsert one part; body script_id, confirm=1, part{}"
            },
            {
                "id": "audio_dicts.agent.script_part_delete",
                "method": "POST",
                "path": "/agent/audio_dicts/script/part/delete",
                "permission": "public",
                "assistant": false,
                "side_effect": "write",
                "description": "Agent-token: delete one part; body script_id, part_id, confirm=1"
            },
            {
                "id": "audio_dicts.agent.dicts_list",
                "method": "GET",
                "path": "/agent/audio_dicts/dicts",
                "permission": "public",
                "assistant": false,
                "description": "Agent-token: list dictionaries"
            },
            {
                "id": "audio_dicts.agent.dict_get",
                "method": "GET",
                "path": "/agent/audio_dicts/dict",
                "permission": "public",
                "assistant": false,
                "description": "Agent-token: one dictionary + key count; query id="
            },
            {
                "id": "audio_dicts.agent.keys_list",
                "method": "GET",
                "path": "/agent/audio_dicts/keys",
                "permission": "public",
                "assistant": false,
                "description": "Agent-token: keys for a dictionary; query dict="
            },
            {
                "id": "audio_dicts.agent.key_get",
                "method": "GET",
                "path": "/agent/audio_dicts/key",
                "permission": "public",
                "assistant": false,
                "description": "Agent-token: one key by id= or name="
            },
            {
                "id": "audio_dicts.agent.keys_check_overlap",
                "method": "GET",
                "path": "/agent/audio_dicts/keys/check-overlap",
                "permission": "public",
                "assistant": false,
                "description": "Agent-token: overlap preview before create; query name="
            },
            {
                "id": "audio_dicts.agent.key_save",
                "method": "POST",
                "path": "/agent/audio_dicts/key",
                "permission": "public",
                "assistant": false,
                "side_effect": "write",
                "description": "Agent-token: create/update key; confirm=1, name, dict; force=1 for hard overlaps"
            },
            {
                "id": "audio_dicts.agent.key_delete",
                "method": "POST",
                "path": "/agent/audio_dicts/key/delete",
                "permission": "public",
                "assistant": false,
                "side_effect": "write",
                "description": "Agent-token: delete key; body id, confirm=1"
            },
            {
                "id": "audio_dicts.dicts.list",
                "method": "GET",
                "path": "/audio/dicts",
                "permission": "audio_dicts.view",
                "description": "List dictionaries; filter q"
            },
            {
                "id": "audio_dicts.dicts.get",
                "method": "GET",
                "path": "/audio/dicts/{id}/edit",
                "permission": "audio_dicts.edit",
                "description": "One dictionary"
            },
            {
                "id": "audio_dicts.dicts.create",
                "method": "POST",
                "path": "/audio/dicts/new",
                "permission": "audio_dicts.edit",
                "description": "Create dictionary"
            },
            {
                "id": "audio_dicts.dicts.update",
                "method": "POST",
                "path": "/audio/dicts/{id}/edit",
                "permission": "audio_dicts.edit",
                "description": "Update dictionary"
            },
            {
                "id": "audio_dicts.dicts.suggest_descr",
                "method": "POST",
                "path": "/audio/dicts/{id}/suggest-descr",
                "permission": "audio_dicts.edit",
                "description": "LLM draft DESCR from keys; ?save=1 to persist; Accept: application/json"
            },
            {
                "id": "audio_dicts.keys.list",
                "method": "GET",
                "path": "/audio/keys",
                "permission": "audio_dicts.view",
                "description": "List keys; filters q, dict"
            },
            {
                "id": "audio_dicts.keys.get",
                "method": "GET",
                "path": "/audio/keys/{id}/edit",
                "permission": "audio_dicts.edit",
                "description": "One key with dict options"
            },
            {
                "id": "audio_dicts.keys.create",
                "method": "POST",
                "path": "/audio/keys/new",
                "permission": "audio_dicts.edit",
                "description": "Create key"
            },
            {
                "id": "audio_dicts.keys.update",
                "method": "POST",
                "path": "/audio/keys/{id}/edit",
                "permission": "audio_dicts.edit",
                "description": "Update key"
            },
            {
                "id": "audio_dicts.tags.list",
                "method": "GET",
                "path": "/audio/tags",
                "permission": "audio_dicts.view",
                "description": "List key tags; filter q"
            },
            {
                "id": "audio_dicts.tags.get",
                "method": "GET",
                "path": "/audio/tags/{id}/edit",
                "permission": "audio_dicts.edit",
                "description": "One key tag"
            },
            {
                "id": "audio_dicts.tags.create",
                "method": "POST",
                "path": "/audio/tags/new",
                "permission": "audio_dicts.edit",
                "description": "Create key tag"
            },
            {
                "id": "audio_dicts.tags.update",
                "method": "POST",
                "path": "/audio/tags/{id}/edit",
                "permission": "audio_dicts.edit",
                "description": "Update key tag"
            },
            {
                "id": "audio_dicts.trashes.list",
                "method": "GET",
                "path": "/audio/trashes",
                "permission": "audio_dicts.view",
                "description": "List trash phrases; filter q"
            },
            {
                "id": "audio_dicts.trashes.get",
                "method": "GET",
                "path": "/audio/trashes/{id}/edit",
                "permission": "audio_dicts.edit",
                "description": "One trash phrase"
            },
            {
                "id": "audio_dicts.trashes.create",
                "method": "POST",
                "path": "/audio/trashes/new",
                "permission": "audio_dicts.edit",
                "description": "Create trash phrase"
            },
            {
                "id": "audio_dicts.trashes.update",
                "method": "POST",
                "path": "/audio/trashes/{id}/edit",
                "permission": "audio_dicts.edit",
                "description": "Update trash phrase"
            },
            {
                "id": "audio_dicts.scripts.list",
                "method": "GET",
                "path": "/audio/scripts",
                "permission": "audio_dicts.view",
                "description": "List script roots"
            },
            {
                "id": "audio_dicts.scripts.get",
                "method": "GET",
                "path": "/audio/scripts/{id}",
                "permission": "audio_dicts.view",
                "description": "Script tree with parts; POST to save"
            },
            {
                "id": "audio_dicts.scripts.create",
                "method": "POST",
                "path": "/audio/scripts/new",
                "permission": "audio_dicts.edit",
                "description": "Create script with parts"
            },
            {
                "id": "audio_dicts.scripts.download",
                "method": "GET",
                "path": "/audio/scripts/{id}/download",
                "permission": "audio_dicts.view",
                "description": "Download JSON script pack (dict names by default; ?keys=1 embeds dictionaries/keys)"
            },
            {
                "id": "audio_dicts.scripts.import",
                "method": "POST",
                "path": "/audio/scripts/import",
                "permission": "audio_dicts.edit",
                "description": "Import JSON script pack; missing dicts created empty; keys merged when present"
            },
            {
                "id": "audio_dicts.scripts.copy",
                "method": "GET",
                "path": "/audio/scripts/{id}/copy",
                "permission": "audio_dicts.edit",
                "description": "Duplicate script in same DB (GET or POST)"
            },
            {
                "id": "audio_dicts.scripts.parts",
                "method": "POST",
                "path": "/audio/scripts/{id}/parts",
                "permission": "audio_dicts.edit",
                "assistant": false,
                "description": "Canvas part API: reorder|save|add|delete"
            },
            {
                "id": "audio_dicts.scripts.delete",
                "method": "POST",
                "path": "/audio/scripts/{id}",
                "permission": "audio_dicts.delete",
                "side_effect": "write",
                "description": "Delete script and parts; POST action=delete"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "audio.menu.group",
            "kind": "crud",
            "num": 10,
            "path": "/audio/dicts",
            "title": "audio_dicts.menu.dicts"
        },
        {
            "group": "audio.menu.group",
            "kind": "crud",
            "num": 11,
            "path": "/audio/keys",
            "title": "audio_dicts.menu.keys"
        },
        {
            "group": "audio.menu.group",
            "kind": "crud",
            "num": 12,
            "path": "/audio/scripts",
            "title": "audio_dicts.menu.scripts"
        },
        {
            "group": "audio.menu.group",
            "kind": "crud",
            "num": 14,
            "path": "/audio/trashes",
            "title": "audio_dicts.menu.trashes"
        },
        {
            "group": "audio.menu.group",
            "kind": "crud",
            "num": 15,
            "path": "/audio/tags",
            "title": "audio_dicts.menu.tags"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_records_dictonarys",
        "base_records_keys",
        "base_records_keys_tags",
        "base_records_keys_tags_links",
        "base_records_scripts",
        "base_records_trashes"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [],
        "publish": [
            "audio_dicts.changed"
        ]
    },
    "catalog": {
        "categories": [
            "audio"
        ],
        "maturity": "release",
        "tags": [],
        "screenshots": []
    },
    "setup": {
        "steps": [
            {
                "id": "ready",
                "title": "audio_dicts.setup.step.ready",
                "description": "audio_dicts.setup.step.ready_help",
                "href": "/audio_dicts",
                "ask_user": "audio_dicts.setup.ask.ready",
                "choices": [
                    {
                        "id": "open",
                        "label": "audio_dicts.setup.choice.open",
                        "recommended": true
                    },
                    {
                        "id": "defer",
                        "label": "core.modules.setup.choice.defer",
                        "recommended": false
                    }
                ],
                "agent_can": [
                    "mark_done"
                ]
            }
        ]
    }
}
