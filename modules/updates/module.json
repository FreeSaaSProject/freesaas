{
    "id": "updates",
    "name": "updates.module.name",
    "description": "updates.module.description",
    "version": "1.0.4",
    "type": "product",
    "catalog": {
        "categories": [
            "platform"
        ],
        "maturity": "release",
        "tags": [
            "settings",
            "jobs"
        ],
        "screenshots": []
    },
    "requires": {
        "core": ">=1.0.0"
    },
    "optionalRequires": [],
    "provides": [
        "updates.self"
    ],
    "uninstall": {
        "strategy": "leave_tables"
    },
    "permissions": [
        {
            "id": "updates.view",
            "label": "updates.perm.view"
        },
        {
            "id": "updates.apply",
            "label": "updates.perm.apply"
        }
    ],
    "routes": {
        "pages": [
            "/updates",
            "/updates/settings",
            "/updates/check",
            "/updates/apply"
        ]
    },
    "agent": {
        "docs": "docs/agents/update.md",
        "ops": [
            {
                "id": "updates.status",
                "method": "GET",
                "path": "/updates",
                "permission": "updates.view",
                "side_effect": "read",
                "description": "Cached update board: local/remote versions, last_check, available_count. Prefer updates.check for a fresh remote poll. Needs updates.view.",
                "parameters": {
                    "type": "object",
                    "properties": []
                }
            },
            {
                "id": "updates.settings",
                "method": "GET",
                "path": "/updates/settings",
                "permission": "updates.view",
                "side_effect": "read",
                "description": "Read update settings: core source (repo/channel/ref/asset) and private sources[] ([module.<id>] / [theme.<id>]: kind, id, package, repo, channel, ref, path_prefix, token_set — never raw tokens). Needs updates.view.",
                "parameters": {
                    "type": "object",
                    "properties": []
                }
            },
            {
                "id": "updates.settings.save",
                "method": "POST",
                "path": "/updates/settings",
                "permission": "updates.apply",
                "side_effect": "write",
                "description": "Save update source in cfg/updates.ini. SUPERADMIN + updates.apply. Body: repo, channel, token?, clear_token?, ref?, asset?, db_backup_before_migrate?.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "repo": {
                            "type": "string"
                        },
                        "channel": {
                            "type": "string",
                            "enum": [
                                "main",
                                "stable",
                                "latest"
                            ]
                        },
                        "token": {
                            "type": "string"
                        },
                        "clear_token": {
                            "type": "string"
                        },
                        "ref": {
                            "type": "string"
                        },
                        "asset": {
                            "type": "string"
                        },
                        "db_backup_before_migrate": {
                            "type": "string",
                            "description": "1 or 0"
                        }
                    }
                }
            },
            {
                "id": "updates.sources.save",
                "method": "POST",
                "path": "/updates/settings",
                "permission": "updates.apply",
                "side_effect": "write",
                "description": "Add or edit a private update source (module or storefront theme from its own repo) and check it right away. SUPERADMIN + updates.apply. Body: action=source_save, kind=module|theme, id, repo=owner/name, channel (main|stable|<branch>|vX.Y.Z), path_prefix (folder in repo, e.g. modules/my_mod or themes/my_theme; empty = module.json/theme.json at root), ref?, token? (GitHub PAT with Contents:read; empty keeps the saved one), clear_token?. Response: source (masked) + check {ok, remote_version, error}. Ask the user for the token — never invent it.",
                "parameters": {
                    "type": "object",
                    "required": ["action", "kind", "id", "repo"],
                    "properties": {
                        "action": {"type": "string", "enum": ["source_save"]},
                        "kind": {"type": "string", "enum": ["module", "theme"]},
                        "id": {"type": "string", "description": "Module id (modules/<id>) or theme id (themes/<id>)"},
                        "repo": {"type": "string", "description": "GitHub owner/name"},
                        "channel": {"type": "string", "description": "main (default), stable, branch or tag"},
                        "path_prefix": {"type": "string", "description": "Folder of the module/theme inside the repo"},
                        "ref": {"type": "string"},
                        "token": {"type": "string", "description": "GitHub PAT, Contents: read-only on that repo"},
                        "clear_token": {"type": "string", "description": "1 to remove the saved token"}
                    }
                }
            },
            {
                "id": "updates.sources.delete",
                "method": "POST",
                "path": "/updates/settings",
                "permission": "updates.apply",
                "side_effect": "write",
                "description": "Remove a private update source ([module.<id>] / [theme.<id>]); files stay on disk. SUPERADMIN + updates.apply. Body: action=source_delete, kind=module|theme, id.",
                "parameters": {
                    "type": "object",
                    "required": ["action", "kind", "id"],
                    "properties": {
                        "action": {"type": "string", "enum": ["source_delete"]},
                        "kind": {"type": "string", "enum": ["module", "theme"]},
                        "id": {"type": "string"}
                    }
                }
            },
            {
                "id": "updates.check",
                "method": "GET",
                "path": "/updates/check",
                "permission": "updates.view",
                "side_effect": "read",
                "description": "Fresh remote check (Contents API). Use when user asks if updates exist / what is new. Optional target=core|module_id|theme:<theme_id>; omit for all. Needs updates.view. Summarize available packages briefly.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "target": {
                            "type": "string",
                            "description": "core, module id, theme:<id>, or omit for all"
                        }
                    }
                }
            },
            {
                "id": "updates.apply",
                "method": "POST",
                "path": "/updates/apply",
                "permission": "updates.apply",
                "side_effect": "write",
                "description": "Apply update overlay + migrate. SUPERADMIN + updates.apply only. Prefer updates.check first. Body: target=core|module_id|theme:<id>|all, migrate=1|0. Queues Confirm/Cancel — never claim success until confirm.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "target": {
                            "type": "string",
                            "description": "core, module id, theme:<id>, or all"
                        },
                        "migrate": {
                            "type": "string",
                            "description": "1 (default) or 0 to skip schema migrate"
                        }
                    }
                }
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.system",
            "kind": "work",
            "num": 0,
            "path": "/updates",
            "title": "updates.menu.list"
        },
        {
            "group": "core.menu.group.system",
            "kind": "settings",
            "num": 5,
            "path": "/updates/settings",
            "title": "updates.menu.settings"
        }
    ],
    "configSchema": [],
    "tables": [],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "core.notices.collect"
        ],
        "publish": []
    },
    "setup": {
        "steps": [
            {
                "id": "source",
                "title": "updates.setup.step.source",
                "description": "updates.setup.step.source_help",
                "href": "/updates/settings",
                "ask_user": "updates.setup.ask.source",
                "choices": [
                    {
                        "id": "open",
                        "label": "updates.setup.choice.open",
                        "recommended": true
                    },
                    {
                        "id": "defer",
                        "label": "core.modules.setup.choice.defer",
                        "recommended": false
                    }
                ],
                "agent_can": []
            }
        ]
    }
}
