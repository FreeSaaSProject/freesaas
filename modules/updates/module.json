{
    "id": "updates",
    "name": "updates.module.name",
    "description": "updates.module.description",
    "version": "1.0.1",
    "type": "product",
    "catalog": {
        "categories": [
            "platform"
        ],
        "maturity": "release",
        "tags": [
            "settings",
            "jobs"
        ],
        "screenshots": []
    },
    "requires": {
        "core": ">=1.0.0"
    },
    "optionalRequires": [],
    "provides": [
        "updates.self"
    ],
    "uninstall": {
        "strategy": "leave_tables"
    },
    "permissions": [
        {
            "id": "updates.view",
            "label": "updates.perm.view"
        },
        {
            "id": "updates.apply",
            "label": "updates.perm.apply"
        }
    ],
    "routes": {
        "pages": [
            "/updates",
            "/updates/settings",
            "/updates/check",
            "/updates/apply"
        ]
    },
    "agent": {
        "docs": "docs/agents/update.md",
        "ops": [
            {
                "id": "updates.status",
                "method": "GET",
                "path": "/updates",
                "permission": "updates.view",
                "side_effect": "read",
                "description": "Cached update board: local/remote versions, last_check, available_count. Prefer updates.check for a fresh remote poll. Needs updates.view.",
                "parameters": {
                    "type": "object",
                    "properties": []
                }
            },
            {
                "id": "updates.settings",
                "method": "GET",
                "path": "/updates/settings",
                "permission": "updates.view",
                "side_effect": "read",
                "description": "Read update source settings (repo/channel/ref/asset, token_set flag — never the raw token). Needs updates.view.",
                "parameters": {
                    "type": "object",
                    "properties": []
                }
            },
            {
                "id": "updates.settings.save",
                "method": "POST",
                "path": "/updates/settings",
                "permission": "updates.apply",
                "side_effect": "write",
                "description": "Save update source in cfg/updates.ini. SUPERADMIN + updates.apply. Body: repo, channel, token?, clear_token?, ref?, asset?, db_backup_before_migrate?.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "repo": {
                            "type": "string"
                        },
                        "channel": {
                            "type": "string",
                            "enum": [
                                "main",
                                "stable",
                                "latest"
                            ]
                        },
                        "token": {
                            "type": "string"
                        },
                        "clear_token": {
                            "type": "string"
                        },
                        "ref": {
                            "type": "string"
                        },
                        "asset": {
                            "type": "string"
                        },
                        "db_backup_before_migrate": {
                            "type": "string",
                            "description": "1 or 0"
                        }
                    }
                }
            },
            {
                "id": "updates.check",
                "method": "GET",
                "path": "/updates/check",
                "permission": "updates.view",
                "side_effect": "read",
                "description": "Fresh remote check (Contents API). Use when user asks if updates exist / what is new. Optional target=core|module_id; omit for all. Needs updates.view. Summarize available packages briefly.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "target": {
                            "type": "string",
                            "description": "core, module id, or omit for all"
                        }
                    }
                }
            },
            {
                "id": "updates.apply",
                "method": "POST",
                "path": "/updates/apply",
                "permission": "updates.apply",
                "side_effect": "write",
                "description": "Apply update overlay + migrate. SUPERADMIN + updates.apply only. Prefer updates.check first. Body: target=core|module_id|all, migrate=1|0. Queues Confirm/Cancel — never claim success until confirm.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "target": {
                            "type": "string",
                            "description": "core, module id, or all"
                        },
                        "migrate": {
                            "type": "string",
                            "description": "1 (default) or 0 to skip schema migrate"
                        }
                    }
                }
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.system",
            "kind": "work",
            "num": 0,
            "path": "/updates",
            "title": "updates.menu.list"
        },
        {
            "group": "core.menu.group.system",
            "kind": "settings",
            "num": 5,
            "path": "/updates/settings",
            "title": "updates.menu.settings"
        }
    ],
    "configSchema": [],
    "tables": [],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "core.notices.collect"
        ],
        "publish": []
    },
    "setup": {
        "steps": [
            {
                "id": "source",
                "title": "updates.setup.step.source",
                "description": "updates.setup.step.source_help",
                "href": "/updates/settings",
                "ask_user": "updates.setup.ask.source",
                "choices": [
                    {
                        "id": "open",
                        "label": "updates.setup.choice.open",
                        "recommended": true
                    },
                    {
                        "id": "defer",
                        "label": "core.modules.setup.choice.defer",
                        "recommended": false
                    }
                ],
                "agent_can": []
            }
        ]
    }
}
