{
    "id": "updates",
    "name": "updates.module.name",
    "description": "updates.module.description",
    "version": "0.3.13",
    "type": "product",
    "catalog": {
        "categories": [
            "platform"
        ],
        "maturity": "beta",
        "tags": [
            "settings",
            "jobs"
        ],
        "screenshots": []
    },
    "requires": {
        "core": ">=0.3.0"
    },
    "optionalRequires": [],
    "provides": [
        "updates.self"
    ],
    "uninstall": {
        "strategy": "leave_tables"
    },
    "permissions": [
        {
            "id": "updates.view",
            "label": "updates.perm.view"
        },
        {
            "id": "updates.apply",
            "label": "updates.perm.apply"
        }
    ],
    "routes": {
        "pages": [
            "/updates",
            "/updates/settings",
            "/updates/check",
            "/updates/apply"
        ]
    },
    "agent": {
        "ops": [
            {
                "id": "updates.status",
                "method": "GET",
                "path": "/updates",
                "permission": "updates.view",
                "description": "Packages (local/remote versions, last_check, available_count) + source. Twin: GET /agent/update",
                "parameters": {
                    "type": "object",
                    "properties": {}
                }
            },
            {
                "id": "updates.settings",
                "method": "GET",
                "path": "/updates/settings",
                "permission": "updates.view",
                "description": "Read update source settings (repo/channel/token_set). Twin: configure cfg/updates.ini",
                "parameters": {
                    "type": "object",
                    "properties": {}
                }
            },
            {
                "id": "updates.settings.save",
                "method": "POST",
                "path": "/updates/settings",
                "permission": "updates.apply",
                "side_effect": "write",
                "description": "Save [core] in cfg/updates.ini. SUPERADMIN. Body: repo, channel, token?, clear_token?, ref?, asset?",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "repo": {
                            "type": "string"
                        },
                        "channel": {
                            "type": "string"
                        },
                        "token": {
                            "type": "string"
                        },
                        "clear_token": {
                            "type": "string"
                        },
                        "ref": {
                            "type": "string"
                        },
                        "asset": {
                            "type": "string"
                        }
                    }
                }
            },
            {
                "id": "updates.check",
                "method": "GET",
                "path": "/updates/check",
                "permission": "updates.view",
                "description": "Read VERSION/module.json from git ref (Contents API). Query: optional target. Twin: GET /agent/update/check",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "target": {
                            "type": "string",
                            "description": "core, module id, or omit for all configured sources"
                        }
                    }
                }
            },
            {
                "id": "updates.apply",
                "method": "POST",
                "path": "/updates/apply",
                "permission": "updates.apply",
                "side_effect": "write",
                "description": "Download one monorepo zip (or external module archive) + overlay + migrate. SUPERADMIN. Body: target, migrate?. Twin: POST /agent/update/apply",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "target": {
                            "type": "string",
                            "description": "core, module id, or all"
                        },
                        "migrate": {
                            "type": "string",
                            "description": "1 (default) or 0 to skip schema migrate"
                        }
                    }
                }
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.system",
            "kind": "work",
            "num": 0,
            "path": "/updates",
            "title": "updates.menu.list"
        },
        {
            "group": "core.menu.group.system",
            "kind": "settings",
            "num": 5,
            "path": "/updates/settings",
            "title": "updates.menu.settings"
        }
    ],
    "configSchema": [],
    "tables": [],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "core.notices.collect"
        ],
        "publish": []
    }
}
