{
    "id": "gcal",
    "name": "gcal.module.name",
    "description": "gcal.module.description",
    "summary": "gcal.module.summary",
    "version": "0.1.8",
    "type": "product",
    "catalog": {
        "categories": [
            "integrations"
        ],
        "maturity": "beta",
        "tags": [
            "integration",
            "oauth",
            "sync"
        ],
        "screenshots": []
    },
    "requires": {
        "core": ">=1.0.0"
    },
    "optionalRequires": {
        "bots": ">=1.0.0",
        "comments": ">=1.0.0"
    },
    "provides": [
        "gcal.sync"
    ],
    "migrations": "migrations/",
    "tables": [
        "base_gcal_tokens",
        "base_gcal_task_links",
        "base_gcal_sync_queue"
    ],
    "permissions": [
        {
            "id": "gcal.manage",
            "label": "gcal.perm.manage"
        }
    ],
    "menu": [
        {
            "title": "gcal.menu.settings",
            "path": "/gcal/settings",
            "group": "core.menu.group.system",
            "kind": "settings",
            "capability": "SUPERADMIN_ACCESS",
            "num": 8
        }
    ],
    "routes": {
        "pages": [
            "/gcal/settings",
            "/gcal/oauth",
            "/gcal/oauth/start",
            "/gcal/work",
            "/gcal/enqueue",
            "/agent/gcal/status",
            "/agent/gcal/settings",
            "/agent/gcal/queue/drain"
        ]
    },
    "hooks": {
        "publish": [
            "gcal.sync.enqueued"
        ],
        "subscribe": [
            "core.news_item.meta",
            "core.news.feed_chips"
        ]
    },
    "agent": {
        "docs": "docs/agents/gcal.md",
        "ops": [
            {
                "id": "gcal.settings.get",
                "method": "GET",
                "path": "/gcal/settings",
                "permission": "gcal.manage",
                "description": "GCal app settings + staff connect overview + queue pending count"
            },
            {
                "id": "gcal.settings.save",
                "method": "POST",
                "path": "/gcal/settings",
                "permission": "gcal.manage",
                "description": "Save enabled/credentials/workday or staff calendars; action=save|save_cals|run_worker"
            },
            {
                "id": "gcal.user.connect_status",
                "method": "GET",
                "path": "/gcal/oauth/start",
                "permission": "core.home",
                "description": "Current user connect status (JSON); omit redirect or set redirect=1 to start OAuth"
            },
            {
                "id": "gcal.sync.enqueue",
                "method": "POST",
                "path": "/gcal/enqueue",
                "permission": "core.news",
                "description": "Enqueue TYPE=2 task sync; body: news_id, optional reason"
            },
            {
                "id": "gcal.queue.status",
                "method": "GET",
                "path": "/gcal/work",
                "permission": "gcal.manage",
                "side_effect": "read",
                "description": "Queue pending count + enabled flag (JSON). Does not drain."
            },
            {
                "id": "gcal.queue.drain",
                "method": "POST",
                "path": "/gcal/work",
                "permission": "gcal.manage",
                "side_effect": "write",
                "assistant": false,
                "description": "Drain sync queue + optional reconcile (session). Prefer POST /cron/tick?job=gcal.queue_drain&force=1 with agent_token. Body/query: limit, reconcile=0",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "limit": {
                            "type": "integer"
                        },
                        "reconcile": {
                            "type": "integer",
                            "description": "0 = skip reconcile"
                        }
                    }
                }
            }
        ]
    },
    "jobs": [
        "platform Cron::register gcal.queue_drain → /cron/tick",
        "POST /gcal/work (session)"
    ]
}
