{
    "id": "bonuses",
    "name": "bonuses.module.name",
    "description": "bonuses.module.description",
    "version": "1.0.1",
    "type": "product",
    "requires": {
        "core": ">=1.0.0",
        "clients": ">=1.0.0",
        "catalog": ">=1.0.0",
        "procedures": ">=1.0.0"
    },
    "optionalRequires": {
        "calendar": ">=1.0.0"
    },
    "provides": [
        "bonuses.ledger",
        "bonuses.processor"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "bonuses.view",
            "label": "bonuses.perm.view"
        },
        {
            "id": "bonuses.edit",
            "label": "bonuses.perm.edit"
        },
        {
            "id": "bonuses.apply",
            "label": "bonuses.perm.apply"
        },
        {
            "id": "bonuses.delete",
            "label": "bonuses.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/bonuses",
            "/bonuses/new",
            "/bonuses/{id}/edit",
            "/bonuses/clients/{id}",
            "/bonuses/events/{id}/quote",
            "/bonuses/events/{id}/apply"
        ]
    },
    "agent": {
        "docs": "docs/agents/bonuses.md",
        "ops": [
            {
                "id": "bonuses.list",
                "method": "GET",
                "path": "/bonuses",
                "permission": "bonuses.view",
                "description": "List bonus ledger movements; filters: q, client_id, direction, kind"
            },
            {
                "id": "bonuses.client",
                "method": "GET",
                "path": "/bonuses/clients/{id}",
                "permission": "bonuses.view",
                "description": "Client bonus balance and movement history"
            },
            {
                "id": "bonuses.quote",
                "method": "GET",
                "path": "/bonuses/events/{id}/quote",
                "permission": "bonuses.view",
                "description": "Dry-run bonus spend/accrue for a calendar event"
            },
            {
                "id": "bonuses.apply",
                "method": "POST",
                "path": "/bonuses/events/{id}/apply",
                "permission": "bonuses.apply",
                "description": "Apply bonus settlement for a calendar event (idempotent refuse if already settled)"
            },
            {
                "id": "bonuses.create",
                "method": "POST",
                "path": "/bonuses/new",
                "permission": "bonuses.edit",
                "description": "Create a manual bonus credit or debit"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "clients.menu.group",
            "num": 40,
            "path": "/bonuses",
            "title": "bonuses.menu.list",
            "kind": "crud"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_bonus_moves",
        "base_event_bonus"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "calendar.event.sections",
            "calendar.event.save"
        ],
        "publish": []
    },
    "bulkActions": [
        {
            "list_id": "bonuses",
            "action": "delete"
        }
    ],
    "catalog": {
        "categories": [
            "crm"
        ],
        "maturity": "release",
        "tags": [],
        "screenshots": []
    },
    "setup": {
        "steps": [
            {
                "id": "ready",
                "title": "bonuses.setup.step.ready",
                "description": "bonuses.setup.step.ready_help",
                "href": "/bonuses",
                "ask_user": "bonuses.setup.ask.ready",
                "choices": [
                    {
                        "id": "open",
                        "label": "bonuses.setup.choice.open",
                        "recommended": true
                    },
                    {
                        "id": "defer",
                        "label": "core.modules.setup.choice.defer",
                        "recommended": false
                    }
                ],
                "agent_can": [
                    "mark_done"
                ]
            }
        ]
    }
}
