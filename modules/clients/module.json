{
    "id": "clients",
    "name": "clients.module.name",
    "description": "clients.module.description",
    "version": "1.1.0",
    "type": "product",
    "runtime": "both",
    "requires": {
        "core": ">=1.0.0"
    },
    "optionalRequires": {
        "bots": ">=1.0.0",
        "assistant": ">=1.0.0"
    },
    "provides": [
        "clients.list",
        "clients.statuses",
        "clients.tags"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "clients.view",
            "label": "clients.perm.view"
        },
        {
            "id": "clients.edit",
            "label": "clients.perm.edit"
        },
        {
            "id": "clients.statuses",
            "label": "clients.perm.statuses"
        },
        {
            "id": "clients.tags",
            "label": "clients.perm.tags"
        },
        {
            "id": "clients.delete",
            "label": "clients.perm.delete"
        },
        {
            "id": "clients.tags.delete",
            "label": "clients.perm.tags_delete"
        },
        {
            "id": "clients.statuses.delete",
            "label": "clients.perm.statuses_delete"
        }
    ],
    "routes": {
        "pages": [
            "/clients",
            "/clients/new",
            "/clients/{id}",
            "/clients/{id}/edit",
            "/client-statuses",
            "/client-statuses/new",
            "/client-statuses/{id}/edit",
            "/client-tags",
            "/client-tags/new",
            "/client-tags/{id}/edit"
        ]
    },
    "agent": {
        "docs": "docs/agents/clients.md",
        "ops": [
            {
                "id": "clients.list",
                "method": "GET",
                "path": "/clients",
                "permission": "clients.view",
                "description": "List clients; filters: q, enabled, status_id, tag_id"
            },
            {
                "id": "clients.get",
                "method": "GET",
                "path": "/clients/{id}",
                "permission": "clients.view",
                "description": "One client card (password omitted); includes tag_ids and channels[] (type, value, label, is_primary)"
            },
            {
                "id": "clients.get_edit",
                "method": "GET",
                "path": "/clients/{id}/edit",
                "permission": "clients.edit",
                "description": "Client edit payload + statuses/tags dictionaries"
            },
            {
                "id": "clients.create",
                "method": "POST",
                "path": "/clients/new",
                "permission": "clients.edit",
                "description": "Create client; form fields + tag_ids[] + channels[]. Needs at least one of tel / mail / channels (a contact reachable only via Telegram or Max is fine; without tel there is no online-booking login).",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "tel": {
                            "type": "string",
                            "description": "Phone (login); optional when mail or channels are given"
                        },
                        "channels": {
                            "type": "array",
                            "description": "Contact channels; replaces the list when sent",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "type": {"type": "string", "enum": ["phone", "telegram", "max", "whatsapp", "email", "vk", "instagram", "other"]},
                                    "value": {"type": "string", "description": "@username / number / address / link"},
                                    "label": {"type": "string"},
                                    "is_primary": {"type": "integer", "enum": [0, 1]}
                                },
                                "required": ["type", "value"]
                            }
                        },
                        "name": {
                            "type": "string"
                        },
                        "mail": {
                            "type": "string"
                        },
                        "enabled": {
                            "type": "string",
                            "description": "1 to enable"
                        },
                        "status_id": {
                            "type": "integer"
                        },
                        "tag_ids": {
                            "type": "array",
                            "items": {
                                "type": "integer"
                            }
                        }
                    }
                }
            },
            {
                "id": "clients.update",
                "method": "POST",
                "path": "/clients/{id}/edit",
                "permission": "clients.edit",
                "description": "Update client; empty password keeps previous. channels[] (same shape as create) replaces the channel list only when sent; omit it to keep channels."
            },
            {
                "id": "clients.statuses.list",
                "method": "GET",
                "path": "/client-statuses",
                "permission": "clients.statuses",
                "description": "List client statuses"
            },
            {
                "id": "clients.statuses.get",
                "method": "GET",
                "path": "/client-statuses/{id}/edit",
                "permission": "clients.statuses",
                "description": "One client status"
            },
            {
                "id": "clients.statuses.create",
                "method": "POST",
                "path": "/client-statuses/new",
                "permission": "clients.statuses",
                "description": "Create client status"
            },
            {
                "id": "clients.statuses.update",
                "method": "POST",
                "path": "/client-statuses/{id}/edit",
                "permission": "clients.statuses",
                "description": "Update client status"
            },
            {
                "id": "clients.tags.list",
                "method": "GET",
                "path": "/client-tags",
                "permission": "clients.tags",
                "description": "List client tags; filter: q"
            },
            {
                "id": "clients.tags.get",
                "method": "GET",
                "path": "/client-tags/{id}/edit",
                "permission": "clients.tags",
                "description": "One client tag"
            },
            {
                "id": "clients.tags.create",
                "method": "POST",
                "path": "/client-tags/new",
                "permission": "clients.tags",
                "description": "Create client tag"
            },
            {
                "id": "clients.tags.update",
                "method": "POST",
                "path": "/client-tags/{id}/edit",
                "permission": "clients.tags",
                "description": "Update client tag"
            },
            {
                "id": "clients.delete",
                "method": "POST",
                "path": "/clients/{id}/edit",
                "permission": "clients.delete",
                "side_effect": "write",
                "description": "Delete client; POST action=delete"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "clients.menu.group",
            "num": 1,
            "path": "/clients",
            "title": "clients.menu.base"
        },
        {
            "group": "clients.menu.group",
            "kind": "crud",
            "num": 1,
            "path": "/client-statuses",
            "title": "clients.menu.statuses"
        },
        {
            "group": "clients.menu.group",
            "kind": "crud",
            "num": 2,
            "path": "/client-tags",
            "title": "clients.menu.tags"
        },
        {
            "group": "bots.menu.group",
            "kind": "work",
            "num": 20,
            "path": "/bots/types/client",
            "title": "bots.menu.type.client",
            "permission": "bots.view",
            "capability": "SUPERADMIN_ACCESS",
            "when": "bots"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_clients",
        "base_client_statuses",
        "base_shopusers_tags",
        "base_client_tag_links",
        "base_client_channels"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "core.dashboard.catalog",
            "core.dashboard.widgets",
            "assistant.write.preview"
        ],
        "publish": [
            "clients.edit.sections",
            "clients.edit.save",
            "clients.view.profile",
            "clients.list",
            "clients.created",
            "clients.updated"
        ]
    },
    "bulkActions": [
        {
            "list_id": "clients",
            "action": "delete"
        },
        {
            "list_id": "clients",
            "action": "enable"
        },
        {
            "list_id": "clients",
            "action": "disable"
        },
        {
            "list_id": "clients",
            "action": "assign_tag"
        },
        {
            "list_id": "clients",
            "action": "unassign_tag"
        },
        {
            "list_id": "client_tags",
            "action": "delete"
        }
    ],
    "catalog": {
        "categories": [
            "crm"
        ],
        "maturity": "release",
        "tags": [],
        "screenshots": []
    },
    "setup": {
        "steps": [
            {
                "id": "ready",
                "title": "clients.setup.step.ready",
                "description": "clients.setup.step.ready_help",
                "href": "/clients",
                "ask_user": "clients.setup.ask.ready",
                "choices": [
                    {
                        "id": "open",
                        "label": "clients.setup.choice.open",
                        "recommended": true
                    },
                    {
                        "id": "defer",
                        "label": "core.modules.setup.choice.defer",
                        "recommended": false
                    }
                ],
                "agent_can": [
                    "mark_done"
                ]
            }
        ]
    }
}
