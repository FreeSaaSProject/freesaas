{
    "id": "clients",
    "name": "clients.module.name",
    "description": "clients.module.description",
    "version": "0.1.1",
    "type": "product",
    "runtime": "both",
    "requires": {
        "core": ">=0.3.0"
    },
    "optionalRequires": {
        "bots": ">=0.1.0"
    },
    "provides": [
        "clients.list",
        "clients.statuses",
        "clients.tags"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "clients.view",
            "label": "clients.perm.view"
        },
        {
            "id": "clients.edit",
            "label": "clients.perm.edit"
        },
        {
            "id": "clients.statuses",
            "label": "clients.perm.statuses"
        },
        {
            "id": "clients.tags",
            "label": "clients.perm.tags"
        }
    ],
    "routes": {
        "pages": [
            "/clients",
            "/clients/new",
            "/clients/{id}",
            "/clients/{id}/edit",
            "/client-statuses",
            "/client-statuses/new",
            "/client-statuses/{id}/edit",
            "/client-tags",
            "/client-tags/new",
            "/client-tags/{id}/edit"
        ]
    },
    "agent": {
        "ops": [
            {
                "id": "clients.list",
                "method": "GET",
                "path": "/clients",
                "permission": "clients.view",
                "description": "List clients; filters: q, enabled, status_id, tag_id"
            },
            {
                "id": "clients.get",
                "method": "GET",
                "path": "/clients/{id}",
                "permission": "clients.view",
                "description": "One client card (password omitted); includes tag_ids"
            },
            {
                "id": "clients.get_edit",
                "method": "GET",
                "path": "/clients/{id}/edit",
                "permission": "clients.edit",
                "description": "Client edit payload + statuses/tags dictionaries"
            },
            {
                "id": "clients.create",
                "method": "POST",
                "path": "/clients/new",
                "permission": "clients.edit",
                "description": "Create client; form fields + tag_ids[]",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "tel": {
                            "type": "string",
                            "description": "Phone (login)"
                        },
                        "name": {
                            "type": "string"
                        },
                        "mail": {
                            "type": "string"
                        },
                        "enabled": {
                            "type": "string",
                            "description": "1 to enable"
                        },
                        "status_id": {
                            "type": "integer"
                        },
                        "tag_ids": {
                            "type": "array",
                            "items": {
                                "type": "integer"
                            }
                        }
                    },
                    "required": [
                        "tel"
                    ]
                }
            },
            {
                "id": "clients.update",
                "method": "POST",
                "path": "/clients/{id}/edit",
                "permission": "clients.edit",
                "description": "Update client; empty password keeps previous"
            },
            {
                "id": "clients.statuses.list",
                "method": "GET",
                "path": "/client-statuses",
                "permission": "clients.statuses",
                "description": "List client statuses"
            },
            {
                "id": "clients.statuses.get",
                "method": "GET",
                "path": "/client-statuses/{id}/edit",
                "permission": "clients.statuses",
                "description": "One client status"
            },
            {
                "id": "clients.statuses.create",
                "method": "POST",
                "path": "/client-statuses/new",
                "permission": "clients.statuses",
                "description": "Create client status"
            },
            {
                "id": "clients.statuses.update",
                "method": "POST",
                "path": "/client-statuses/{id}/edit",
                "permission": "clients.statuses",
                "description": "Update client status"
            },
            {
                "id": "clients.tags.list",
                "method": "GET",
                "path": "/client-tags",
                "permission": "clients.tags",
                "description": "List client tags; filter: q"
            },
            {
                "id": "clients.tags.get",
                "method": "GET",
                "path": "/client-tags/{id}/edit",
                "permission": "clients.tags",
                "description": "One client tag"
            },
            {
                "id": "clients.tags.create",
                "method": "POST",
                "path": "/client-tags/new",
                "permission": "clients.tags",
                "description": "Create client tag"
            },
            {
                "id": "clients.tags.update",
                "method": "POST",
                "path": "/client-tags/{id}/edit",
                "permission": "clients.tags",
                "description": "Update client tag"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "clients.menu.group",
            "num": 1,
            "path": "/clients",
            "title": "clients.menu.base"
        },
        {
            "group": "clients.menu.group",
            "kind": "crud",
            "num": 1,
            "path": "/client-statuses",
            "title": "clients.menu.statuses"
        },
        {
            "group": "clients.menu.group",
            "kind": "crud",
            "num": 2,
            "path": "/client-tags",
            "title": "clients.menu.tags"
        },
        {
            "group": "bots.menu.group",
            "kind": "work",
            "num": 20,
            "path": "/bots/types/client",
            "title": "bots.menu.type.client",
            "permission": "bots.view",
            "capability": "SUPERADMIN_ACCESS",
            "when": "bots"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_clients",
        "base_client_statuses",
        "base_shopusers_tags",
        "base_client_tag_links"
    ],
    "migrators": [
        {
            "id": "phpshop_shopusers_status_to_base_client_statuses",
            "mode": "replace",
            "source": [
                "phpshop_shopusers_status"
            ],
            "target": [
                "base_client_statuses"
            ]
        },
        {
            "id": "phpshop_shopusers_to_base_clients",
            "mode": "replace",
            "source": [
                "phpshop_shopusers"
            ],
            "target": [
                "base_clients"
            ]
        },
        {
            "id": "phpshop_shopusers_tags_to_base_client_tag_links",
            "mode": "replace",
            "source": [
                "phpshop_shopusers"
            ],
            "target": [
                "base_client_tag_links"
            ]
        }
    ],
    "hooks": {
        "subscribe": [
            "core.dashboard.catalog",
            "core.dashboard.widgets"
        ],
        "publish": [
            "clients.edit.sections",
            "clients.edit.save",
            "clients.view.profile",
            "clients.list"
        ]
    },
    "bulkActions": [
        {
            "list_id": "clients",
            "action": "delete"
        },
        {
            "list_id": "clients",
            "action": "enable"
        },
        {
            "list_id": "clients",
            "action": "disable"
        },
        {
            "list_id": "clients",
            "action": "assign_tag"
        },
        {
            "list_id": "clients",
            "action": "unassign_tag"
        },
        {
            "list_id": "client_tags",
            "action": "delete"
        }
    ],
    "catalog": {
        "categories": [
            "crm"
        ],
        "maturity": "beta",
        "tags": [],
        "screenshots": []
    }
}
