{
    "id": "clients",
    "name": "clients.module.name",
    "version": "0.1.0",
    "type": "product",
    "requires": {
        "core": ">=0.3.0"
    },
    "optionalRequires": {
        "bots": ">=0.1.0"
    },
    "provides": [
        "clients.list",
        "clients.statuses",
        "clients.tags"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "clients.view",
            "label": "clients.perm.view"
        },
        {
            "id": "clients.edit",
            "label": "clients.perm.edit"
        },
        {
            "id": "clients.statuses",
            "label": "clients.perm.statuses"
        },
        {
            "id": "clients.tags",
            "label": "clients.perm.tags"
        }
    ],
    "routes": {
        "pages": [
            "/clients",
            "/clients/new",
            "/clients/{id}",
            "/clients/{id}/edit",
            "/client-statuses",
            "/client-statuses/new",
            "/client-statuses/{id}/edit",
            "/client-tags",
            "/client-tags/new",
            "/client-tags/{id}/edit"
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "clients.menu.group",
            "num": 1,
            "path": "/clients",
            "title": "clients.menu.base"
        },
        {
            "group": "clients.menu.group",
            "kind": "crud",
            "num": 1,
            "path": "/client-statuses",
            "title": "clients.menu.statuses"
        },
        {
            "group": "clients.menu.group",
            "kind": "crud",
            "num": 2,
            "path": "/client-tags",
            "title": "clients.menu.tags"
        },
        {
            "group": "bots.menu.group",
            "kind": "work",
            "num": 20,
            "path": "/bots/types/client",
            "title": "bots.menu.type.client",
            "permission": "bots.view",
            "capability": "SUPERADMIN_ACCESS",
            "when": "bots"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_clients",
        "base_client_statuses",
        "base_shopusers_tags",
        "base_client_tag_links"
    ],
    "migrators": [
        {
            "id": "phpshop_shopusers_status_to_base_client_statuses",
            "mode": "replace",
            "source": [
                "phpshop_shopusers_status"
            ],
            "target": [
                "base_client_statuses"
            ]
        },
        {
            "id": "phpshop_shopusers_to_base_clients",
            "mode": "replace",
            "source": [
                "phpshop_shopusers"
            ],
            "target": [
                "base_clients"
            ]
        },
        {
            "id": "phpshop_shopusers_tags_to_base_client_tag_links",
            "mode": "replace",
            "source": [
                "phpshop_shopusers"
            ],
            "target": [
                "base_client_tag_links"
            ]
        }
    ],
    "hooks": {
        "subscribe": [
            "core.dashboard.catalog",
            "core.dashboard.widgets"
        ],
        "publish": [
            "clients.edit.sections",
            "clients.edit.save",
            "clients.view.profile",
            "clients.list"
        ]
    },
    "bulkActions": [
        {
            "list_id": "clients",
            "action": "delete"
        },
        {
            "list_id": "clients",
            "action": "enable"
        },
        {
            "list_id": "clients",
            "action": "disable"
        },
        {
            "list_id": "clients",
            "action": "assign_tag"
        },
        {
            "list_id": "clients",
            "action": "unassign_tag"
        },
        {
            "list_id": "client_tags",
            "action": "delete"
        }
    ]
}
