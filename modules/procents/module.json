{
    "id": "procents",
    "name": "procents.module.name",
    "description": "procents.module.description",
    "version": "1.0.0",
    "type": "product",
    "runtime": "both",
    "requires": {
        "core": ">=1.0.0",
        "rates": ">=1.0.0",
        "procedures": ">=1.0.0",
        "workweeks": ">=1.0.0"
    },
    "optionalRequires": {
        "payments": ">=1.0.0"
    },
    "provides": [
        "procents.report"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "procents.view",
            "label": "procents.perm.view"
        }
    ],
    "routes": {
        "pages": [
            "/procents",
            "/procents/days",
            "/procents/day"
        ]
    },
    "agent": {
        "docs": "docs/agents/procents.md",
        "ops": [
            {
                "id": "procents.report",
                "method": "GET",
                "path": "/procents",
                "permission": "procents.view",
                "description": "Commission accrual report; operator_id (required unless own-only role). Default year=0&month=0 = recent limit months (default 2). year/month for specific period; limit expands recent window."
            },
            {
                "id": "procents.days_audit",
                "method": "GET",
                "path": "/procents/days",
                "permission": "procents.view",
                "description": "Superadmin only: day totals for a month; operator_id + ym=Y-m (or start/end)"
            },
            {
                "id": "procents.day_audit",
                "method": "GET",
                "path": "/procents/day",
                "permission": "procents.view",
                "description": "Superadmin only: line-level accrual detail for one day; operator_id + day=Y-m-d (or day_ts)"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.accounting",
            "num": 15,
            "path": "/procents",
            "title": "procents.menu.list"
        }
    ],
    "configSchema": [],
    "tables": [],
    "migrators": [],
    "hooks": {
        "subscribe": [],
        "publish": []
    },
    "catalog": {
        "categories": [
            "accounting"
        ],
        "maturity": "release",
        "tags": [],
        "screenshots": []
    }
}
