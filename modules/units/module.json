{
    "id": "units",
    "name": "units.module.name",
    "description": "units.module.description",
    "version": "0.1.2",
    "type": "product",
    "requires": {
        "core": ">=0.3.0"
    },
    "optionalRequires": [],
    "provides": [
        "units.list"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "units.view",
            "label": "units.perm.view"
        },
        {
            "id": "units.edit",
            "label": "units.perm.edit"
        },
        {
            "id": "units.delete",
            "label": "units.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/units",
            "/units/new",
            "/units/{id}/edit"
        ]
    },
    "agent": {
        "docs": "docs/agents/units.md",
        "ops": [
            {
                "id": "units.list",
                "method": "GET",
                "path": "/units",
                "permission": "units.view",
                "description": "List units of measure; filter: q"
            },
            {
                "id": "units.get",
                "method": "GET",
                "path": "/units/{id}/edit",
                "permission": "units.edit",
                "description": "One unit edit payload"
            },
            {
                "id": "units.create",
                "method": "POST",
                "path": "/units/new",
                "permission": "units.edit",
                "description": "Create unit; fields: name, short_name, enabled"
            },
            {
                "id": "units.update",
                "method": "POST",
                "path": "/units/{id}/edit",
                "permission": "units.edit",
                "description": "Update unit"
            },
            {
                "id": "units.delete",
                "method": "POST",
                "path": "/units/{id}/edit",
                "permission": "units.delete",
                "side_effect": "write",
                "description": "Delete unit; POST action=delete (blocked if products reference it)"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.dictionaries",
            "num": 2,
            "path": "/units",
            "title": "units.menu.list"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_units"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [],
        "publish": []
    },
    "bulkActions": [
        {
            "list_id": "units",
            "action": "delete"
        }
    ],
    "catalog": {
        "categories": [
            "dictionaries"
        ],
        "maturity": "beta",
        "tags": [],
        "screenshots": []
    }
}
