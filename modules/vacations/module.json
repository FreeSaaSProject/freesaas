{
    "id": "vacations",
    "name": "vacations.module.name",
    "description": "vacations.module.description",
    "version": "1.0.1",
    "type": "product",
    "requires": {
        "core": ">=1.0.0"
    },
    "optionalRequires": {
        "bi": ">=1.0.0"
    },
    "provides": [
        "vacations.list"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "vacations.view",
            "label": "vacations.perm.view"
        },
        {
            "id": "vacations.edit",
            "label": "vacations.perm.edit"
        },
        {
            "id": "vacations.delete",
            "label": "vacations.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/vacations",
            "/vacations/new",
            "/vacations/{id}/edit"
        ]
    },
    "agent": {
        "docs": "docs/agents/vacations.md",
        "ops": [
            {
                "id": "vacations.list",
                "method": "GET",
                "path": "/vacations",
                "permission": "vacations.view",
                "description": "List leave records; filters: q (description), user_id (resolve staff via core.users.list first), sign, id_type, direction, year, month (year=all for every year). Dates dt_start/dt_end are unix seconds. Scoped to self when not privileged"
            },
            {
                "id": "vacations.get",
                "method": "GET",
                "path": "/vacations/{id}/edit",
                "permission": "vacations.edit",
                "description": "Leave edit payload; includes staff dictionary when privileged"
            },
            {
                "id": "vacations.create",
                "method": "POST",
                "path": "/vacations/new",
                "permission": "vacations.edit",
                "description": "Create leave request"
            },
            {
                "id": "vacations.update",
                "method": "POST",
                "path": "/vacations/{id}/edit",
                "permission": "vacations.edit",
                "description": "Update leave (patch): required id; pass only changed fields, e.g. dt_start/dt_end as YYYY-MM-DD (end inclusive). Omitted fields keep current values. Move a vacation = update its dates, not delete+create",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "integer",
                            "description": "Vacation id from vacations.list"
                        },
                        "dt_start": {
                            "type": "string",
                            "description": "New start YYYY-MM-DD"
                        },
                        "dt_end": {
                            "type": "string",
                            "description": "New end YYYY-MM-DD (inclusive)"
                        },
                        "descr": {
                            "type": "string"
                        },
                        "id_type": {
                            "type": "integer",
                            "description": "1 paid, 2 unpaid, 3 working period"
                        }
                    },
                    "required": [
                        "id"
                    ]
                }
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.team",
            "num": 4,
            "path": "/vacations",
            "title": "vacations.menu.list"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_vacations"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "core.notices.collect",
            "bi.datasets",
            "assistant.write.preview"
        ],
        "publish": []
    },
    "bulkActions": [
        {
            "list_id": "vacations",
            "action": "delete"
        },
        {
            "list_id": "vacations",
            "action": "sign"
        }
    ],
    "catalog": {
        "categories": [
            "team"
        ],
        "maturity": "release",
        "tags": [],
        "screenshots": []
    },
    "setup": {
        "steps": [
            {
                "id": "ready",
                "title": "vacations.setup.step.ready",
                "description": "vacations.setup.step.ready_help",
                "href": "/vacations",
                "ask_user": "vacations.setup.ask.ready",
                "choices": [
                    {
                        "id": "open",
                        "label": "vacations.setup.choice.open",
                        "recommended": true
                    },
                    {
                        "id": "defer",
                        "label": "core.modules.setup.choice.defer",
                        "recommended": false
                    }
                ],
                "agent_can": [
                    "mark_done"
                ]
            }
        ]
    }
}
