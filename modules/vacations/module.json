{
    "id": "vacations",
    "name": "vacations.module.name",
    "description": "vacations.module.description",
    "version": "0.1.1",
    "type": "product",
    "requires": {
        "core": ">=0.3.0"
    },
    "optionalRequires": [],
    "provides": [
        "vacations.list"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "vacations.view",
            "label": "vacations.perm.view"
        },
        {
            "id": "vacations.edit",
            "label": "vacations.perm.edit"
        }
    ],
    "routes": {
        "pages": [
            "/vacations",
            "/vacations/new",
