{
    "id": "banks",
    "name": "banks.module.name",
    "version": "0.1.19",
    "type": "product",
    "description": "banks.module.description",
    "catalog": {
        "categories": [
            "finance",
            "integrations"
        ],
        "maturity": "beta",
        "tags": [
            "integration",
            "oauth",
            "sync",
            "llm"
        ],
        "screenshots": []
    },
    "requires": {
        "core": ">=1.0.0",
        "ledger": ">=1.0.0"
    },
    "optionalRequires": {
        "llm": ">=1.0.0"
    },
    "provides": [
        "banks.connections",
        "banks.sync"
    ],
    "migrations": "migrations/",
    "uninstall": {
        "strategy": "leave_tables"
    },
    "permissions": [
        {
            "id": "banks.view",
            "label": "banks.perm.view"
        },
        {
            "id": "banks.connect",
            "label": "banks.perm.connect"
        },
        {
            "id": "banks.sync",
            "label": "banks.perm.sync"
        }
    ],
    "routes": {
        "pages": [
            "/banks",
            "/banks/integrations/{id}",
            "/banks/setup/{provider}",
            "/banks/settings",
            "/banks/settings/certs",
            "/banks/settings/csr",
            "/banks/settings/probe",
            "/banks/oauth/{provider}/start",
            "/banks/oauth/{provider}/callback",
            "/banks/connections/{id}",
            "/banks/connections/{id}/sync",
            "/banks/sync-account",
            "/banks/jobs/sync",
            "/agent/banks/status",
            "/agent/banks/settings",
            "/agent/banks/certs",
            "/agent/banks/probe",
            "/agent/banks/csr",
            "/agent/banks/setup",
            "/agent/banks/integrations",
            "/agent/banks/integrations/connect",
            "/agent/banks/integrations/probe-scopes"
        ]
    },
    "agent": {
        "docs": "docs/agents/banks.md",
        "ops": [
            {
                "id": "banks.connections.list",
                "method": "GET",
                "path": "/banks",
                "permission": "banks.view",
                "side_effect": "read",
                "description": "List bank OAuth connections (tokens masked)"
            },
            {
                "id": "banks.setup.get",
                "method": "GET",
                "path": "/banks/setup/{provider}",
                "permission": "SUPERADMIN_ACCESS",
                "side_effect": "read",
                "description": "Per-provider setup wizard snapshot (steps with ask_user, agent_can, browser). Twin: GET /agent/banks/setup?provider="
            },
            {
                "id": "banks.setup.action",
                "method": "POST",
                "path": "/banks/setup/{provider}",
                "permission": "SUPERADMIN_ACCESS",
                "side_effect": "write",
                "description": "Wizard POST: wizard_action=done|skip|save_step|csr_generate. Twin: POST /agent/banks/setup action=mark_done|skip|save|csr_generate"
            },
            {
                "id": "banks.settings.get",
                "method": "GET",
                "path": "/banks/settings",
                "permission": "SUPERADMIN_ACCESS",
                "side_effect": "read",
                "description": "Bank provider settings JSON (HTML GET redirects to /banks hub). Prefer /banks/setup/{provider}."
            },
            {
                "id": "banks.settings.save",
                "method": "POST",
                "path": "/banks/settings",
                "permission": "SUPERADMIN_ACCESS",
                "side_effect": "write",
                "description": "Save bank provider credentials into cfg/modules/banks.ini. Optional multipart files alfa_ul_mtls_{cert,key,ca}_file or JSON base64 fields alfa_ul_mtls_*_base64 (+ *_filename)."
            },
            {
                "id": "banks.agent.setup.get",
                "method": "GET",
                "path": "/agent/banks/setup",
                "permission": "public",
                "side_effect": "read",
                "assistant": false,
                "description": "Agent-token wizard: ask_user_now / agent_can_now / browser_now + agent_can_ops map. Query provider= optional."
            },
            {
                "id": "banks.agent.setup.action",
                "method": "POST",
                "path": "/agent/banks/setup",
                "permission": "public",
                "side_effect": "write",
                "assistant": false,
                "description": "Agent-token wizard action mark_done|skip|save|csr_generate"
            },
            {
                "id": "banks.probe",
                "method": "POST",
                "path": "/banks/settings/probe",
                "permission": "SUPERADMIN_ACCESS",
                "side_effect": "read",
                "description": "Probe Alfa UL client_id/secret against token URL (dummy code). Session twin of /agent/banks/probe.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "provider": {
                            "type": "string",
                            "default": "alfa_ul"
                        }
                    }
                }
            },
            {
                "id": "banks.csr.generate",
                "method": "POST",
                "path": "/banks/settings/csr",
                "permission": "SUPERADMIN_ACCESS",
                "side_effect": "write",
                "description": "Generate Alfa UL prod TLS key+CSR (organization, inn). Download: GET /banks/settings/csr?action=download. Twin: POST /agent/banks/csr.",
                "parameters": {
                    "type": "object",
                    "required": ["organization", "inn"],
                    "properties": {
                        "organization": {"type": "string"},
                        "inn": {"type": "string"},
                        "common_name": {"type": "string"},
                        "email": {"type": "string"},
                        "force": {"type": "boolean"}
                    }
                }
            },
            {
                "id": "banks.certs.upload",
                "method": "POST",
                "path": "/banks/settings/certs",
                "permission": "SUPERADMIN_ACCESS",
                "side_effect": "write",
                "description": "Upload one mTLS file. Multipart field file + provider + kind=cert|key|ca; or JSON content_base64 + filename.",
                "parameters": {
                    "type": "object",
                    "required": [
                        "kind"
                    ],
                    "properties": {
                        "provider": {
                            "type": "string",
                            "default": "alfa_ul"
                        },
                        "kind": {
                            "type": "string",
                            "enum": [
                                "cert",
                                "key",
                                "ca"
                            ]
                        },
                        "content_base64": {
                            "type": "string"
                        },
                        "filename": {
                            "type": "string"
                        }
                    }
                }
            },
            {
                "id": "banks.connections.get",
                "method": "GET",
                "path": "/banks/connections/{id}",
                "permission": "banks.view",
                "side_effect": "read",
                "description": "One connection + remote accounts + ledger links"
            },
            {
                "id": "banks.oauth.start",
                "method": "GET",
                "path": "/banks/oauth/{provider}/start",
                "permission": "banks.connect",
                "side_effect": "write",
                "description": "Start OAuth (or T-Bank self-service token) for provider=tochka|alfa_ul|alfa_fl|tbank_ul|tbank_fl|sber_ul|sber_fl; HTML redirects, JSON returns authorize_url",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "provider": {
                            "type": "string",
                            "enum": [
                                "tochka",
                                "alfa_ul",
                                "alfa_fl",
                                "tbank_ul",
                                "tbank_fl",
                                "sber_ul",
                                "sber_fl"
                            ]
                        }
                    }
                }
            },
            {
                "id": "banks.link.save",
                "method": "POST",
                "path": "/banks/connections/{id}",
                "permission": "banks.connect",
                "side_effect": "write",
                "description": "Link remote bank account to base_accounts, refresh, or delete connection (links+tx_map only; keeps certs/ledger). Body: action=link|unlink|refresh|create_ledger|delete; external_account_id; account_id",
                "parameters": {
                    "type": "object",
                    "required": [
                        "action"
                    ],
                    "properties": {
                        "action": {
                            "type": "string",
                            "enum": [
                                "link",
                                "unlink",
                                "refresh",
                                "create_ledger",
                                "delete"
                            ]
                        },
                        "external_account_id": {
                            "type": "string"
                        },
                        "account_id": {
                            "type": "integer"
                        },
                        "account_name": {
                            "type": "string"
                        }
                    }
                }
            },
            {
                "id": "banks.sync",
                "method": "POST",
                "path": "/banks/connections/{id}/sync",
                "permission": "banks.sync",
                "side_effect": "write",
                "description": "Sync statements for linked accounts into ledger moves. Body: date_from, date_to (Y-m-d), optional link_id",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "date_from": {
                            "type": "string"
                        },
                        "date_to": {
                            "type": "string"
                        },
                        "link_id": {
                            "type": "integer"
                        }
                    }
                }
            },
            {
                "id": "banks.sync.account",
                "method": "POST",
                "path": "/banks/sync-account",
                "permission": "banks.sync",
                "side_effect": "write",
                "description": "Sync statements for one ledger account (all sync-enabled bank links). Body: account_id, date_from, date_to (Y-m-d). Used from /ledger/moves toolbar.",
                "parameters": {
                    "type": "object",
                    "required": [
                        "account_id"
                    ],
                    "properties": {
                        "account_id": {
                            "type": "integer"
                        },
                        "date_from": {
                            "type": "string"
                        },
                        "date_to": {
                            "type": "string"
                        }
                    }
                }
            },
            {
                "id": "banks.jobs.sync",
                "method": "POST",
                "path": "/banks/jobs/sync",
                "permission": "public",
                "side_effect": "write",
                "assistant": false,
                "description": "Cron sync all enabled links; header X-Banks-Token or ?token=. Prefer platform POST /cron/tick?job=banks.sync&force=1 with agent_token"
            }
        ]
    },
    "jobs": [
        "platform Cron::register banks.sync → /cron/tick",
        "POST /banks/jobs/sync"
    ],
    "hooks": {
        "publish": [],
        "subscribe": [
            "ledger.accounts.badges",
            "ledger.moves.badges",
            "ledger.moves.list.toolbar",
            "core.notices.collect"
        ]
    },
    "menu": [
        {
            "group": "core.menu.group.finance",
            "num": 25,
            "title": "banks.menu.list",
            "path": "/banks",
            "permission": "banks.view",
            "kind": "work"
        }
    ],
    "tables": [
        "base_bank_connections",
        "base_bank_account_links",
        "base_bank_tx_map",
        "base_bank_integrations"
    ]
}
