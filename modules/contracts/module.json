{
    "id": "contracts",
    "name": "contracts.module.name",
    "description": "contracts.module.description",
    "version": "1.0.6",
    "type": "product",
    "requires": {
        "core": ">=1.0.0",
        "comments": ">=1.0.0"
    },
    "optionalRequires": {
        "payments": ">=1.0.0"
    },
    "provides": [
        "contracts.offer",
        "contracts.list"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "contracts.list",
            "label": "contracts.perm.list"
        },
        {
            "id": "contracts.manage",
            "label": "contracts.perm.manage"
        }
    ],
    "routes": {
        "pages": [
            "/contracts",
            "/contracts/action",
            "/contracts/settings"
        ]
    },
    "agent": {
        "docs": "docs/agents/contracts.md",
        "ops": [
            {
                "id": "contracts.list",
                "method": "GET",
                "path": "/contracts",
                "permission": "contracts.list",
                "description": "List contract offers; filters: status, executor, acceptor, party (non-admin)"
            },
            {
                "id": "contracts.action",
                "method": "POST",
                "path": "/contracts/action",
                "permission": "contracts.manage",
                "description": "Contract workflow on a comment: action=accept_offer|accept_work|refuse|cancel_work_accept; comment_id, optional news_id",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "action": {
                            "type": "string"
                        },
                        "comment_id": {
                            "type": "integer"
                        },
                        "news_id": {
                            "type": "integer"
                        }
                    },
                    "required": [
                        "action",
                        "comment_id"
                    ]
                }
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.accounting",
            "num": 10,
            "path": "/contracts",
            "title": "contracts.menu.list"
        }
    ],
    "configSchema": {
        "contracts": {
            "deadline_penalty": {
                "type": "boolean",
                "default": true
            }
        }
    },
    "tables": [],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "comments.visible",
            "comments.render_actions",
            "comments.can_delete",
            "comments.form.offer_fields",
            "comments.form.edit_fields",
            "comments.prepare_add",
            "comments.prepare_edit",
            "core.dashboard.catalog",
            "core.dashboard.widgets",
            "core.notices.collect"
        ],
        "publish": []
    },
    "catalog": {
        "categories": [
            "accounting"
        ],
        "maturity": "release",
        "tags": [],
        "screenshots": []
    },
    "setup": {
        "steps": [
            {
                "id": "config",
                "title": "contracts.setup.step.config",
                "description": "contracts.setup.step.config_help",
                "href": "/contracts/settings",
                "ask_user": "contracts.setup.ask.config",
                "choices": [
                    {
                        "id": "open",
                        "label": "contracts.setup.choice.open",
                        "recommended": true
                    },
                    {
                        "id": "defer",
                        "label": "core.modules.setup.choice.defer",
                        "recommended": false
                    }
                ],
                "agent_can": []
            }
        ]
    }
}
