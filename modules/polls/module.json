{
    "id": "polls",
    "name": "polls.module.name",
    "description": "polls.module.description",
    "version": "0.1.9",
    "type": "product",
    "requires": {
        "core": ">=1.0.0"
    },
    "optionalRequires": {
        "procedures": ">=1.0.0",
        "catalog": ">=1.0.0"
    },
    "provides": [
        "polls.definitions"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "polls.view",
            "label": "polls.perm.view"
        },
        {
            "id": "polls.edit",
            "label": "polls.perm.edit"
        },
        {
            "id": "polls.delete",
            "label": "polls.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/polls",
            "/polls/new",
            "/polls/{id}/edit",
            "/polls/settings"
        ]
    },
    "agent": {
        "docs": "docs/agents/polls.md",
        "ops": [
            {
                "id": "polls.list",
                "method": "GET",
                "path": "/polls",
                "permission": "polls.view",
                "description": "List poll roots (questionnaires); filters: q, enabled"
            },
            {
                "id": "polls.get",
                "method": "GET",
                "path": "/polls/{id}/edit",
                "permission": "polls.view",
                "description": "Get one poll tree node + children (root → questions, question → answer options). Walk: root children are questions in num order; question children are options."
            },
            {
                "id": "polls.create",
                "method": "POST",
                "path": "/polls/new",
                "permission": "polls.edit",
                "side_effect": "write",
                "description": "Create a poll tree node. Build a questionnaire: el_type=0 root (name = title, descr_site = intro) → el_type=1 questions (pid=root, num = order, descr_site = hint) → el_type=2 options (pid=question; next_qid = jump, ans_end_poll=1 = finish). QUESTION TYPES — pick per question and mix them, open answers matter: (1) OPEN TEXT = question with NO options (respondent types an answer) — use for 'why / describe / what else / examples'; (2) SINGLE choice = options, multy_opts=0; (3) MULTIPLE choice = options, multy_opts=1; (4) CHOICE + COMMENT = options + free_text=1 (text box under options). An option named 'Другое' / 'Свой вариант' / 'Other' always gets a text box. Good practice: add free_text=1 to most choice questions and end with an open question. Returns id.",
                "parameters": {
                    "type": "object",
                    "required": ["name", "el_type"],
                    "properties": {
                        "name": {"type": "string"},
                        "el_type": {"type": "integer", "enum": [0, 1, 2]},
                        "pid": {"type": "integer", "description": "Parent id (root for question, question for option)"},
                        "num": {"type": "integer"},
                        "descr_site": {"type": "string", "description": "Text shown to respondents"},
                        "descr_admin": {"type": "string"},
                        "multy_opts": {"type": "integer", "enum": [0, 1]},
                        "free_text": {"type": "integer", "enum": [0, 1], "description": "Question only: 1 = text box for an own answer under the options"},
                        "req_text_len": {"type": "integer", "description": "Advanced: min text length for staff fill (0..255; >0 also shows the box)"},
                        "next_qid": {"type": "integer"},
                        "ans_end_poll": {"type": "integer", "enum": [0, 1]},
                        "enabled": {"type": "integer", "enum": [0, 1]}
                    }
                }
            },
            {
                "id": "polls.update",
                "method": "POST",
                "path": "/polls/{id}/edit",
                "permission": "polls.edit",
                "side_effect": "write",
                "description": "Update a poll node — PATCH over JSON: send only changed keys (same as polls.create, e.g. free_text=1 to add a text box to a question); el_type/pid cannot change. Already sent invite links pick up changes immediately."
            },
            {
                "id": "polls.delete",
                "method": "POST",
                "path": "/polls/{id}/edit",
                "permission": "polls.delete",
                "side_effect": "write",
                "description": "Delete a poll node; action=delete",
                "parameters": {
                    "type": "object",
                    "required": ["action"],
                    "properties": {"action": {"type": "string", "enum": ["delete"]}}
                }
            },
            {
                "id": "polls.settings",
                "method": "GET",
                "path": "/polls/settings",
                "permission": "polls.view",
                "description": "Polls settings hub; sibling modules append via polls.settings.sections (superadmin capability on route)"
            },
            {
                "id": "polls.settings.save",
                "method": "POST",
                "path": "/polls/settings",
                "permission": "polls.view",
                "side_effect": "write",
                "description": "Save polls settings; emits polls.settings.save (superadmin capability on route)"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "polls.menu.group",
            "num": 10,
            "path": "/polls",
            "title": "polls.menu.list",
            "kind": "crud"
        },
        {
            "group": "polls.menu.group",
            "num": 90,
            "path": "/polls/settings",
            "title": "polls.menu.settings",
            "kind": "settings",
            "capability": "SUPERADMIN_ACCESS"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_polls"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [],
        "publish": [
            "polls.definition.changed",
            "polls.settings.sections",
            "polls.settings.save"
        ]
    },
    "bulkActions": [
        {
            "list_id": "polls",
            "action": "delete"
        }
    ],
    "catalog": {
        "categories": [
            "communications"
        ],
        "maturity": "beta",
        "tags": [],
        "screenshots": []
    },
    "setup": {
        "steps": []
    }
}
