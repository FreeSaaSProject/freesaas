{
    "id": "polls",
    "name": "polls.module.name",
    "description": "polls.module.description",
    "version": "0.1.3",
    "type": "product",
    "requires": {
        "core": ">=0.3.0"
    },
    "optionalRequires": {
        "procedures": ">=0.1.0",
        "catalog": ">=0.1.0"
    },
    "provides": [
        "polls.definitions"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "polls.view",
            "label": "polls.perm.view"
        },
        {
            "id": "polls.edit",
            "label": "polls.perm.edit"
        },
        {
            "id": "polls.delete",
            "label": "polls.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/polls",
            "/polls/new",
            "/polls/{id}/edit",
            "/polls/settings"
        ]
    },
    "agent": {
        "docs": "docs/agents/polls.md",
        "ops": [
            {
                "id": "polls.list",
                "method": "GET",
                "path": "/polls",
                "permission": "polls.view",
                "description": "List poll roots; filters: q, enabled"
            },
            {
                "id": "polls.get",
                "method": "GET",
                "path": "/polls/{id}/edit",
                "permission": "polls.view",
                "description": "Get one poll tree node"
            },
            {
                "id": "polls.settings",
                "method": "GET",
                "path": "/polls/settings",
                "permission": "polls.view",
                "description": "Polls settings hub; sibling modules append via polls.settings.sections (superadmin capability on route)"
            },
            {
                "id": "polls.settings.save",
                "method": "POST",
                "path": "/polls/settings",
                "permission": "polls.view",
                "side_effect": "write",
                "description": "Save polls settings; emits polls.settings.save (superadmin capability on route)"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "polls.menu.group",
            "num": 10,
            "path": "/polls",
            "title": "polls.menu.list",
            "kind": "crud"
        },
        {
            "group": "polls.menu.group",
            "num": 90,
            "path": "/polls/settings",
            "title": "polls.menu.settings",
            "kind": "settings",
            "capability": "SUPERADMIN_ACCESS"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_polls"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [],
        "publish": [
            "polls.definition.changed",
            "polls.settings.sections",
            "polls.settings.save"
        ]
    },
    "bulkActions": [
        {
            "list_id": "polls",
            "action": "delete"
        }
    ],
    "catalog": {
        "categories": [
            "communications"
        ],
        "maturity": "beta",
        "tags": [],
        "screenshots": []
    }
}
