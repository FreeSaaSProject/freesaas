{
    "id": "clientics",
    "name": "clientics.module.name",
    "description": "clientics.module.description",
    "version": "0.2.0",
    "type": "product",
    "catalog": {
        "categories": [
            "integrations",
            "crm"
        ],
        "maturity": "beta",
        "tags": [
            "integration",
            "crm",
            "sync",
            "jobs"
        ],
        "screenshots": []
    },
    "requires": {
        "core": ">=1.0.0",
        "clients": ">=1.0.0"
    },
    "optionalRequires": {
        "calendar": ">=1.0.0",
        "procedures": ">=1.0.0",
        "workweeks": ">=1.0.0",
        "crm": ">=0.1.0",
        "catalog": ">=1.0.0"
    },
    "provides": [
        "clientics.pull",
        "clientics.push"
    ],
    "migrations": "migrations/",
    "uninstall": {
        "strategy": "leave_tables"
    },
    "permissions": [
        {
            "id": "clientics.view",
            "label": "clientics.perm.view"
        },
        {
            "id": "clientics.edit",
            "label": "clientics.perm.edit"
        },
        {
            "id": "clientics.import",
            "label": "clientics.perm.import"
        }
    ],
    "routes": {
        "pages": [
            "/clientics",
            "/clientics/import",
            "/clientics/settings",
            "/clientics/jobs/ping",
            "/clientics/jobs/import-clients",
            "/clientics/jobs/import-appointments",
            "/clientics/jobs/import-refs",
            "/clientics/jobs/outbox",
            "/clientics/jobs/inventory",
            "/clientics/webhook"
        ]
    },
    "agent": {
        "docs": "docs/agents/clientics.md",
        "ops": [
            {
                "id": "clientics.status",
                "method": "GET",
                "path": "/clientics",
                "permission": "clientics.view",
                "side_effect": "read",
                "description": "Status + setup + inventory snapshot + outbox pending. Secrets never returned."
            },
            {
                "id": "clientics.ping",
                "method": "POST",
                "path": "/clientics",
                "permission": "clientics.view",
                "side_effect": "write",
                "description": "Session ping of Clientics API. Body: action=ping.",
                "parameters": {
                    "type": "object",
                    "required": ["action"],
                    "properties": {
                        "action": {"type": "string", "enum": ["ping"]}
                    }
                }
            },
            {
                "id": "clientics.inventory",
                "method": "POST",
                "path": "/clientics",
                "permission": "clientics.view",
                "side_effect": "write",
                "description": "Probe Restapi list modules (incl. MedicalCards/WaitingList candidates). Body: action=inventory.",
                "parameters": {
                    "type": "object",
                    "required": ["action"],
                    "properties": {
                        "action": {"type": "string", "enum": ["inventory"]}
                    }
                }
            },
            {
                "id": "clientics.import.status",
                "method": "GET",
                "path": "/clientics/import",
                "permission": "clientics.import",
                "side_effect": "read",
                "description": "Last import reports + Sot/push flags"
            },
            {
                "id": "clientics.import.run",
                "method": "POST",
                "path": "/clientics/import",
                "permission": "clientics.import",
                "side_effect": "write",
                "description": "Pull/sync action: clients|appointments|users|services|waiting_list|inventory|outbox. Prefer dry_run=1 for pulls.",
                "parameters": {
                    "type": "object",
                    "required": ["action"],
                    "properties": {
                        "action": {
                            "type": "string",
                            "enum": ["clients", "appointments", "users", "services", "waiting_list", "inventory", "outbox"]
                        },
                        "from": {"type": "string", "description": "YYYY-MM-DD (clients/appointments)"},
                        "to": {"type": "string", "description": "YYYY-MM-DD"},
                        "dry_run": {"type": "string", "enum": ["0", "1"]}
                    }
                }
            },
            {
                "id": "clientics.settings.get",
                "method": "GET",
                "path": "/clientics/settings",
                "permission": "",
                "side_effect": "read",
                "description": "Read settings (secrets masked) + setup. SUPERADMIN_ACCESS."
            },
            {
                "id": "clientics.settings.save",
                "method": "POST",
                "path": "/clientics/settings",
                "permission": "",
                "side_effect": "write",
                "description": "Save cfg/modules/clientics.ini. Empty secrets keep previous. SUPERADMIN_ACCESS.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "pull_enabled": {"type": "string", "enum": ["0", "1"]},
                        "push_enabled": {"type": "string", "enum": ["0", "1"]},
                        "appointment_sot": {"type": "string", "enum": ["clientics", "freesaas"]},
                        "default_operator_id": {"type": "integer", "minimum": 0},
                        "domain": {"type": "string"},
                        "account_id": {"type": "string"},
                        "user_id": {"type": "string"},
                        "access_token": {"type": "string"},
                        "timeout_sec": {"type": "integer", "minimum": 5, "maximum": 120},
                        "page_limit": {"type": "integer", "minimum": 1, "maximum": 500},
                        "worker_token": {"type": "string"},
                        "webhook_token": {"type": "string"}
                    }
                }
            },
            {
                "id": "clientics.jobs.ping",
                "method": "POST",
                "path": "/clientics/jobs/ping",
                "permission": "public",
                "side_effect": "write",
                "assistant": false,
                "description": "Cron ping; auth X-Clientics-Token"
            },
            {
                "id": "clientics.jobs.import_clients",
                "method": "POST",
                "path": "/clientics/jobs/import-clients",
                "permission": "public",
                "side_effect": "write",
                "assistant": false,
                "description": "Cron import clients; X-Clientics-Token; from/to/dry_run"
            },
            {
                "id": "clientics.jobs.import_appointments",
                "method": "POST",
                "path": "/clientics/jobs/import-appointments",
                "permission": "public",
                "side_effect": "write",
                "assistant": false,
                "description": "Cron import appointments; X-Clientics-Token"
            },
            {
                "id": "clientics.jobs.import_refs",
                "method": "POST",
                "path": "/clientics/jobs/import-refs",
                "permission": "public",
                "side_effect": "write",
                "assistant": false,
                "description": "Cron users/services/waiting_list; action=all|users|services|waiting_list"
            },
            {
                "id": "clientics.jobs.outbox",
                "method": "POST",
                "path": "/clientics/jobs/outbox",
                "permission": "public",
                "side_effect": "write",
                "assistant": false,
                "description": "Cron flush outbox; X-Clientics-Token"
            },
            {
                "id": "clientics.jobs.inventory",
                "method": "POST",
                "path": "/clientics/jobs/inventory",
                "permission": "public",
                "side_effect": "write",
                "assistant": false,
                "description": "Cron API inventory probe; X-Clientics-Token"
            }
        ]
    },
    "jobs": [
        "/clientics/jobs/ping",
        "/clientics/jobs/import-clients",
        "/clientics/jobs/import-appointments",
        "/clientics/jobs/import-refs",
        "/clientics/jobs/outbox",
        "/clientics/jobs/inventory"
    ],
    "menu": [
        {
            "group": "clientics.menu.group",
            "num": 10,
            "path": "/clientics",
            "title": "clientics.menu.status",
            "kind": "work"
        },
        {
            "group": "clientics.menu.group",
            "num": 20,
            "path": "/clientics/import",
            "title": "clientics.menu.import",
            "kind": "work"
        },
        {
            "group": "clientics.menu.group",
            "num": 90,
            "path": "/clientics/settings",
            "title": "clientics.menu.settings",
            "kind": "settings"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_clientics_id_map",
        "base_clientics_sync_state",
        "base_clientics_outbox",
        "base_clientics_webhook_events"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "clients.created",
            "clients.updated",
            "calendar.event.saved"
        ],
        "publish": []
    },
    "bulkActions": [],
    "setup": {
        "steps": [
            {
                "id": "config",
                "title": "clientics.setup.step.config",
                "description": "clientics.setup.step.config_help",
                "href": "/clientics/settings",
                "ask_user": "clientics.setup.ask.config",
                "choices": [
                    {
                        "id": "open",
                        "label": "clientics.setup.choice.open",
                        "recommended": true
                    },
                    {
                        "id": "defer",
                        "label": "core.modules.setup.choice.defer",
                        "recommended": false
                    }
                ],
                "agent_can": []
            }
        ]
    }
}
