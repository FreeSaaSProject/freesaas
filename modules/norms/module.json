{
    "id": "norms",
    "name": "norms.module.name",
    "description": "norms.module.description",
    "version": "1.0.2",
    "type": "product",
    "requires": {
        "core": ">=1.0.0",
        "catalog": ">=1.0.0"
    },
    "optionalRequires": [],
    "provides": [
        "norms.list"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "norms.view",
            "label": "norms.perm.view"
        },
        {
            "id": "norms.edit",
            "label": "norms.perm.edit"
        },
        {
            "id": "norms.delete",
            "label": "norms.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/norms",
            "/norms/new",
            "/norms/{id}/edit"
        ]
    },
    "agent": {
        "docs": "docs/agents/norms.md",
        "ops": [
            {
                "id": "norms.list",
                "method": "GET",
                "path": "/norms",
                "permission": "norms.view",
                "description": "List consumption norms; filters: id_proc, id_good"
            },
            {
                "id": "norms.get",
                "method": "GET",
                "path": "/norms/{id}/edit",
                "permission": "norms.edit",
                "description": "Norm edit payload; includes products dictionary"
            },
            {
                "id": "norms.create",
                "method": "POST",
                "path": "/norms/new",
                "permission": "norms.edit",
                "description": "Create norm; id_proc, id_good, qtyu2, qtyu"
            },
            {
                "id": "norms.update",
                "method": "POST",
                "path": "/norms/{id}/edit",
                "permission": "norms.edit",
                "description": "Update norm"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.warehouse",
            "num": 6,
            "path": "/norms",
            "title": "norms.menu.list"
        }
    ],
    "configSchema": [],
    "tables": [
