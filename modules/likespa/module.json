{
    "id": "likespa",
    "name": "likespa.module.name",
    "description": "likespa.module.description",
    "version": "0.3.7",
    "type": "product",
    "runtime": "both",
    "requires": {
        "core": ">=0.3.0"
    },
    "optionalRequires": {
        "audio_reports": ">=0.2.0",
        "audio": ">=0.1.0",
        "workweeks": ">=0.1.0",
        "procedures": ">=0.1.0",
        "payments": ">=0.1.0",
        "sites": ">=0.2.0",
        "booking": ">=0.1.0",
        "clients": ">=0.1.0",
        "terminals": ">=0.1.0",
        "comments": ">=0.1.0"
    },
    "provides": [
        "likespa.term_scans",
        "likespa.promo",
        "likespa.dops",
        "likespa.restores",
        "likespa.staff_debts"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "likespa.view",
            "label": "likespa.perm.view"
        },
        {
            "id": "likespa.edit",
            "label": "likespa.perm.edit"
        },
        {
            "id": "likespa.promo",
            "label": "likespa.perm.promo"
        },
        {
            "id": "likespa.restores",
            "label": "likespa.perm.restores"
        }
    ],
    "routes": {
        "pages": [
            "/likespa/term-scans",
            "/likespa/promo/bonus",
            "/likespa/restores",
            "/likespa/restores/new",
            "/likespa/restores/{id}/edit",
            "/likespa/staff-debts",
            "/likespa/settings",
            "/likespa/legacy-api/status",
            "/api_termy.php",
            "/api.php",
            "/api1c.php"
        ]
    },
    "agent": {
        "docs": "docs/agents/likespa-restores.md",
        "ops": [
            {
                "id": "likespa.legacy_api.status",
                "method": "GET",
                "path": "/likespa/legacy-api/status",
                "permission": "",
                "side_effect": "read",
                "description": "Legacy drop-in API diagnose (SUPERADMIN): enabled, routes, soft-deps, issues (no secrets)"
            },
            {
                "id": "likespa.restores.list",
                "method": "GET",
                "path": "/likespa/restores",
                "permission": "likespa.restores",
                "description": "List procedure restores; filters: q"
            },
            {
                "id": "likespa.restores.candidates",
                "method": "GET",
                "path": "/likespa/restores/new",
                "permission": "likespa.restores",
                "description": "Cancelled procedures eligible for restore + lookback window"
            },
            {
                "id": "likespa.restores.create",
                "method": "POST",
                "path": "/likespa/restores/new",
                "permission": "likespa.restores",
                "description": "Create restore, re-enable procedure, create settlement payment (ACCOUNT=0)"
            },
            {
                "id": "likespa.restores.get",
                "method": "GET",
                "path": "/likespa/restores/{id}/edit",
                "permission": "likespa.restores",
                "description": "Get one procedure restore row"
            },
            {
                "id": "likespa.restores.update",
                "method": "POST",
                "path": "/likespa/restores/{id}/edit",
                "permission": "likespa.restores",
                "description": "Update restore reason/summ/sign; re-runs settlement side effects"
            },
            {
                "id": "likespa.settings.get",
                "method": "GET",
                "path": "/likespa/settings",
                "permission": "likespa.edit",
                "description": "LikeSpa settings incl. FREE_TICKET threshold, flyer/promo"
            },
            {
                "id": "likespa.settings.save",
                "method": "POST",
                "path": "/likespa/settings",
                "permission": "likespa.edit",
                "description": "Save LikeSpa settings; free_ticket_threshold (0=off)"
            },
            {
                "id": "likespa.staff_debts.status",
                "method": "GET",
                "path": "/likespa/staff-debts",
                "permission": "likespa.edit",
                "side_effect": "read",
                "description": "Staff debts feature status (news_id, bracelets count, 1C live); 404 if disabled"
            },
            {
                "id": "likespa.staff_debts.run",
                "method": "POST",
                "path": "/likespa/staff-debts",
                "permission": "likespa.edit",
                "description": "Run staff bracelet 1C debt scan; posts comments on configured news ticket"
            }
        ]
    },
    "jobs": [
        "platform Cron::register likespa.staff_debts → /cron/tick"
    ],
    "menu": [
        {
            "group": "likespa.menu.group",
            "num": 10,
            "path": "/likespa/term-scans",
            "title": "likespa.menu.term_scans"
        },
        {
            "group": "procedures.menu.group",
            "num": 15,
            "path": "/likespa/restores",
            "title": "likespa.menu.restores",
            "kind": "crud"
        },
        {
            "group": "likespa.menu.group",
            "num": 20,
            "path": "/likespa/staff-debts",
            "title": "likespa.menu.staff_debts",
            "when": "terminals"
        },
        {
            "group": "likespa.menu.group",
            "num": 90,
            "path": "/likespa/settings",
            "title": "likespa.menu.settings",
            "kind": "settings"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_term_scans"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "audio_reports.calendar.cell",
            "core.user_edit.sections",
            "core.user_edit.save",
            "core.user_edit.profile",
            "sites.cart.booking",
            "sites.diagnose",
            "sites.host_edit.sections",
            "sites.host_edit.save",
            "booking.book.before",
            "procedures.list.row"
        ],
        "publish": []
    },
    "bulkActions": [
        {
            "list_id": "likespa_restores",
            "action": "delete"
        }
    ],
    "catalog": {
        "categories": [
            "site"
        ],
        "maturity": "beta",
        "tags": [],
        "screenshots": []
    }
}
