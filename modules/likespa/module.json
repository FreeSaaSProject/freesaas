{
    "id": "likespa",
    "name": "likespa.module.name",
    "version": "0.2.0",
    "type": "product",
    "requires": {
        "core": ">=0.3.0"
    },
    "optionalRequires": {
        "audio_reports": ">=0.2.0",
        "audio": ">=0.1.0",
        "workweeks": ">=0.1.0",
        "procedures": ">=0.1.0",
        "payments": ">=0.1.0"
    },
    "provides": [
        "likespa.term_scans",
        "likespa.promo",
        "likespa.dops",
        "likespa.restores",
        "likespa.site",
        "likespa.promopages",
        "likespa.pages",
        "likespa.redirects"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "likespa.view",
            "label": "likespa.perm.view"
        },
        {
            "id": "likespa.edit",
            "label": "likespa.perm.edit"
        },
        {
            "id": "likespa.promo",
            "label": "likespa.perm.promo"
        },
        {
            "id": "likespa.restores",
            "label": "likespa.perm.restores"
        },
        {
            "id": "likespa.promopages",
            "label": "likespa.perm.promopages"
        },
        {
            "id": "likespa.pages",
            "label": "likespa.perm.pages"
        },
        {
            "id": "likespa.redirects",
            "label": "likespa.perm.redirects"
        }
    ],
    "routes": {
        "pages": [
            "/likespa/term-scans",
            "/likespa/promo/bonus",
            "/likespa/restores",
            "/likespa/restores/new",
            "/likespa/restores/{id}/edit",
            "/likespa/site",
            "/likespa/promopages",
            "/likespa/promopages/new",
            "/likespa/promopages/{id}/edit",
            "/likespa/pages",
            "/likespa/pages/new",
            "/likespa/pages/{id}/edit",
            "/likespa/redirects",
            "/likespa/redirects/new",
            "/likespa/redirects/{id}/edit",
            "/likespa/settings"
        ]
    },
    "agent": {
        "ops": [
            {
                "id": "likespa.restores.list",
                "method": "GET",
                "path": "/likespa/restores",
                "permission": "likespa.restores",
                "description": "List procedure restores; filters: q"
            },
            {
                "id": "likespa.restores.candidates",
                "method": "GET",
                "path": "/likespa/restores/new",
                "permission": "likespa.restores",
                "description": "Cancelled procedures eligible for restore + lookback window"
            },
            {
                "id": "likespa.restores.create",
                "method": "POST",
                "path": "/likespa/restores/new",
                "permission": "likespa.restores",
                "description": "Create restore, re-enable procedure, create settlement payment (ACCOUNT=0)"
            },
            {
                "id": "likespa.restores.get",
                "method": "GET",
                "path": "/likespa/restores/{id}/edit",
                "permission": "likespa.restores",
                "description": "Get one procedure restore row"
            },
            {
                "id": "likespa.restores.update",
                "method": "POST",
                "path": "/likespa/restores/{id}/edit",
                "permission": "likespa.restores",
                "description": "Update restore reason/summ/sign; re-runs settlement side effects"
            },
            {
                "id": "likespa.promopages.list",
                "method": "GET",
                "path": "/likespa/promopages",
                "permission": "likespa.promopages",
                "description": "List promo pages; filters: q, enabled"
            },
            {
                "id": "likespa.pages.list",
                "method": "GET",
                "path": "/likespa/pages",
                "permission": "likespa.pages",
                "description": "List site articles (page categories); filters: q, enabled, parent"
            },
            {
                "id": "likespa.redirects.list",
                "method": "GET",
                "path": "/likespa/redirects",
                "permission": "likespa.redirects",
                "description": "List URL redirects; filters: q, enabled"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "likespa.menu.group",
            "num": 5,
            "path": "/likespa/site",
            "title": "likespa.menu.site",
            "kind": "settings"
        },
        {
            "group": "likespa.menu.group",
            "num": 10,
            "path": "/likespa/term-scans",
            "title": "likespa.menu.term_scans"
        },
        {
            "group": "likespa.menu.group",
            "num": 25,
            "path": "/likespa/promopages",
            "title": "likespa.menu.promopages",
            "kind": "crud"
        },
        {
            "group": "likespa.menu.group",
            "num": 26,
            "path": "/likespa/pages",
            "title": "likespa.menu.pages",
            "kind": "crud"
        },
        {
            "group": "likespa.menu.group",
            "num": 27,
            "path": "/likespa/redirects",
            "title": "likespa.menu.redirects",
            "kind": "crud"
        },
        {
            "group": "procedures.menu.group",
            "num": 15,
            "path": "/likespa/restores",
            "title": "likespa.menu.restores",
            "kind": "crud"
        },
        {
            "group": "likespa.menu.group",
            "num": 90,
            "path": "/likespa/settings",
            "title": "likespa.menu.settings",
            "kind": "settings"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_term_scans",
        "base_promopages",
        "base_page_categories",
        "base_redirects"
    ],
    "migrators": [
        {
            "id": "phpshop_page_categories_to_base_page_categories",
            "mode": "replace",
            "source": [
                "phpshop_page_categories"
            ],
            "target": [
                "base_page_categories"
            ]
        }
    ],
    "hooks": {
        "subscribe": [
            "audio_reports.calendar.cell",
            "core.user_edit.sections",
            "core.user_edit.save",
            "core.user_edit.profile"
        ],
        "publish": []
    },
    "bulkActions": [
        {
            "list_id": "likespa_restores",
            "action": "delete"
        },
        {
            "list_id": "likespa_promopages",
            "action": "delete"
        },
        {
            "list_id": "likespa_pages",
            "action": "delete"
        },
        {
            "list_id": "likespa_redirects",
            "action": "delete"
        }
    ],
    "catalog": {
        "categories": [
            "site"
        ],
        "maturity": "beta",
        "tags": [],
        "screenshots": []
    }
}
