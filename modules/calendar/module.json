{
    "id": "calendar",
    "name": "calendar.module.name",
    "description": "calendar.module.description",
    "version": "1.0.1",
    "type": "product",
    "runtime": "both",
    "requires": {
        "core": ">=1.0.0",
        "clients": ">=1.0.0",
        "catalog": ">=1.0.0",
        "procedures": ">=1.0.0",
        "orders": ">=1.0.0",
        "workweeks": ">=1.0.0"
    },
    "optionalRequires": {
        "cabinets": ">=1.0.0",
        "tables": ">=1.0.0",
        "audio": ">=1.0.0",
        "booking": ">=1.0.0",
        "bonuses": ">=1.0.0",
        "assistant": ">=1.0.0",
        "bi": ">=1.0.0"
    },
    "provides": [
        "calendar.week",
        "calendar.day"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "calendar.view",
            "label": "calendar.perm.view"
        },
        {
            "id": "calendar.edit",
            "label": "calendar.perm.edit"
        },
        {
            "id": "calendar.delete",
            "label": "calendar.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/calendar",
            "/calendar/week/{date}",
            "/calendar/day/{date}",
            "/calendar/events",
            "/calendar/events/new",
            "/calendar/events/{id}/edit",
            "/calendar/clients",
            "/calendar/products",
            "/calendar/nazop",
            "/calendar/settings"
        ]
    },
    "agent": {
        "docs": "docs/agents/calendar.md",
        "ops": [
            {
                "id": "calendar.week",
                "method": "GET",
                "path": "/calendar",
                "permission": "calendar.view",
                "description": "Week grid for current week; optional query staff= operator id"
            },
            {
                "id": "calendar.week.date",
                "method": "GET",
                "path": "/calendar/week/{date}",
                "permission": "calendar.view",
                "description": "Week grid anchored on date (YYYY-MM-DD); optional staff="
            },
            {
                "id": "calendar.day",
                "method": "GET",
                "path": "/calendar/day/{date}",
                "permission": "calendar.view",
                "description": "Single day: events, procedures, advance orders, shifts; optional staff="
            },
            {
                "id": "calendar.events.list",
                "method": "GET",
                "path": "/calendar/events",
                "permission": "calendar.view",
                "description": "One staff member's events over a range: staff (required), date_from (default today), date_to inclusive (max 62 days), include_blocks=0 to skip blocks. Items have date, dtstart_iso, client_name, content_brief, is_block",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "staff": { "type": "integer", "description": "Operator (staff) user id" },
                        "date_from": { "type": "string", "description": "YYYY-MM-DD" },
                        "date_to": { "type": "string", "description": "YYYY-MM-DD inclusive" },
                        "include_blocks": { "type": "string", "enum": ["0", "1"] }
                    },
                    "required": ["staff"]
                }
            },
            {
                "id": "calendar.events.get",
                "method": "GET",
                "path": "/calendar/events/{id}/edit",
                "permission": "calendar.edit",
                "description": "One calendar event edit payload with product dictionaries"
            },
            {
                "id": "calendar.events.create",
                "method": "POST",
                "path": "/calendar/events/new",
                "permission": "calendar.edit",
                "description": "Create event/block; dtstart/dtend, id_operator; visits mode: content[] + content_price/qty; blocks mode forces is_block"
            },
            {
                "id": "calendar.events.update",
                "method": "POST",
                "path": "/calendar/events/{id}/edit",
                "permission": "calendar.edit",
                "description": "Update event (patch): required id; send only changed fields — omitted times, client, basket (content/prices/qty) and bonus settings keep stored values. Reassign = {id, id_operator}; moving dtstart keeps the duration. action=save|delete|create_procedures (procedures only in visits mode)"
            },
            {
                "id": "calendar.settings.get",
                "method": "GET",
                "path": "/calendar/settings",
                "permission": "calendar.view",
                "description": "Calendar module settings (superadmin capability on route)"
            },
            {
                "id": "calendar.settings.update",
                "method": "POST",
                "path": "/calendar/settings",
                "permission": "calendar.view",
                "description": "Save event_mode (blocks|visits), compact_chip_minutes (0=off), and work hours (superadmin capability on route)"
            },
            {
                "id": "calendar.events.delete",
                "method": "POST",
                "path": "/calendar/events/{id}/edit",
                "permission": "calendar.delete",
                "side_effect": "write",
                "description": "Delete event; required id= from calendar.day events[].id (or events.get); action=delete; needs calendar.delete + EVT_DELETE"
            },
            {
                "id": "calendar.clients.search",
                "method": "GET",
                "path": "/calendar/clients",
                "permission": "calendar.edit",
                "description": "Client autocomplete for event edit; query q= name or phone digits (min 2)"
            },
            {
                "id": "calendar.products.search",
                "method": "GET",
                "path": "/calendar/products",
                "permission": "calendar.edit",
                "description": "Product/service autocomplete for event basket; query q= (empty = frequent goods)"
            }
        ],
        "relations": [
            {
                "id": "calendar.vacation_events",
                "when": ["vacations.create", "vacations.update"],
                "from": "vacations.get",
                "check": "calendar.events.list",
                "args": { "staff": "{user_id}", "date_from": "{dt_start|date}", "date_to": "{dt_end|date}" },
                "suggest": ["calendar.events.update", "calendar.events.delete"],
                "fields": ["date", "dtstart_iso", "dtend_iso", "client_name", "name", "content_brief", "is_block"],
                "hint": "calendar.relation.absence_events",
                "notice": "calendar.relation.absence_events.notice"
            },
            {
                "id": "calendar.shift_removed_events",
                "when": ["workweeks.delete"],
                "from": "workweeks.get",
                "check": "calendar.events.list",
                "args": { "staff": "{from.id_operator}", "date_from": "{from.date}", "date_to": "{from.date}" },
                "suggest": ["calendar.events.update", "calendar.events.delete"],
                "fields": ["date", "dtstart_iso", "dtend_iso", "client_name", "name", "content_brief", "is_block"],
                "hint": "calendar.relation.absence_events",
                "notice": "calendar.relation.absence_events.notice"
            },
            {
                "id": "calendar.shift_reassigned_events",
                "when": ["workweeks.update"],
                "if": { "id_operator": "changed" },
                "from": "workweeks.get",
                "check": "calendar.events.list",
                "args": { "staff": "{from.id_operator}", "date_from": "{from.date}", "date_to": "{from.date}" },
                "suggest": ["calendar.events.update"],
                "fields": ["date", "dtstart_iso", "dtend_iso", "client_name", "name", "content_brief", "is_block"],
                "hint": "calendar.relation.shift_reassigned_events",
                "notice": "calendar.relation.shift_reassigned_events.notice"
            },
            {
                "id": "calendar.user_disabled_events",
                "when": ["core.users.update"],
                "if": { "enabled": "0" },
                "check": "calendar.events.list",
                "args": { "staff": "{id}", "date_from": "{today}" },
                "suggest": ["calendar.events.update", "calendar.events.delete"],
                "fields": ["date", "dtstart_iso", "dtend_iso", "client_name", "name", "content_brief", "is_block"],
                "hint": "calendar.relation.absence_events",
                "notice": "calendar.relation.absence_events.notice"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "calendar.menu.group",
            "num": 1,
            "path": "/calendar",
            "title": "calendar.menu.week"
        },
        {
            "group": "calendar.menu.group",
            "num": 90,
            "path": "/calendar/settings",
            "title": "calendar.menu.settings",
            "permission": "calendar.view",
            "capability": "SUPERADMIN_ACCESS"
        }
    ],
    "configSchema": {
        "calendar": {
            "event_mode": {
                "type": "string",
                "default": "blocks"
            },
            "hour_start": {
                "type": "integer",
                "default": 9
            },
            "hour_end": {
                "type": "integer",
                "default": 21
            }
        }
    },
    "tables": [
        "base_events",
        "base_event_items"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "core.dashboard.catalog",
            "core.dashboard.widgets",
            "assistant.write.preview",
            "assistant.system.hints",
            "bi.datasets"
        ],
        "publish": [
            "calendar.day.stats",
            "calendar.timeline.enrich",
            "calendar.event.sections",
            "calendar.event.save",
            "calendar.event.saved",
            "calendar.settings.sections",
            "calendar.settings.save"
        ]
    },
    "catalog": {
        "categories": [
            "booking"
        ],
        "maturity": "release",
        "tags": [],
        "screenshots": []
    }
}
