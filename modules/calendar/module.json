{
    "id": "calendar",
    "name": "calendar.module.name",
    "description": "calendar.module.description",
    "version": "0.1.3",
    "type": "product",
    "runtime": "both",
    "requires": {
        "core": ">=0.3.0",
        "clients": ">=0.1.0",
        "catalog": ">=0.1.0",
        "procedures": ">=0.1.0",
        "orders": ">=0.1.0",
        "workweeks": ">=0.1.0"
    },
    "optionalRequires": {
        "cabinets": ">=0.1.0",
        "tables": ">=0.1.0",
        "booking": ">=0.1.0",
        "bonuses": ">=0.1.0"
    },
    "provides": [
        "calendar.week",
        "calendar.day"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "calendar.view",
            "label": "calendar.perm.view"
        },
        {
            "id": "calendar.edit",
            "label": "calendar.perm.edit"
        }
    ],
    "routes": {
        "pages": [
            "/calendar",
            "/calendar/week/{date}",
            "/calendar/day/{date}",
            "/calendar/events/new",
            "/calendar/events/{id}/edit",
            "/calendar/nazop",
            "/calendar/settings"
        ]
    },
    "agent": {
        "docs": "docs/agents/calendar.md",
        "ops": [
            {
                "id": "calendar.week",
                "method": "GET",
                "path": "/calendar",
                "permission": "calendar.view",
                "description": "Week grid for current week; optional query staff= operator id"
            },
            {
                "id": "calendar.week.date",
                "method": "GET",
                "path": "/calendar/week/{date}",
                "permission": "calendar.view",
                "description": "Week grid anchored on date (YYYY-MM-DD); optional staff="
            },
            {
                "id": "calendar.day",
                "method": "GET",
                "path": "/calendar/day/{date}",
                "permission": "calendar.view",
                "description": "Single day: events, procedures, advance orders, shifts; optional staff="
            },
            {
                "id": "calendar.events.get",
                "method": "GET",
                "path": "/calendar/events/{id}/edit",
                "permission": "calendar.edit",
                "description": "One calendar event edit payload with product dictionaries"
            },
            {
                "id": "calendar.events.create",
                "method": "POST",
                "path": "/calendar/events/new",
                "permission": "calendar.edit",
                "description": "Create event; dtstart/dtend (local), id_operator, content[], optional phone/name/descr"
            },
            {
                "id": "calendar.events.update",
                "method": "POST",
                "path": "/calendar/events/{id}/edit",
                "permission": "calendar.edit",
                "description": "Update event; action=save|delete|create_procedures"
            },
            {
                "id": "calendar.settings.get",
                "method": "GET",
                "path": "/calendar/settings",
                "permission": "calendar.view",
                "description": "Calendar module settings (superadmin capability on route)"
            },
            {
                "id": "calendar.settings.update",
                "method": "POST",
                "path": "/calendar/settings",
                "permission": "calendar.view",
                "description": "Save manual_create and work hours (superadmin capability on route)"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "calendar.menu.group",
            "num": 1,
            "path": "/calendar",
            "title": "calendar.menu.week"
        },
        {
            "group": "calendar.menu.group",
            "num": 90,
            "path": "/calendar/settings",
            "title": "calendar.menu.settings",
            "permission": "calendar.view",
            "capability": "SUPERADMIN_ACCESS"
        }
    ],
    "configSchema": {
        "calendar": {
            "manual_create": {
                "type": "boolean",
                "default": true
            },
            "hour_start": {
                "type": "integer",
                "default": 9
            },
            "hour_end": {
                "type": "integer",
                "default": 21
            }
        }
    },
    "tables": [
        "base_events",
        "base_events_changes"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "core.dashboard.catalog",
            "core.dashboard.widgets"
        ],
        "publish": [
            "calendar.day.stats",
            "calendar.event.sections",
            "calendar.event.save"
        ]
    },
    "catalog": {
        "categories": [
            "team"
        ],
        "maturity": "beta",
        "tags": [],
        "screenshots": []
    }
}
