{
    "id": "stickers",
    "name": "stickers.module.name",
    "description": "stickers.module.description",
    "version": "0.1.14",
    "type": "product",
    "runtime": "both",
    "requires": {
        "core": ">=0.3.0",
        "stocks": ">=0.1.0",
        "catalog": ">=0.1.0"
    },
    "optionalRequires": {
        "suppliers": ">=0.1.0",
        "units": ">=0.1.0",
        "bots": ">=0.1.0",
        "procedures": ">=0.1.0",
        "ledger": ">=0.1.0"
    },
    "provides": [
        "stickers.receipts",
        "stickers.writeoff"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "stickers.view",
            "label": "stickers.perm.view"
        },
        {
            "id": "stickers.edit",
            "label": "stickers.perm.edit"
        },
        {
            "id": "stickers.writeoff",
            "label": "stickers.perm.writeoff"
        }
    ],
    "routes": {
        "pages": [
            "/stickers/receipts",
            "/stickers/receipts/new",
            "/stickers/receipts/{id}/edit",
            "/stickers/ins",
            "/stickers/ins/new",
            "/stickers/ins/{id}/edit",
            "/stickers/ins/print",
            "/stickers/outs",
            "/stickers/writeoffs",
            "/stickers/writeoffs/new",
            "/stickers/writeoffs/{id}/edit",
            "/stickers/writeoff",
            "/stickers/status",
            "/stickers/printstickers",
            "/qr2.php"
        ]
    },
    "agent": {
        "ops": [
            {
                "id": "stickers.receipts.list",
                "method": "GET",
                "path": "/stickers/receipts",
                "permission": "stickers.view",
                "description": "List receipt acts; filters q, id_stock"
            },
            {
                "id": "stickers.receipts.get_edit",
                "method": "GET",
                "path": "/stickers/receipts/{id}/edit",
                "permission": "stickers.edit",
                "description": "Receipt act edit payload with sticker lines; new at /stickers/receipts/new"
            },
            {
                "id": "stickers.receipts.create",
                "method": "POST",
                "path": "/stickers/receipts/new",
                "permission": "stickers.edit",
                "description": "Create receipt act"
            },
            {
                "id": "stickers.receipts.update",
                "method": "POST",
                "path": "/stickers/receipts/{id}/edit",
                "permission": "stickers.edit",
                "description": "Update receipt act"
            },
            {
                "id": "stickers.ins.list",
                "method": "GET",
                "path": "/stickers/ins",
                "permission": "stickers.view",
                "description": "List sticker ins; filters q, id_act, id_good"
            },
            {
                "id": "stickers.ins.get_edit",
                "method": "GET",
                "path": "/stickers/ins/{id}/edit",
                "permission": "stickers.edit",
                "description": "Sticker in edit payload; new at /stickers/ins/new with optional id_act="
            },
            {
                "id": "stickers.ins.create",
                "method": "POST",
                "path": "/stickers/ins/new",
                "permission": "stickers.edit",
                "description": "Create sticker in batch (may return multiple ids)"
            },
            {
                "id": "stickers.ins.update",
                "method": "POST",
                "path": "/stickers/ins/{id}/edit",
                "permission": "stickers.edit",
                "description": "Update sticker in"
            },
            {
                "id": "stickers.outs.list",
                "method": "GET",
                "path": "/stickers/outs",
                "permission": "stickers.view",
                "description": "List sticker outs; filters q, id_act, id_sticker"
            },
            {
                "id": "stickers.outs.cancel",
                "method": "POST",
                "path": "/stickers/outs",
                "permission": "stickers.writeoff",
                "description": "Cancel a writeoff line: cancel_out_id"
            },
            {
                "id": "stickers.writeoffs.list",
                "method": "GET",
                "path": "/stickers/writeoffs",
                "permission": "stickers.view",
                "description": "List writeoff acts; filters q, id_stock"
            },
            {
                "id": "stickers.writeoffs.get_edit",
                "method": "GET",
                "path": "/stickers/writeoffs/{id}/edit",
                "permission": "stickers.edit",
                "description": "Writeoff act edit with out lines; new at /stickers/writeoffs/new"
            },
            {
                "id": "stickers.writeoffs.create",
                "method": "POST",
                "path": "/stickers/writeoffs/new",
                "permission": "stickers.edit",
                "description": "Create writeoff act"
            },
            {
                "id": "stickers.writeoffs.update",
                "method": "POST",
                "path": "/stickers/writeoffs/{id}/edit",
                "permission": "stickers.edit",
                "description": "Update writeoff act"
            },
            {
                "id": "stickers.writeoff.form",
                "method": "GET",
                "path": "/stickers/writeoff",
                "permission": "stickers.writeoff",
                "description": "Writeoff form for one sticker; query id_sticker"
            },
            {
                "id": "stickers.writeoff.execute",
                "method": "POST",
                "path": "/stickers/writeoff",
                "permission": "stickers.writeoff",
                "description": "Execute amount writeoff: id_sticker, amount, descr"
            },
            {
                "id": "stickers.qr.diagnose",
                "method": "GET",
                "path": "/stickers/status",
                "permission": "stickers.view",
                "side_effect": "read",
                "description": "Diagnose stickers/QR: hosts, cookie domain, soft deps, tables, issues[]"
            },
            {
                "id": "stickers.qr.scan",
                "method": "GET",
                "path": "/qr2.php",
                "side_effect": "read",
                "description": "QR sticker status by q=HASH; in-handler GOOD_USE; returns phase/forms/actions",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "q": {"type": "string", "description": "32-hex sticker HASH"},
                        "token": {"type": "string", "description": "Optional unused op token"}
                    },
                    "required": ["q"]
                }
            },
            {
                "id": "stickers.qr.act",
                "method": "POST",
                "path": "/qr2.php",
                "side_effect": "write",
                "description": "QR sticker mutation step (activate/revi/move/dismiss/cancel); csrf + token + GOOD_USE",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "q": {"type": "string"},
                        "token": {"type": "string"},
                        "action": {"type": "string"},
                        "weight": {"type": "number"},
                        "weight2": {"type": "number"},
                        "amount": {"type": "number"},
                        "confirm": {"type": "integer"},
                        "proc_event": {"type": "string"},
                        "idStockNew": {"type": "integer"},
                        "csrf": {"type": "string"}
                    },
                    "required": ["q", "token"]
                }
            },
            {
                "id": "stickers.print.preview",
                "method": "GET",
                "path": "/stickers/ins/print",
                "permission": "stickers.edit",
                "side_effect": "read",
                "description": "Pending print sheet (optional ?ids=); A4 5×13 multi-page; /qr2.php URLs + SVG"
            },
            {
                "id": "stickers.print.run",
                "method": "POST",
                "path": "/stickers/ins/print",
                "permission": "stickers.edit",
                "side_effect": "write",
                "description": "Confirm print batch preview (csrf); returns sticker URLs (does not mark DT_PRINT)"
            },
            {
                "id": "stickers.print.public",
                "method": "GET",
                "path": "/stickers/printstickers",
                "permission": "public",
                "side_effect": "read",
                "description": "Anonymous A4 print when public_print_enabled=1; 404 when off; GET-only sheet"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.warehouse",
            "num": 2,
            "path": "/stickers/receipts",
            "title": "stickers.menu.receipts"
        },
        {
            "group": "core.menu.group.warehouse",
            "num": 3,
            "path": "/stickers/ins",
            "title": "stickers.menu.ins"
        },
        {
            "group": "core.menu.group.warehouse",
            "num": 6,
            "path": "/stickers/ins/print",
            "title": "stickers.menu.print",
            "kind": "work"
        },
        {
            "group": "core.menu.group.warehouse",
            "num": 4,
            "path": "/stickers/writeoffs",
            "title": "stickers.menu.writeoffs"
        },
        {
            "group": "core.menu.group.warehouse",
            "num": 5,
            "path": "/stickers/outs",
            "title": "stickers.menu.outs"
        },
        {
            "group": "core.menu.group.warehouse",
            "num": 90,
            "path": "/stickers/status",
            "title": "stickers.menu.status",
            "kind": "settings"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_acts2_in",
        "base_acts2_out",
        "base_good_sticker_ins",
        "base_good_sticker_outs",
        "base_qr_token_claims"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [],
        "publish": []
    },
    "catalog": {
        "categories": [
            "warehouse"
        ],
        "maturity": "beta",
        "tags": [],
        "screenshots": []
    }
}
