{
    "id": "stocks",
    "name": "stocks.module.name",
    "version": "0.1.0",
    "type": "product",
    "requires": {
        "core": ">=0.3.0"
    },
    "optionalRequires": {
        "cabinets": ">=0.1.0",
        "stickers": ">=0.1.0",
        "catalog": ">=0.1.0",
        "norms": ">=0.1.0"
    },
    "provides": [
        "stocks.list",
        "stocks.leftovers"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "stocks.view",
            "label": "stocks.perm.view"
        },
        {
            "id": "stocks.edit",
            "label": "stocks.perm.edit"
        }
    ],
    "routes": {
        "pages": [
            "/stocks",
            "/stocks/new",
            "/stocks/{id}/edit",
            "/stocks/leftovers"
        ]
    },
    "agent": {
        "ops": [
            {
                "id": "stocks.list",
                "method": "GET",
                "path": "/stocks",
                "permission": "stocks.view",
                "description": "List warehouses/stocks; filters: q, type (1 physical, 2 virtual)"
            },
            {
                "id": "stocks.get_edit",
                "method": "GET",
                "path": "/stocks/{id}/edit",
                "permission": "stocks.edit",
                "description": "Stock edit payload; new at /stocks/new"
            },
            {
                "id": "stocks.create",
                "method": "POST",
                "path": "/stocks/new",
                "permission": "stocks.edit",
                "description": "Create stock/warehouse"
            },
            {
                "id": "stocks.update",
                "method": "POST",
                "path": "/stocks/{id}/edit",
                "permission": "stocks.edit",
                "description": "Update stock/warehouse"
            },
            {
                "id": "stocks.leftovers",
                "method": "GET",
                "path": "/stocks/leftovers",
                "permission": "stocks.view",
                "description": "Leftover quantities report; id_good filter, show_all=1 for zero rows"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.dictionaries",
            "num": 5,
            "path": "/stocks",
            "title": "stocks.menu.list"
        },
        {
            "group": "core.menu.group.warehouse",
            "num": 1,
            "path": "/stocks/leftovers",
            "title": "stocks.menu.leftovers"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_stocks"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "core.user_edit.sections",
            "core.user_edit.save",
            "core.user_edit.profile"
        ],
        "publish": []
    },
    "bulkActions": [
        {
            "list_id": "stocks",
            "action": "delete"
        }
    ],
    "catalog": {
        "categories": [
            "warehouse",
            "dictionaries"
        ],
        "maturity": "beta",
        "tags": [],
        "screenshots": []
    }
}
