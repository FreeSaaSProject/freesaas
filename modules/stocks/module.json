{
    "id": "stocks",
    "name": "stocks.module.name",
    "description": "stocks.module.description",
    "version": "1.0.3",
    "type": "product",
    "requires": {
        "core": ">=1.0.0"
    },
    "optionalRequires": {
        "cabinets": ">=1.0.0",
        "stickers": ">=1.0.0",
        "catalog": ">=1.0.0",
        "norms": ">=1.0.0",
        "calendar": ">=1.0.0"
    },
    "provides": [
        "stocks.list",
        "stocks.leftovers"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "stocks.view",
            "label": "stocks.perm.view"
        },
        {
            "id": "stocks.edit",
            "label": "stocks.perm.edit"
        },
        {
            "id": "stocks.delete",
            "label": "stocks.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/stocks",
            "/stocks/new",
            "/stocks/{id}/edit",
            "/stocks/leftovers"
        ]
    },
    "agent": {
        "docs": "docs/agents/stocks.md",
        "ops": [
            {
                "id": "stocks.list",
                "method": "GET",
                "path": "/stocks",
                "permission": "stocks.view",
                "description": "List warehouses; filters: q. Response includes default_stock_id for receipts"
            },
            {
                "id": "stocks.get_edit",
                "method": "GET",
                "path": "/stocks/{id}/edit",
                "permission": "stocks.edit",
                "description": "Stock edit payload; new at /stocks/new"
            },
            {
                "id": "stocks.create",
                "method": "POST",
                "path": "/stocks/new",
                "permission": "stocks.edit",
                "description": "Create stock/warehouse (operative=1 = default for receipts)"
            },
            {
                "id": "stocks.update",
                "method": "POST",
                "path": "/stocks/{id}/edit",
                "permission": "stocks.edit",
                "description": "Update stock/warehouse"
            },
            {
                "id": "stocks.leftovers",
                "method": "GET",
                "path": "/stocks/leftovers",
                "permission": "stocks.view",
                "description": "Stock levels: id_good, show_all, months (0-12), show_cat; need_future from events×norms"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.warehouse",
            "num": 1,
            "path": "/stocks/leftovers",
            "title": "stocks.menu.leftovers"
        },
        {
            "group": "core.menu.group.warehouse",
            "num": 2,
            "path": "/stocks",
            "title": "stocks.menu.list",
            "kind": "settings"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_stocks"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "core.user_edit.sections",
            "core.user_edit.save",
            "core.user_edit.profile"
        ],
        "publish": []
    },
    "bulkActions": [
        {
            "list_id": "stocks",
            "action": "delete"
        }
    ],
    "catalog": {
        "categories": [
            "warehouse"
        ],
        "maturity": "release",
        "tags": [],
        "screenshots": []
    },
    "setup": {
        "steps": [
            {
                "id": "ready",
                "title": "stocks.setup.step.ready",
                "description": "stocks.setup.step.ready_help",
                "href": "/stocks",
                "ask_user": "stocks.setup.ask.ready",
                "choices": [
                    {
                        "id": "open",
                        "label": "stocks.setup.choice.open",
                        "recommended": true
                    },
                    {
                        "id": "defer",
                        "label": "core.modules.setup.choice.defer",
                        "recommended": false
                    }
                ],
                "agent_can": [
                    "mark_done"
                ]
            }
        ]
    }
}
