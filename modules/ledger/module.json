{
  "id": "ledger",
  "name": "ledger.module.name",
  "version": "0.1.0",
  "type": "product",
  "requires": {
    "core": ">=0.3.0"
  },
  "optionalRequires": {},
  "provides": [
    "ledger.accounts",
    "ledger.moves",
    "ledger.from_payment"
  ],
  "migrations": "migrations/",
  "permissions": [
    { "id": "ledger.view", "label": "ledger.perm.view" },
    { "id": "ledger.edit", "label": "ledger.perm.edit" },
    { "id": "ledger.types", "label": "ledger.perm.types" },
    { "id": "ledger.reconcile", "label": "ledger.perm.reconcile" }
  ],
  "routes": {
    "pages": [
