  "jobs": [],
  "menu": [
    {
      "group": "core.menu.group.finance",
      "num": 10,
      "path": "/accounts",
      "title": "ledger.menu.accounts"
    },
    {
      "group": "core.menu.group.finance",
      "num": 20,
      "path": "/account-move-types",
      "title": "ledger.menu.move_types"
    },
    {
      "group": "core.menu.group.finance",
      "num": 30,
      "path": "/ledger/moves",
      "title": "ledger.menu.moves"
    }
  ],
  "configSchema": {},
  "tables": [
    "base_accounts",
    "base_account_move_types",
    "base_account_moves",
    "base_account_reconciliations"
  ],
  "migrators": [],
  "hooks": {
    "subscribe": [],
    "publish": [
      "ledger.moves.from_payment",
      "ledger bulk actions via BulkActions"
    ]
  }
}
