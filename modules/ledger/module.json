{
    "id": "ledger",
    "name": "ledger.module.name",
    "version": "1.0.8",
    "type": "product",
    "description": "ledger.module.description",
    "catalog": {
        "categories": [
            "finance"
        ],
        "maturity": "release",
        "tags": [
            "journal",
            "payments"
        ],
        "screenshots": []
    },
    "requires": {
        "core": ">=1.0.0"
    },
    "optionalRequires": {
        "payments": ">=1.0.0",
        "suppliers": ">=1.0.0",
        "stickers": ">=1.0.0",
        "funds": ">=1.0.0",
        "banks": ">=0.1.0",
        "assistant": ">=1.0.0"
    },
    "provides": [
        "ledger.accounts",
        "ledger.moves",
        "ledger.from_payment"
    ],
    "migrations": "migrations/",
    "uninstall": {
        "strategy": "leave_tables"
    },
    "permissions": [
        {
            "id": "ledger.view",
            "label": "ledger.perm.view"
        },
        {
            "id": "ledger.edit",
            "label": "ledger.perm.edit"
        },
        {
            "id": "ledger.types",
            "label": "ledger.perm.types"
        },
        {
            "id": "ledger.reconcile",
            "label": "ledger.perm.reconcile"
        },
        {
            "id": "ledger.delete",
            "label": "ledger.perm.delete"
        },
        {
            "id": "ledger.types.delete",
            "label": "ledger.perm.types_delete"
        }
    ],
    "routes": {
        "pages": [
            "/accounts",
            "/accounts/new",
            "/accounts/{id}/edit",
            "/account-move-types",
            "/account-move-types/new",
            "/account-move-types/{id}/edit",
            "/ledger/moves",
            "/ledger/moves/new",
            "/ledger/moves/attach-act",
            "/ledger/moves/{id}/edit",
            "/ledger/transfers/new",
            "/ledger/transfers/{id}/edit"
        ]
    },
    "agent": {
        "docs": "docs/agents/ledger.md",
        "ops": [
            {
                "id": "ledger.accounts.list",
                "method": "GET",
                "path": "/accounts",
                "permission": "ledger.view",
                "description": "List company accounts; filter q"
            },
            {
                "id": "ledger.accounts.get",
                "method": "GET",
                "path": "/accounts/{id}/edit",
                "permission": "ledger.edit",
                "description": "Get one account (edit form payload)"
            },
            {
                "id": "ledger.accounts.save",
                "method": "POST",
                "path": "/accounts/new",
                "permission": "ledger.edit",
                "description": "Create account; also POST /accounts/{id}/edit to update"
            },
            {
                "id": "ledger.types.list",
                "method": "GET",
                "path": "/account-move-types",
                "permission": "ledger.types",
                "description": "List account move types; filter q"
            },
            {
                "id": "ledger.types.get",
                "method": "GET",
                "path": "/account-move-types/{id}/edit",
                "permission": "ledger.types",
                "description": "Get one move type"
            },
            {
                "id": "ledger.types.save",
                "method": "POST",
                "path": "/account-move-types/new",
                "permission": "ledger.types",
                "description": "Create move type; also POST /account-move-types/{id}/edit"
            },
            {
                "id": "ledger.moves.list",
                "method": "GET",
                "path": "/ledger/moves",
                "permission": "ledger.view",
                "description": "List account moves (newest first). Use q to search purpose/descr (e.g. курица). Also: account_id, type_id, year, month, supplier_id."
            },
            {
                "id": "ledger.moves.recon",
                "method": "POST",
                "path": "/ledger/moves",
                "permission": "ledger.reconcile",
                "description": "Bank recon: recon_action=save|update|delete|disable + recon_account_id; bank_balance / recon_id / reason as needed"
            },
            {
                "id": "ledger.moves.get",
                "method": "GET",
                "path": "/ledger/moves/{id}/edit",
                "permission": "ledger.edit",
                "description": "Get one move (+ type flags when type_id set on new)"
            },
            {
                "id": "ledger.moves.save",
                "method": "POST",
                "path": "/ledger/moves/new",
                "permission": "ledger.edit",
                "description": "Create account move (ДПС). Call when account_id, type_id, summ are known; UI will ask user to Confirm. Update via POST /ledger/moves/{id}/edit.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "account_id": {
                            "type": "integer",
                            "description": "base_accounts.ID"
                        },
                        "type_id": {
                            "type": "integer",
                            "description": "base_account_move_types.ID"
                        },
                        "summ": {
                            "type": "string",
                            "description": "Amount, e.g. 481"
                        },
                        "descr": {
                            "type": "string",
                            "description": "Purpose / comment"
                        },
                        "supplier_id": {
                            "type": "integer",
                            "description": "base_suppliers.ID when type allows suppliers"
                        },
                        "direction": {
                            "type": "integer",
                            "description": "-1 expense, 1 income; usually from type"
                        },
                        "dt": {
                            "type": "string",
                            "description": "Optional datetime; default now"
                        }
                    },
                    "required": [
                        "account_id",
                        "type_id",
                        "summ"
                    ]
                }
            },
            {
                "id": "ledger.moves.copy",
                "method": "POST",
                "path": "/ledger/moves/{id}/edit",
                "permission": "ledger.edit",
                "description": "Copy move as new draft dated now; form action=copy; descr gets (copy) mark; returns new id"
            },
            {
                "id": "ledger.moves.delete",
                "method": "POST",
                "path": "/ledger/moves/{id}/edit",
                "permission": "ledger.delete",
                "description": "Soft-delete move; POST action=delete",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "integer",
                            "description": "base_account_moves.ID to delete"
                        }
                    },
                    "required": [
                        "id"
                    ]
                },
                "side_effect": "write"
            },
            {
                "id": "ledger.moves.transfer",
                "method": "POST",
                "path": "/ledger/transfers/new",
                "permission": "ledger.edit",
                "description": "Create paired transfer; also POST /ledger/transfers/{id}/edit to update both legs"
            },
            {
                "id": "ledger.moves.transfer.get",
                "method": "GET",
                "path": "/ledger/transfers/{id}/edit",
                "permission": "ledger.edit",
                "description": "Get paired transfer by either leg id; linked moves must use this form, not /ledger/moves/{id}/edit"
            },
            {
                "id": "ledger.moves.attach_act.options",
                "method": "GET",
                "path": "/ledger/moves/attach-act",
                "permission": "ledger.edit",
                "description": "List recent receipt acts for attach; query id= or ids="
            },
            {
                "id": "ledger.moves.attach_act",
                "method": "POST",
                "path": "/ledger/moves/attach-act",
                "permission": "ledger.edit",
                "description": "Attach receipt act (stickers); form ids=…&act2_in=…"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.finance",
            "num": 10,
            "path": "/accounts",
            "title": "ledger.menu.accounts"
        },
        {
            "group": "core.menu.group.finance",
            "num": 20,
            "path": "/account-move-types",
            "title": "ledger.menu.move_types"
        },
        {
            "group": "core.menu.group.finance",
            "num": 30,
            "path": "/ledger/moves",
            "title": "ledger.menu.moves"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_accounts",
        "base_account_move_types",
        "base_account_moves",
        "base_account_reconciliations"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "core.notices.collect",
            "assistant.write.preview"
        ],
        "publish": [
            "ledger.accounts.badges",
            "ledger.moves.badges",
            "ledger.moves.list.toolbar",
            "ledger.moves.edit.sections",
            "ledger.moves.deleted"
        ]
    },
    "bulkActions": [
        {
            "list_id": "ledger_accounts",
            "action": "delete"
        },
        {
            "list_id": "ledger_types",
            "action": "delete"
        },
        {
            "list_id": "ledger_moves",
            "action": "set_type"
        },
        {
            "list_id": "ledger_moves",
            "action": "set_supplier"
        },
        {
            "list_id": "ledger_moves",
            "action": "confirm"
        },
        {
            "list_id": "ledger_moves",
            "action": "unconfirm"
        },
        {
            "list_id": "ledger_moves",
            "action": "soft_delete"
        },
        {
            "list_id": "ledger_moves",
            "action": "copy_enter"
        }
    ],
    "setup": {
        "steps": [
            {
                "id": "config",
                "title": "ledger.setup.step.config",
                "description": "ledger.setup.step.config_help",
                "href": "/ledger/settings",
                "ask_user": "ledger.setup.ask.config",
                "choices": [
                    {
                        "id": "open",
                        "label": "ledger.setup.choice.open",
                        "recommended": true
                    },
                    {
                        "id": "defer",
                        "label": "core.modules.setup.choice.defer",
                        "recommended": false
                    }
                ],
                "agent_can": []
            }
        ]
    }
}
