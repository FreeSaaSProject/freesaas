{
    "id": "audio",
    "name": "audio.module.name",
    "description": "audio.module.description",
    "version": "1.1.0",
    "type": "product",
    "requires": {
        "core": ">=1.0.0"
    },
    "optionalRequires": {
        "workweeks": ">=1.0.0",
        "video": ">=0.5.0",
        "clients": ">=1.0.0",
        "audio_dicts": ">=1.0.0",
        "audio_pipeline": ">=1.0.0",
        "audio_diarize": ">=0.1.0",
        "audio_llm": ">=0.1.0",
        "audio_reports": ">=1.0.0",
        "bots": ">=1.0.0",
        "bi": ">=1.0.0"
    },
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "audio.view",
            "label": "audio.perm.view"
        },
        {
            "id": "audio.edit",
            "label": "audio.perm.edit"
        },
        {
            "id": "audio.badges",
            "label": "audio.perm.badges"
        },
        {
            "id": "audio.delete",
            "label": "audio.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/agent/audio/video-effects",
            "/audio",
            "/audio/ingest",
            "/audio/{id}",
            "/audio/badges",
            "/audio/assignments",
            "/audio/assignments/new",
            "/audio/assignments/{id}/edit",
            "/audio/settings",
            "/audio/play",
            "/audio/api/dict",
            "/audio/api/blocks",
            "/audio/api/badge",
            "/audio/reviews/mark",
            "/audio/transcripts"
        ]
    },
    "agent": {
        "docs": "docs/agents/audio.md",
        "ops": [
            {
                "id": "audio.list",
                "method": "GET",
                "path": "/audio",
                "permission": "audio.view",
                "description": "List audio records (metadata, no transcripts); filters: date=YYYY-MM-DD or year/month/day, q, search, admin, badge, unassigned, review=pending|marked, disabled, score. For reading transcripts use audio.transcripts.batch (one call for many records) instead of audio.get per id. Soft audio_diarize{enabled,bulk_op,shift_profiles} when day filter set",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "date": {
                            "type": "string",
                            "description": "Calendar day YYYY-MM-DD; alias of year/month/day"
                        },
                        "year": {
                            "type": "integer"
                        },
                        "month": {
                            "type": "integer"
                        },
                        "day": {
                            "type": "integer",
                            "description": "Day of month; 0 = whole month"
                        },
                        "q": {
                            "type": "string",
                            "description": "Filename or record id / badge match"
                        },
                        "search": {
                            "type": "string",
                            "description": "Substring in transcription"
                        },
                        "admin": {
                            "type": "integer",
                            "description": "Employee user id (ID_ADMIN)"
                        },
                        "unassigned": {
                            "type": "integer",
                            "description": "1 = records without employee"
                        },
                        "badge": {
                            "type": "integer",
                            "description": "Badge id (ID_DICTOPHONE)"
                        },
                        "review": {
                            "type": "string",
                            "enum": ["pending", "marked", "favorites"],
                            "description": "Review queue filter; pending = unreviewed"
                        },
                        "disabled": {
                            "type": "integer",
                            "description": "0 = all, 1 = active only, 2 = disabled only"
                        },
                        "score": {
                            "type": "integer"
                        },
                        "page": {
                            "type": "integer"
                        }
                    }
                }
            },
            {
                "id": "audio.get",
                "method": "GET",
                "path": "/audio/{id}",
                "permission": "audio.view",
                "description": "One record; include_transcription=1 adds the trash-filtered transcript (for many records at once use audio.transcripts.batch); POST action=toggle_disabled (audio.edit). Soft audio_diarize: speakers[] + audio_diarize{enabled,can_run_diarize}; enrollment ASR-DIA via op audio_diarize.diarize.longjob (ids_csv, asr_model=reuse, apply_transcription=0)",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "include_transcription": {
                            "type": "integer",
                            "description": "1 = include cleaned transcription"
                        }
                    }
                }
            },
            {
                "id": "audio.badges.list",
                "method": "GET",
                "path": "/audio/badges",
                "permission": "audio.badges",
                "description": "List dictophone badges"
            },
            {
                "id": "audio.badges.write",
                "method": "POST",
                "path": "/audio/badges",
                "permission": "audio.badges",
                "description": "Badge admin: action=sync or action=save with id, name, enabled"
            },
            {
                "id": "audio.assignments.list",
                "method": "GET",
                "path": "/audio/assignments",
                "permission": "audio.badges",
                "description": "List badge shift assignments; filters: q, operator_id, badge, active"
            },
            {
                "id": "audio.assignments.get_new",
                "method": "GET",
                "path": "/audio/assignments/new",
                "permission": "audio.badges",
                "description": "Blank badge assignment form payload"
            },
            {
                "id": "audio.assignments.get",
                "method": "GET",
                "path": "/audio/assignments/{id}/edit",
                "permission": "audio.badges",
                "description": "One badge assignment edit payload"
            },
            {
                "id": "audio.assignments.create",
                "method": "POST",
                "path": "/audio/assignments/new",
                "permission": "audio.badges",
                "description": "Create badge assignment from form fields"
            },
            {
                "id": "audio.assignments.update",
                "method": "POST",
                "path": "/audio/assignments/{id}/edit",
                "permission": "audio.badges",
                "description": "Update or delete (action=delete) badge assignment"
            },
            {
                "id": "audio.settings.get",
                "method": "GET",
                "path": "/audio/settings",
                "permission": "audio.view",
                "description": "Audio storage settings without FTP password (SUPERADMIN_ACCESS capability on route)"
            },
            {
                "id": "audio.settings.save",
                "method": "POST",
                "path": "/audio/settings",
                "permission": "audio.view",
                "description": "Save audio storage paths and FTP host/user (password stays in ini)"
            },
            {
                "id": "audio.api.blocks",
                "method": "GET",
                "path": "/audio/api/blocks",
                "permission": "audio.view",
                "assistant": false,
                "description": "Lazy transcript HTML blocks for record ids (ids= comma-separated)"
            },
            {
                "id": "audio.api.dict",
                "method": "POST",
                "path": "/audio/api/dict",
                "permission": "audio.edit",
                "assistant": false,
                "description": "List UX: action=add_key|add_trash with text (+ optional dict_id, replace_text for the correct same-dict key; response replace.suggest is a fast hint, never auto-applied); action=set_replace with key_id + replace_text (empty clears)"
            },
            {
                "id": "audio.api.badge",
                "method": "POST",
                "path": "/audio/api/badge",
                "assistant": false,
                "description": "Save current user badge selection (badge_id); session auth"
            },
            {
                "id": "audio.reviews.mark",
                "method": "POST",
                "path": "/audio/reviews/mark",
                "permission": "audio.edit",
                "side_effect": "write",
                "description": "Mark pending review-queue (moderation) records as reviewed. Pass ids, or date (Y-m-d) with optional admin to mark every pending record of that day; ids+date marks only those ids from that day. Find pending records via audio.list review=pending.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "ids": {
                            "type": "array",
                            "items": {
                                "type": "integer"
                            },
                            "description": "Record ids to mark reviewed (only still-pending ones are touched)"
                        },
                        "date": {
                            "type": "string",
                            "description": "Calendar day Y-m-d of DT_RECORDED"
                        },
                        "admin": {
                            "type": "integer",
                            "description": "Employee user id (ID_ADMIN); omit for all employees that day"
                        }
                    },
                    "additionalProperties": false
                }
            },
            {
                "id": "audio.transcripts.batch",
                "method": "GET",
                "path": "/audio/transcripts",
                "permission": "audio.view",
                "side_effect": "read",
                "description": "Batch cleaned transcripts (timecodes [m:ss.s->m:ss.s] relative to dt_recorded) for many records in one call. Select by ids (max 200) or by date (+ time_from/time_to HH:MM, admin, badge, review=pending|marked, disabled, search). Add context_before=N to include up to N preceding records of the same admin (or badge when unassigned) on the same day, flagged context=true. Output is capped by max_bytes; when next_offset is not null, call again with offset=next_offset. Prefer this over repeated audio.get.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "ids": {
                            "type": "array",
                            "items": {
                                "type": "integer"
                            },
                            "description": "Record ids (max 200); a comma-separated string is also accepted. When set, other filters are ignored"
                        },
                        "date": {
                            "type": "string",
                            "description": "Calendar day YYYY-MM-DD (DT_RECORDED)"
                        },
                        "time_from": {
                            "type": "string",
                            "description": "HH:MM, inclusive; needs date"
                        },
                        "time_to": {
                            "type": "string",
                            "description": "HH:MM, inclusive; needs date"
                        },
                        "admin": {
                            "type": "integer",
                            "description": "Employee user id (ID_ADMIN)"
                        },
                        "unassigned": {
                            "type": "integer",
                            "description": "1 = records without employee"
                        },
                        "badge": {
                            "type": "integer",
                            "description": "Badge id (ID_DICTOPHONE)"
                        },
                        "review": {
                            "type": "string",
                            "enum": ["pending", "marked"],
                            "description": "pending = in review queue; marked = any review row"
                        },
                        "disabled": {
                            "type": "integer",
                            "description": "0 = all (default), 1 = active only, 2 = disabled only"
                        },
                        "search": {
                            "type": "string",
                            "description": "Substring in transcription"
                        },
                        "context_before": {
                            "type": "integer",
                            "description": "0..5: include N preceding records of the same admin/badge on the same day (default 0)"
                        },
                        "limit": {
                            "type": "integer",
                            "description": "Selected records per call, 1..100 (default 30)"
                        },
                        "offset": {
                            "type": "integer",
                            "description": "Offset into the selection (use next_offset from the previous response)"
                        },
                        "max_bytes": {
                            "type": "integer",
                            "description": "Response byte budget, 10000..90000 (default 70000)"
                        }
                    }
                }
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "audio.menu.group",
            "num": 1,
            "path": "/audio",
            "icon": "🎙️",
            "title": "audio.menu.list"
        },
        {
            "group": "audio.menu.group",
            "kind": "crud",
            "num": 1,
            "path": "/audio/badges",
            "icon": "🏷️",
            "title": "audio.menu.badges"
        },
        {
            "group": "audio.menu.group",
            "kind": "crud",
            "num": 2,
            "path": "/audio/assignments",
            "icon": "📌",
            "title": "audio.menu.assignments"
        },
        {
            "group": "audio.menu.group",
            "kind": "settings",
            "num": 999,
            "path": "/audio/settings",
            "icon": "⚙️",
            "title": "audio.menu.settings",
            "permission": "audio.view",
            "capability": "SUPERADMIN_ACCESS"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_records",
        "base_records_badges",
        "base_badge_assignments",
        "base_records_balances",
        "base_records_reviews",
        "base_audio_video_effects"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "core.user_edit.sections",
            "core.user_edit.save",
            "core.user_edit.profile",
            "core.layout.gate",
            "core.auth.before_logout",
            "core.notices.collect",
            "bi.datasets",
            "backups.sources",
            "video.alert.created",
            "video.appeal.decided",
            "video.consequences.collect"
        ],
        "publish": [
            "audio.settings.sections",
            "audio.settings.save"
        ]
    },
    "bulkActions": [
        {
            "list_id": "audio_records",
            "action": "set_admin"
        },
        {
            "list_id": "audio_records",
            "action": "disable"
        },
        {
            "list_id": "audio_records",
            "action": "enable"
        },
        {
            "list_id": "audio_records",
            "action": "clear_text"
        },
        {
            "list_id": "audio_records",
            "action": "clear_text_keep_rid"
        },
        {
            "list_id": "audio_records",
            "action": "review"
        },
        {
            "list_id": "audio_records",
            "action": "favorite_add"
        },
        {
            "list_id": "audio_records",
            "action": "favorite_remove"
        },
        {
            "list_id": "audio_records",
            "action": "reset_admin"
        },
        {
            "list_id": "audio_records",
            "action": "reset_keys"
        },
        {
            "list_id": "audio_records",
            "action": "reset_offers"
        },
        {
            "list_id": "audio_records",
            "action": "reset_strings"
        },
        {
            "list_id": "audio_records",
            "action": "delete"
        },
        {
            "list_id": "audio_records",
            "action": "delete_with_files"
        }
    ],
    "catalog": {
        "categories": [
            "audio"
        ],
        "maturity": "release",
        "tags": [],
        "screenshots": []
    },
    "setup": {
        "steps": [
            {
                "id": "config",
                "title": "audio.setup.step.config",
                "description": "audio.setup.step.config_help",
                "href": "/audio/settings",
                "ask_user": "audio.setup.ask.config",
                "choices": [
                    {
                        "id": "open",
                        "label": "audio.setup.choice.open",
                        "recommended": true
                    },
                    {
                        "id": "defer",
                        "label": "core.modules.setup.choice.defer",
                        "recommended": false
                    }
                ],
                "agent_can": []
            }
        ]
    }
}
