{
    "id": "audio",
    "name": "audio.module.name",
    "description": "audio.module.description",
    "version": "1.0.6",
    "type": "product",
    "requires": {
        "core": ">=1.0.0"
    },
    "optionalRequires": {
        "workweeks": ">=1.0.0",
        "clients": ">=1.0.0",
        "audio_dicts": ">=1.0.0",
        "audio_pipeline": ">=1.0.0",
        "audio_llm": ">=0.1.0",
        "audio_reports": ">=1.0.0",
        "bots": ">=1.0.0",
        "bi": ">=1.0.0"
    },
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "audio.view",
            "label": "audio.perm.view"
        },
        {
            "id": "audio.edit",
            "label": "audio.perm.edit"
        },
        {
            "id": "audio.badges",
            "label": "audio.perm.badges"
        },
        {
            "id": "audio.delete",
            "label": "audio.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/audio",
            "/audio/ingest",
            "/audio/{id}",
            "/audio/badges",
            "/audio/assignments",
            "/audio/assignments/new",
            "/audio/assignments/{id}/edit",
            "/audio/settings",
            "/audio/play",
            "/audio/api/dict",
            "/audio/api/blocks",
            "/audio/api/badge"
        ]
    },
    "agent": {
        "docs": "docs/agents/audio.md",
        "ops": [
            {
                "id": "audio.list",
                "method": "GET",
                "path": "/audio",
                "permission": "audio.view",
                "description": "List audio records; filters: q, search, year, month, day, admin, badge, review, disabled, score"
            },
            {
                "id": "audio.get",
                "method": "GET",
                "path": "/audio/{id}",
                "permission": "audio.view",
                "description": "One record; include_transcription=1 for full text; POST action=toggle_disabled (audio.edit)"
            },
            {
                "id": "audio.badges.list",
                "method": "GET",
                "path": "/audio/badges",
                "permission": "audio.badges",
                "description": "List dictophone badges"
            },
            {
                "id": "audio.badges.write",
                "method": "POST",
                "path": "/audio/badges",
                "permission": "audio.badges",
                "description": "Badge admin: action=sync or action=save with id, name, enabled"
            },
            {
                "id": "audio.assignments.list",
                "method": "GET",
                "path": "/audio/assignments",
                "permission": "audio.badges",
                "description": "List badge shift assignments; filters: q, operator_id, badge, active"
            },
            {
                "id": "audio.assignments.get_new",
                "method": "GET",
                "path": "/audio/assignments/new",
                "permission": "audio.badges",
                "description": "Blank badge assignment form payload"
            },
            {
                "id": "audio.assignments.get",
                "method": "GET",
                "path": "/audio/assignments/{id}/edit",
                "permission": "audio.badges",
                "description": "One badge assignment edit payload"
            },
            {
                "id": "audio.assignments.create",
                "method": "POST",
                "path": "/audio/assignments/new",
                "permission": "audio.badges",
                "description": "Create badge assignment from form fields"
            },
            {
                "id": "audio.assignments.update",
                "method": "POST",
                "path": "/audio/assignments/{id}/edit",
                "permission": "audio.badges",
                "description": "Update or delete (action=delete) badge assignment"
            },
            {
                "id": "audio.settings.get",
                "method": "GET",
                "path": "/audio/settings",
                "permission": "audio.view",
                "description": "Audio storage settings without FTP password (SUPERADMIN_ACCESS capability on route)"
            },
            {
                "id": "audio.settings.save",
                "method": "POST",
                "path": "/audio/settings",
                "permission": "audio.view",
                "description": "Save audio storage paths and FTP host/user (password stays in ini)"
            },
            {
                "id": "audio.api.blocks",
                "method": "GET",
                "path": "/audio/api/blocks",
                "permission": "audio.view",
                "assistant": false,
                "description": "Lazy transcript HTML blocks for record ids (ids= comma-separated)"
            },
            {
                "id": "audio.api.dict",
                "method": "POST",
                "path": "/audio/api/dict",
                "permission": "audio.edit",
                "assistant": false,
                "description": "List UX: action=add_key|add_trash with text (+ optional dict_id)"
            },
            {
                "id": "audio.api.badge",
                "method": "POST",
                "path": "/audio/api/badge",
                "assistant": false,
                "description": "Save current user badge selection (badge_id); session auth"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "audio.menu.group",
            "num": 1,
            "path": "/audio",
            "title": "audio.menu.list"
        },
        {
            "group": "audio.menu.group",
            "kind": "crud",
            "num": 1,
            "path": "/audio/badges",
            "title": "audio.menu.badges"
        },
        {
            "group": "audio.menu.group",
            "kind": "crud",
            "num": 2,
            "path": "/audio/assignments",
            "title": "audio.menu.assignments"
        },
        {
            "group": "audio.menu.group",
            "kind": "settings",
            "num": 999,
            "path": "/audio/settings",
            "title": "audio.menu.settings",
            "permission": "audio.view",
            "capability": "SUPERADMIN_ACCESS"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_records",
        "base_records_badges",
        "base_badge_assignments",
        "base_records_balances",
        "base_records_reviews"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "core.user_edit.sections",
            "core.user_edit.save",
            "core.user_edit.profile",
            "core.layout.gate",
            "core.auth.before_logout",
            "core.notices.collect",
            "bi.datasets"
        ],
        "publish": [
            "audio.settings.sections",
            "audio.settings.save"
        ]
    },
    "bulkActions": [
        {
            "list_id": "audio_records",
            "action": "set_admin"
        },
        {
            "list_id": "audio_records",
            "action": "disable"
        },
        {
            "list_id": "audio_records",
            "action": "enable"
        },
        {
            "list_id": "audio_records",
            "action": "clear_text"
        },
        {
            "list_id": "audio_records",
            "action": "clear_text_keep_rid"
        },
        {
            "list_id": "audio_records",
            "action": "review"
        },
        {
            "list_id": "audio_records",
            "action": "favorite_add"
        },
        {
            "list_id": "audio_records",
            "action": "favorite_remove"
        },
        {
            "list_id": "audio_records",
            "action": "reset_admin"
        },
        {
            "list_id": "audio_records",
            "action": "reset_keys"
        },
        {
            "list_id": "audio_records",
            "action": "reset_offers"
        },
        {
            "list_id": "audio_records",
            "action": "reset_strings"
        },
        {
            "list_id": "audio_records",
            "action": "delete"
        },
        {
            "list_id": "audio_records",
            "action": "delete_with_files"
        }
    ],
    "catalog": {
        "categories": [
            "audio"
        ],
        "maturity": "release",
        "tags": [],
        "screenshots": []
    }
}
