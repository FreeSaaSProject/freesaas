{
    "id": "asr",
    "name": "asr.module.name",
    "description": "asr.module.description",
    "version": "1.0.2",
    "type": "product",
    "requires": {
        "core": ">=1.0.0"
    },
    "optionalRequires": {
        "bots": ">=1.0.0"
    },
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "asr.view",
            "label": "asr.perm.view"
        }
    ],
    "routes": {
        "pages": [
            "/asr/voice-transcribe/worker",
            "/asr/voice-transcribe/file",
            "/audio/voice-transcribe/worker",
            "/audio/voice-transcribe/file"
        ]
    },
    "agent": {
        "docs": "docs/agents/asr.md",
        "ops": [
            {
                "id": "asr.voice.worker",
                "method": "GET",
                "path": "/asr/voice-transcribe/worker",
                "permission": "asr.view",
                "assistant": false,
                "description": "Whisper voice-queue worker next/submit (X-Audio-Token)"
            }
        ]
    },
    "jobs": [],
    "menu": [],
    "configSchema": [],
    "tables": [],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "bots.ready"
        ],
        "publish": [
            "asr.voice.enqueued",
            "bots.voice.transcription_result"
        ],
        "contracts": {
            "asr.voice.enqueued": "{job_id, platform} after a voice job lands in pending (push channels kick dispatch)",
            "bots.voice.transcription_result": "{job, text (plain), text_raw (whisper [mm:ss->mm:ss] lines), playtime, audio_path, error, handled, audio_taken}; set handled to skip the default chat reply, audio_taken when you moved audio_path away"
        }
    },
    "catalog": {
        "categories": [
            "audio"
        ],
        "maturity": "release",
        "tags": [
            "integration",
            "jobs"
        ],
        "screenshots": []
    },
    "setup": {
        "steps": [
            {
                "id": "config",
                "title": "asr.setup.step.config",
                "description": "asr.setup.step.config_help",
                "href": "/asr/settings",
                "ask_user": "asr.setup.ask.config",
                "choices": [
                    {
                        "id": "open",
                        "label": "asr.setup.choice.open",
                        "recommended": true
                    },
                    {
                        "id": "defer",
                        "label": "core.modules.setup.choice.defer",
                        "recommended": false
                    }
                ],
                "agent_can": []
            }
        ]
    }
}
