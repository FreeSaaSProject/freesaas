{
    "id": "funds",
    "name": "funds.module.name",
    "description": "funds.module.description",
    "version": "1.1.0",
    "type": "product",
    "catalog": {
        "categories": [
            "finance"
        ],
        "maturity": "release",
        "tags": [
            "journal"
        ],
        "screenshots": []
    },
    "requires": {
        "core": ">=1.0.0",
        "ledger": ">=1.0.0"
    },
    "optionalRequires": [],
    "provides": [
        "funds.list"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "funds.view",
            "label": "funds.perm.view"
        },
        {
            "id": "funds.edit",
            "label": "funds.perm.edit"
        },
        {
            "id": "funds.delete",
            "label": "funds.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/funds",
            "/funds/new",
            "/funds/{id}",
            "/funds/{id}/edit",
            "/fund-movements",
            "/fund-movements/new",
            "/fund-movements/{id}/edit"
        ]
    },
    "agent": {
        "docs": "docs/agents/funds.md",
        "ops": [
            {
                "id": "funds.list",
                "method": "GET",
                "path": "/funds",
                "permission": "funds.view",
                "description": "List funds; filter: q. Returns items (flat), tree (groups with children and balances) and leaf_options (selectable funds grouped by parent)."
            },
            {
                "id": "funds.get",
                "method": "GET",
                "path": "/funds/{id}",
                "permission": "funds.view",
                "description": "Fund card: fund, parent, children (for groups), balance, movements with linked account moves (dps[], dps_sum, mismatch), totals"
            },
            {
                "id": "funds.accrual",
                "method": "POST",
                "path": "/funds",
                "permission": "funds.edit",
                "description": "Fund accrual tools: funds_action=calculate|reprice"
            },
            {
                "id": "funds.get_edit",
                "method": "GET",
                "path": "/funds/{id}/edit",
                "permission": "funds.edit",
                "description": "Fund edit payload; new record at /funds/new"
            },
            {
                "id": "funds.create",
                "method": "POST",
                "path": "/funds/new",
                "permission": "funds.edit",
                "description": "Create fund"
            },
            {
                "id": "funds.update",
                "method": "POST",
                "path": "/funds/{id}/edit",
                "permission": "funds.edit",
                "description": "Update fund"
            },
            {
                "id": "funds.movements.list",
                "method": "GET",
                "path": "/fund-movements",
                "permission": "funds.view",
                "description": "List fund movements; filters: q, fund_id (a group id includes its children), type_id, fund_type, year, month, yearE, monthE. Items include dps[] (linked account moves), dps_sum, mismatch."
            },
            {
                "id": "funds.movements.get_edit",
                "method": "GET",
                "path": "/fund-movements/{id}/edit",
                "permission": "funds.edit",
                "description": "Fund movement edit payload with linked account moves; new at /fund-movements/new (fund_id= to preselect, dps= to prefill from an account move)"
            },
            {
                "id": "funds.movements.create",
                "method": "POST",
                "path": "/fund-movements/new",
                "permission": "funds.edit",
                "description": "Create fund movement. fund_id must be a leaf fund (groups are rejected). Pass dps=<account move id> to also link that account move (see funds.movements.from_dps).",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "fund_id": {
                            "type": "integer",
                            "description": "base_funds.ID of a leaf fund (not a group)"
                        },
                        "type_id": {
                            "type": "integer",
                            "description": "1 CAPUSE, 2 REFUND, 3 REVAL, 4 DEVAL, 5 DESTROY"
                        },
                        "summ": {
                            "type": "string",
                            "description": "Amount > 0"
                        },
                        "summ_out_cap": {
                            "type": "string",
                            "description": "Source: shareholder capital (CAPUSE)"
                        },
                        "summ_out_fund": {
                            "type": "string",
                            "description": "Source: accumulated fund (CAPUSE)"
                        },
                        "summ_out_infl": {
                            "type": "string",
                            "description": "Source: revaluation (REVAL defaults to summ)"
                        },
                        "summ_out_destroy": {
                            "type": "string",
                            "description": "Liquidation amount (DESTROY defaults to summ)"
                        },
                        "dt_amort_start": {
                            "type": "string",
                            "description": "Posting date / amortization start (datetime or unix ts); default now"
                        },
                        "amort_months": {
                            "type": "integer",
                            "description": "Amortization months"
                        },
                        "name": {
                            "type": "string",
                            "description": "Short name"
                        },
                        "descr": {
                            "type": "string",
                            "description": "Description"
                        },
                        "dps": {
                            "type": "integer",
                            "description": "Optional base_account_moves.ID to link after create"
                        }
                    },
                    "required": [
                        "fund_id",
                        "type_id",
                        "summ"
                    ]
                }
            },
            {
                "id": "funds.movements.from_dps",
                "method": "GET",
                "path": "/fund-movements/new",
                "permission": "funds.edit",
                "description": "Prefill a fund movement from an account move: query dps=<id> (optional fund_id=). Returns item prefill and fund_options; then POST /fund-movements/new with the same dps= and fund_id to create and link. Errors if the move type is not fund-linked or the move is already linked."
            },
            {
                "id": "funds.movements.update",
                "method": "POST",
                "path": "/fund-movements/{id}/edit",
                "permission": "funds.edit",
                "description": "Update fund movement (full form: fund_id, type_id, summ, sources, dates, name, descr)"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.finance",
            "num": 40,
            "path": "/funds",
            "title": "funds.menu.list"
        },
        {
            "group": "core.menu.group.finance",
            "num": 50,
            "path": "/fund-movements",
            "title": "funds.menu.movements"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_funds",
        "base_fund_movements"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "ledger.types.meta",
            "ledger.moves.form.fields",
            "ledger.moves.validate",
            "ledger.moves.edit.sections",
            "ledger.moves.badges"
        ],
        "publish": []
    },
    "setup": {
        "steps": [
            {
                "id": "ready",
                "title": "funds.setup.step.ready",
                "description": "funds.setup.step.ready_help",
                "href": "/funds",
                "ask_user": "funds.setup.ask.ready",
                "choices": [
                    {
                        "id": "open",
                        "label": "funds.setup.choice.open",
                        "recommended": true
                    },
                    {
                        "id": "defer",
                        "label": "core.modules.setup.choice.defer",
                        "recommended": false
                    }
                ],
                "agent_can": [
                    "mark_done"
                ]
            }
        ]
    }
}
