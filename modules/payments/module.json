{
    "id": "payments",
    "name": "payments.module.name",
    "description": "payments.module.description",
    "version": "0.1.2",
    "type": "product",
    "requires": {
        "core": ">=0.3.0"
    },
    "optionalRequires": [],
    "provides": [
        "payments.list",
        "payments.types"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "payments.view",
            "label": "payments.perm.view"
        },
        {
            "id": "payments.edit",
            "label": "payments.perm.edit"
        },
        {
            "id": "payments.types",
            "label": "payments.perm.types"
        }
    ],
    "routes": {
        "pages": [
            "/payments",
            "/payments/new",
        "/payments/{id}/edit",
        "/payments/move-links/{moveId}",
        "/payment-types",
            "/payment-types/new",
            "/payment-types/{id}/edit"
        ]
    },
    "agent": {
        "ops": [
            {
                "id": "payments.list",
                "method": "GET",
                "path": "/payments",
                "permission": "payments.view",
                "description": "List staff payments; mode=monthly|linear, year, month, q, user_id, type_id, account, direction"
            },
            {
                "id": "payments.get_edit",
                "method": "GET",
                "path": "/payments/{id}/edit",
                "permission": "payments.edit",
                "description": "One payment for edit; id=0 path uses /payments/new"
            },
            {
                "id": "payments.create",
                "method": "POST",
                "path": "/payments/new",
                "permission": "payments.edit",
                "description": "Create payment; optional id_comment prefill query"
            },
            {
                "id": "payments.update",
                "method": "POST",
                "path": "/payments/{id}/edit",
                "permission": "payments.edit",
                "description": "Update payment or create_dps=1 when ledger enabled"
            },
            {
                "id": "payments.move_links",
                "method": "POST",
                "path": "/payments/move-links/{moveId}",
                "permission": "payments.edit",
                "description": "Multi-allocate hanging payments to a ledger move (action=link|unlink)"
            },
            {
                "id": "payments.types.list",
                "method": "GET",
                "path": "/payment-types",
                "permission": "payments.types",
                "description": "List payment types; filter: q"
            },
            {
                "id": "payments.types.get",
                "method": "GET",
                "path": "/payment-types/{id}/edit",
                "permission": "payments.types",
                "description": "One payment type; new uses /payment-types/new"
            },
            {
                "id": "payments.types.create",
                "method": "POST",
                "path": "/payment-types/new",
                "permission": "payments.types",
                "description": "Create payment type"
            },
            {
                "id": "payments.types.update",
                "method": "POST",
                "path": "/payment-types/{id}/edit",
                "permission": "payments.types",
                "description": "Update payment type"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.accounting",
            "num": 20,
            "path": "/payments",
            "title": "payments.menu.list"
        },
        {
            "group": "core.menu.group.accounting",
            "num": 21,
            "path": "/payment-types",
            "title": "payments.menu.types"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_payments",
        "base_payment_types",
        "base_payment_move_links"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "ledger.moves.edit.sections",
            "ledger.moves.deleted",
            "ledger.moves.badges"
        ],
        "publish": []
    },
    "bulkActions": [
        {
            "list_id": "payments",
            "action": "delete"
        },
        {
            "list_id": "payments",
            "action": "account0"
        },
        {
            "list_id": "payments",
            "action": "account1"
        },
        {
            "list_id": "payments",
            "action": "account2"
        },
        {
            "list_id": "payments",
            "action": "accept"
        },
        {
            "list_id": "payments",
            "action": "create_dps"
        },
        {
            "list_id": "payment_types",
            "action": "delete"
        }
    ],
    "catalog": {
        "categories": [
            "accounting"
        ],
        "maturity": "beta",
        "tags": [],
        "screenshots": []
    }
}
