{
    "id": "payments",
    "name": "payments.module.name",
    "description": "payments.module.description",
    "version": "0.1.20",
    "type": "product",
    "requires": {
        "core": ">=0.3.0"
    },
    "optionalRequires": {
        "ledger": ">=0.1.0",
        "bots": ">=0.1.0",
        "procents": ">=0.1.5",
        "procedures": ">=0.1.0",
        "contracts": ">=0.1.0",
        "assistant": ">=0.1.0"
    },
    "provides": [
        "payments.list"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "payments.view",
            "label": "payments.perm.view"
        },
        {
            "id": "payments.edit",
            "label": "payments.perm.edit"
        },
        {
            "id": "payments.delete",
            "label": "payments.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/payments",
            "/payments/settings",
            "/payments/new",
            "/payments/{id}/edit",
            "/payments/move-links/{moveId}"
        ]
    },
    "agent": {
        "docs": "docs/agents/payments.md",
        "ops": [
            {
                "id": "payments.list",
                "method": "GET",
                "path": "/payments",
                "permission": "payments.view",
                "description": "List staff payments; mode=monthly|linear, year, month, q, user_id, account, direction. JSON includes totals.accrued / totals.issued (payroll FOТ sums) and monthly total_in/total_out"
            },
            {
                "id": "payments.settings.get",
                "method": "GET",
                "path": "/payments/settings",
                "permission": "",
                "description": "Payroll settings: auto_procent_accrual, day_pay_*, soft contracts deadline_penalty; SUPERADMIN_ACCESS"
            },
            {
                "id": "payments.settings.update",
                "method": "POST",
                "path": "/payments/settings",
                "permission": "",
                "description": "Save payroll settings (payments.ini day_pay_* / auto_procent; contracts.ini deadline_penalty when contracts on); SUPERADMIN_ACCESS"
            },
            {
                "id": "payments.get_edit",
                "method": "GET",
                "path": "/payments/{id}/edit",
                "permission": "payments.edit",
                "description": "One payment for edit; id=0 path uses /payments/new"
            },
            {
                "id": "payments.create",
                "method": "POST",
                "path": "/payments/new",
                "permission": "payments.edit",
                "description": "Create payment; optional id_comment prefill query"
            },
            {
                "id": "payments.update",
                "method": "POST",
                "path": "/payments/{id}/edit",
                "permission": "payments.edit",
                "description": "Update payment or create_dps=1 when ledger enabled"
            },
            {
                "id": "payments.move_links",
                "method": "POST",
                "path": "/payments/move-links/{moveId}",
                "permission": "payments.edit",
                "description": "Multi-allocate hanging payments to a ledger move (action=link|unlink)"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.accounting",
            "num": 20,
            "kind": "work",
            "path": "/payments",
            "title": "payments.menu.list"
        },
        {
            "group": "core.menu.group.accounting",
            "num": 90,
            "kind": "settings",
            "path": "/payments/settings",
            "title": "payments.menu.settings"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_payments",
        "base_payment_move_links"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "ledger.moves.edit.sections",
            "ledger.moves.deleted",
            "ledger.moves.badges",
            "assistant.write.preview",
            "assistant.system.hints"
        ],
        "publish": []
    },
    "bulkActions": [
        {
            "list_id": "payments",
            "action": "delete"
        },
        {
            "list_id": "payments",
            "action": "account0"
        },
        {
            "list_id": "payments",
            "action": "account1"
        },
        {
            "list_id": "payments",
            "action": "account2"
        },
        {
            "list_id": "payments",
            "action": "accept"
        },
        {
            "list_id": "payments",
            "action": "create_dps"
        }
    ],
    "catalog": {
        "categories": [
            "accounting"
        ],
        "maturity": "beta",
        "tags": [],
        "screenshots": []
    }
}
