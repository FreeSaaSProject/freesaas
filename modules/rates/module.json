{
    "id": "rates",
    "name": "rates.module.name",
    "description": "rates.module.description",
    "version": "0.2.1",
    "type": "product",
    "runtime": "both",
    "requires": {
        "core": ">=0.3.0",
        "procedures": ">=0.1.0"
    },
    "optionalRequires": {
        "audio": ">=0.1.0"
    },
    "provides": [
        "rates.list"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "rates.view",
            "label": "rates.perm.view"
        },
        {
            "id": "rates.edit",
            "label": "rates.perm.edit"
        },
        {
            "id": "rates.delete",
            "label": "rates.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/rates",
            "/rates/new",
            "/rates/{id}/edit",
            "/rates/skill"
        ]
    },
    "agent": {
        "docs": "docs/agents/rates.md",
        "ops": [
            {
                "id": "rates.list",
                "method": "GET",
                "path": "/rates",
                "permission": "rates.view",
                "description": "List specialist commission rate profiles; filters: q, operator_id"
            },
            {
                "id": "rates.get",
                "method": "GET",
                "path": "/rates/{id}/edit",
                "permission": "rates.edit",
                "description": "Rate profile edit payload; includes staff and procedure_types dictionaries; skill bans when columns present"
            },
            {
                "id": "rates.create",
                "method": "POST",
                "path": "/rates/new",
                "permission": "rates.edit",
                "description": "Create rate profile (content % + optional ban_booking/ban_online maps)"
            },
            {
                "id": "rates.update",
                "method": "POST",
                "path": "/rates/{id}/edit",
                "permission": "rates.edit",
                "description": "Update rate profile"
            },
            {
                "id": "rates.skill.diagnose",
                "method": "GET",
                "path": "/rates/skill",
                "permission": "rates.edit",
                "description": "Why staff cannot perform a type/good: blockers[], percent, bans. Query: operator_id, type_id|good_id"
            },
            {
                "id": "rates.skill.grant",
                "method": "POST",
                "path": "/rates/skill",
                "permission": "rates.edit",
                "side_effect": "write",
                "description": "Enable skill: set % (explicit or suggest from own/peer) and clear ban_booking. dry_run=1 returns draft message only. Body: operator_id, type_id|good_id, optional percent, dry_run"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.accounting",
            "num": 10,
            "path": "/rates",
            "title": "rates.menu.list"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_procent_history"
    ],
    "migrators": [
        {
            "id": "restrict_to_bans",
            "mode": "transform",
            "source": [
                "base_users.RESTRICT_TYPES",
                "base_users.RESTRICT_TYPES_ONLINE",
                "base_users.RESTRICT_PROCS"
            ],
            "target": [
                "base_procent_history.ban_booking",
                "base_procent_history.ban_online",
                "base_procent_history.ban_procs"
            ],
            "description": "rates.migrator.restrict_to_bans"
        },
        {
            "id": "repair_bans_from_restrict_types",
            "mode": "transform",
            "source": [
                "base_users.RESTRICT_TYPES",
                "base_users.RESTRICT_TYPES_ONLINE"
            ],
            "target": [
                "base_procent_history.ban_booking",
                "base_procent_history.ban_online"
            ],
            "description": "rates.migrator.repair_bans_from_restrict_types"
        }
    ],
    "hooks": {
        "subscribe": [],
        "publish": []
    },
    "bulkActions": [
        {
            "list_id": "rates",
            "action": "delete"
        },
        {
            "list_id": "rates",
            "action": "copy"
        },
        {
            "list_id": "rates",
            "action": "zerofill"
        }
    ],
    "catalog": {
        "categories": [
            "accounting"
        ],
        "maturity": "beta",
        "tags": [],
        "screenshots": []
    }
}
