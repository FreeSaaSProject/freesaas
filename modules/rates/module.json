{
    "id": "rates",
    "name": "rates.module.name",
    "description": "rates.module.description",
    "version": "1.0.1",
    "type": "product",
    "runtime": "both",
    "requires": {
        "core": ">=1.0.0",
        "procedures": ">=1.0.0"
    },
    "optionalRequires": {
        "audio": ">=1.0.0"
    },
    "provides": [
        "rates.list"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "rates.view",
            "label": "rates.perm.view"
        },
        {
            "id": "rates.edit",
            "label": "rates.perm.edit"
        },
        {
            "id": "rates.delete",
            "label": "rates.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/rates",
            "/rates/new",
            "/rates/{id}/edit",
            "/rates/skill"
        ]
    },
    "agent": {
        "docs": "docs/agents/rates.md",
        "ops": [
            {
                "id": "rates.list",
                "method": "GET",
                "path": "/rates",
                "permission": "rates.view",
                "description": "List specialist commission rate profiles; filters: q, operator_id"
            },
            {
                "id": "rates.get",
                "method": "GET",
                "path": "/rates/{id}/edit",
                "permission": "rates.edit",
                "description": "Rate profile edit payload; includes staff and procedure_types dictionaries; skill bans when columns present"
            },
            {
                "id": "rates.create",
                "method": "POST",
                "path": "/rates/new",
                "permission": "rates.edit",
                "description": "Create rate profile (content % + optional ban_booking/ban_online maps)"
            },
            {
                "id": "rates.update",
                "method": "POST",
                "path": "/rates/{id}/edit",
                "permission": "rates.edit",
                "description": "Update rate profile"
            },
            {
                "id": "rates.skill.search",
                "method": "GET",
                "path": "/rates/skill",
                "permission": "rates.edit",
                "description": "Find procedure types + catalog products by name. Query: q=средиземноморский. Returns types[] and products[] (with type_id). Prefer product good_id when one product matches."
            },
            {
                "id": "rates.skill.diagnose",
                "method": "GET",
                "path": "/rates/skill",
                "permission": "rates.edit",
                "description": "Can staff perform a type/good: can_perform / can_perform_online + blockers[], percent, bans (booking/online/proc). Query: operator_id, type_id|good_id, date=YYYY-MM-DD (rates as of that day; default today — pass the event day). Use before reassigning a client event to another staff member"
            },
            {
                "id": "rates.skill.grant",
                "method": "POST",
                "path": "/rates/skill",
                "permission": "rates.edit",
                "side_effect": "write",
                "description": "Enable skill (галочка записи): set % (explicit or suggest from own/peer), clear ban_booking/online, clear ban_procs for good_id. Body: action=grant, operator_id, type_id|good_id, optional percent, dry_run=1"
            },
            {
                "id": "rates.skill.revoke",
                "method": "POST",
                "path": "/rates/skill",
                "permission": "rates.edit",
                "side_effect": "write",
                "description": "Disable skill: good_id → ban that product (ban_procs); type_id only → ban_booking+ban_online (keeps %). Body: action=revoke, operator_id, type_id|good_id, dry_run=1"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.accounting",
            "num": 10,
            "path": "/rates",
            "title": "rates.menu.list"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_procent_history"
    ],
    "migrators": [
        {
            "id": "restrict_to_bans",
            "mode": "transform",
            "source": [
                "base_users.RESTRICT_TYPES",
                "base_users.RESTRICT_TYPES_ONLINE",
                "base_users.RESTRICT_PROCS"
            ],
            "target": [
                "base_procent_history.ban_booking",
                "base_procent_history.ban_online",
                "base_procent_history.ban_procs"
            ],
            "description": "rates.migrator.restrict_to_bans"
        },
        {
            "id": "repair_bans_from_restrict_types",
            "mode": "transform",
            "source": [
                "base_users.RESTRICT_TYPES",
                "base_users.RESTRICT_TYPES_ONLINE"
            ],
            "target": [
                "base_procent_history.ban_booking",
                "base_procent_history.ban_online"
            ],
            "description": "rates.migrator.repair_bans_from_restrict_types"
        }
    ],
    "hooks": {
        "subscribe": [
            "assistant.write.preview",
            "assistant.system.hints"
        ],
        "publish": []
    },
    "bulkActions": [
        {
            "list_id": "rates",
            "action": "delete"
        },
        {
            "list_id": "rates",
            "action": "copy"
        },
        {
            "list_id": "rates",
            "action": "zerofill"
        }
    ],
    "catalog": {
        "categories": [
            "accounting"
        ],
        "maturity": "release",
        "tags": [],
        "screenshots": []
    },
    "setup": {
        "steps": [
            {
                "id": "ready",
                "title": "rates.setup.step.ready",
                "description": "rates.setup.step.ready_help",
                "href": "/rates",
                "ask_user": "rates.setup.ask.ready",
                "choices": [
                    {
                        "id": "open",
                        "label": "rates.setup.choice.open",
                        "recommended": true
                    },
                    {
                        "id": "defer",
                        "label": "core.modules.setup.choice.defer",
                        "recommended": false
                    }
                ],
                "agent_can": [
                    "mark_done"
                ]
            }
        ]
    }
}
