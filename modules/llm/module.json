{
  "id": "llm",
  "name": "llm.module.name",
  "version": "0.1.0",
  "type": "product",
  "requires": {
    "core": ">=0.3.0"
  },
  "optionalRequires": {},
  "provides": [
    "llm.client"
  ],
  "permissions": [
    { "id": "llm.manage", "label": "llm.perm.manage" },
    { "id": "llm.use", "label": "llm.perm.use" }
  ],
  "routes": {
    "pages": [
      "/llm/tokens",
      "/llm/tokens/new",
      "/llm/tokens/{id}",
      "/llm/chat"
    ]
  },
  "agent": {
    "ops": [
      {
        "id": "llm.tokens.list",
        "method": "GET",
        "path": "/llm/tokens",
        "permission": "llm.manage",
        "description": "List LLM API token profiles (keys masked)"
      },
      {
        "id": "llm.tokens.save",
        "method": "POST",
        "path": "/llm/tokens/new",
        "permission": "llm.manage",
        "description": "Create profile; also POST /llm/tokens/{id}"
      },
      {
        "id": "llm.chat",
        "method": "POST",
        "path": "/llm/chat",
        "permission": "llm.use",
        "assistant": false,
        "description": "OpenAI-compatible chat completion; body: messages, optional profile/model/temperature/max_tokens"
      }
    ]
  },
  "jobs": [],
  "menu": [
    {
      "group": "core.menu.group.system",
      "kind": "settings",
      "num": 40,
      "path": "/llm/tokens",
      "title": "llm.menu.tokens",
      "permission": "llm.manage",
      "capability": "SUPERADMIN_ACCESS"
    }
  ],
  "configSchema": {},
  "tables": [],
  "migrators": [],
  "hooks": {
    "subscribe": [],
    "publish": []
  }
}
