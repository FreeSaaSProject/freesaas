{
    "id": "llm",
    "name": "llm.module.name",
    "description": "llm.module.description",
    "version": "0.2.3",
    "type": "product",
    "requires": {
        "core": ">=0.3.0"
    },
    "optionalRequires": {
        "assistant": ">=0.1.0"
    },
    "provides": [
        "llm.client",
        "llm.oauth",
        "llm.mcp"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "llm.manage",
            "label": "llm.perm.manage"
        },
        {
            "id": "llm.use",
            "label": "llm.perm.use"
        }
    ],
    "routes": {
        "pages": [
            "/llm/tokens",
            "/llm/tokens/new",
            "/llm/tokens/{id}",
            "/llm/chat",
            "/llm/oauth",
            "/llm/oauth/new",
            "/llm/oauth/{id}",
            "/llm/openapi.json",
            "/llm/mcp",
            "/llm/api/tools",
            "/llm/api/tools/call",
            "/oauth/authorize",
            "/oauth/token",
            "/oauth/revoke",
            "/oauth/register",
            "/.well-known/oauth-authorization-server",
            "/.well-known/openid-configuration",
            "/.well-known/oauth-protected-resource",
            "/.well-known/oauth-protected-resource/llm/mcp",
            "/agent/llm/status",
            "/agent/llm/tokens",
            "/agent/llm/tokens/delete",
            "/agent/llm/ping"
        ]
    },
    "agent": {
        "ops": [
            {
                "id": "llm.tokens.list",
                "method": "GET",
                "path": "/llm/tokens",
                "permission": "llm.manage",
                "description": "List LLM API token profiles (keys masked)"
            },
            {
                "id": "llm.tokens.save",
                "method": "POST",
                "path": "/llm/tokens/new",
                "permission": "llm.manage",
                "description": "Create profile; also POST /llm/tokens/{id}"
            },
            {
                "id": "llm.chat",
                "method": "POST",
                "path": "/llm/chat",
                "permission": "llm.use",
                "assistant": false,
                "description": "OpenAI-compatible chat completion; body: messages, optional profile/model/temperature/max_tokens"
            },
            {
                "id": "llm.oauth.clients",
                "method": "GET",
                "path": "/llm/oauth",
                "permission": "llm.manage",
                "assistant": false,
                "description": "List OAuth clients and MCP/OpenAPI endpoint URLs"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "llm.menu.group",
            "kind": "settings",
            "num": 40,
            "path": "/llm/tokens",
            "title": "llm.menu.tokens",
            "permission": "llm.manage",
            "capability": "SUPERADMIN_ACCESS"
        },
        {
            "group": "llm.menu.group",
            "kind": "settings",
            "num": 50,
            "path": "/llm/oauth",
            "title": "llm.menu.oauth",
            "permission": "llm.manage",
            "capability": "SUPERADMIN_ACCESS"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_oauth_clients",
        "base_oauth_codes",
        "base_oauth_tokens"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [],
        "publish": []
    },
    "catalog": {
        "categories": [
            "integrations"
        ],
        "maturity": "beta",
        "tags": [],
        "screenshots": []
    }
}
