{
    "id": "video_label",
    "name": "video_label.module.name",
    "description": "video_label.module.description",
    "version": "0.1.7",
    "type": "product",
    "requires": {
        "core": ">=1.0.0",
        "video": ">=0.1.0"
    },
    "optionalRequires": [],
    "provides": [
        "video_label.projects"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "video_label.view",
            "label": "video_label.perm.view"
        },
        {
            "id": "video_label.edit",
            "label": "video_label.perm.edit"
        },
        {
            "id": "video_label.delete",
            "label": "video_label.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/video-label",
            "/video-label/new",
            "/video-label/{id}/edit",
            "/video-label/{id}/workspace",
            "/video-label/media",
            "/agent/video-label/projects",
            "/agent/video-label/project",
            "/agent/video-label/ingest",
            "/agent/video-label/images"
        ]
    },
    "agent": {
        "docs": "docs/agents/video-label.md",
        "ops": [
            {
                "id": "video_label.agent.projects.list",
                "method": "GET",
                "path": "/agent/video-label/projects",
                "permission": "public",
                "side_effect": "read",
                "description": "Surface A (agent_token): list labeling projects"
            },
            {
                "id": "video_label.agent.projects.create",
                "method": "POST",
                "path": "/agent/video-label/projects",
                "permission": "public",
                "side_effect": "write",
                "description": "Surface A (agent_token): create labeling project"
            },
            {
                "id": "video_label.agent.projects.get",
                "method": "GET",
                "path": "/agent/video-label/project",
                "permission": "public",
                "side_effect": "read",
                "description": "Surface A (agent_token): get project by ?id="
            },
            {
                "id": "video_label.agent.projects.update",
                "method": "POST",
                "path": "/agent/video-label/project",
                "permission": "public",
                "side_effect": "write",
                "description": "Surface A (agent_token): update/delete project"
            },
            {
                "id": "video_label.agent.ingest",
                "method": "POST",
                "path": "/agent/video-label/ingest",
                "permission": "public",
                "side_effect": "write",
                "description": "Surface A (agent_token): ingest YOLO zip (multipart) or JSON frames[]; chunk ≤4MB on shared hosting"
            },
            {
                "id": "video_label.agent.images.list",
                "method": "GET",
                "path": "/agent/video-label/images",
                "permission": "public",
                "side_effect": "read",
                "description": "Surface A (agent_token): list project images ?id=&limit=&offset="
            },
            {
                "id": "video_label.projects.list",
                "method": "GET",
                "path": "/video-label",
                "permission": "video_label.view",
                "side_effect": "read",
                "description": "List labeling projects"
            },
            {
                "id": "video_label.projects.get",
                "method": "GET",
                "path": "/video-label/{id}/edit",
                "permission": "video_label.edit",
                "side_effect": "read",
                "description": "Project edit payload + available models"
            },
            {
                "id": "video_label.projects.create",
                "method": "POST",
                "path": "/video-label/new",
                "permission": "video_label.edit",
                "side_effect": "write",
                "description": "Create project; name, classes (newline), model_id, conf_threshold, iou_threshold",
                "parameters": {
                    "type": "object",
                    "required": ["name"],
                    "properties": {
                        "name": { "type": "string" },
                        "classes": { "type": "string" },
                        "model_id": { "type": "integer" },
                        "conf_threshold": { "type": "number" },
                        "iou_threshold": { "type": "number" }
                    }
                }
            },
            {
                "id": "video_label.projects.update",
                "method": "POST",
                "path": "/video-label/{id}/edit",
                "permission": "video_label.edit",
                "side_effect": "write",
                "description": "Update project (same fields as create)"
            },
            {
                "id": "video_label.projects.delete",
                "method": "POST",
                "path": "/video-label/{id}/edit",
                "permission": "video_label.edit",
                "side_effect": "write",
                "description": "Delete project; POST action=delete"
            },
            {
                "id": "video_label.workspace.get",
                "method": "GET",
                "path": "/video-label/{id}/workspace",
                "permission": "video_label.edit",
                "side_effect": "read",
                "description": "Workspace JSON: project, images with labels/predictions URLs, current_id"
            },
            {
                "id": "video_label.workspace.infer",
                "method": "POST",
                "path": "/video-label/{id}/workspace",
                "permission": "video_label.edit",
                "side_effect": "write",
                "description": "Enqueue infer; action=infer image_id= optional batch=1 promote=1",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "action": { "type": "string", "const": "infer" },
                        "image_id": { "type": "integer" },
                        "batch": { "type": "boolean" },
                        "promote": { "type": "boolean" }
                    }
                }
            },
            {
                "id": "video_label.workspace.export",
                "method": "POST",
                "path": "/video-label/{id}/workspace",
                "permission": "video_label.edit",
                "side_effect": "write",
                "description": "Export YOLO under var/video/exports/{id}/; action=export"
            },
            {
                "id": "video_label.workspace.save_labels",
                "method": "POST",
                "path": "/video-label/{id}/workspace",
                "permission": "video_label.edit",
                "side_effect": "write",
                "description": "Save boxes; action=save_labels image_id= labels_json= (YOLO-normalized JSON array)"
            },
            {
                "id": "video_label.workspace.ingest_zip",
                "method": "POST",
                "path": "/video-label/{id}/workspace",
                "permission": "video_label.edit",
                "side_effect": "write",
                "description": "Batch ingest YOLO zip (images/+labels/); multipart action=ingest_zip zip=file. Mac worker twin: POST /video/worker/dataset-ingest"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "video.menu.group",
            "num": 10,
            "path": "/video-label",
            "title": "video_label.menu.projects",
            "kind": "work"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_video_label_projects",
        "base_video_label_images"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [],
        "publish": []
    },
    "catalog": {
        "categories": [
            "integrations"
        ],
        "maturity": "alpha",
        "tags": [
            "jobs"
        ],
        "screenshots": []
    }
}
