{
    "id": "audio_llm",
    "name": "audio_llm.module.name",
    "description": "audio_llm.module.description",
    "version": "0.1.9",
    "type": "product",
    "requires": {
        "core": ">=1.0.0",
        "llm": ">=1.0.0",
        "audio": ">=1.0.0",
        "audio_dicts": ">=1.0.0"
    },
    "optionalRequires": {
        "staff_reports": ">=1.0.0",
        "comments": ">=1.0.0",
        "procedures": ">=1.0.0",
        "contracts": ">=1.0.0"
    },
    "provides": [
        "audio_llm.studies"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "audio_llm.view",
            "label": "audio_llm.perm.view"
        },
        {
            "id": "audio_llm.edit",
            "label": "audio_llm.perm.edit"
        },
        {
            "id": "audio_llm.delete",
            "label": "audio_llm.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/audio/llm-studies",
            "/audio/llm-studies/new",
            "/audio/llm-studies/work",
            "/audio/llm-studies/{id}",
            "/audio/review-moderate"
        ]
    },
    "agent": {
        "docs": "docs/agents/audio_llm.md",
        "ops": [
            {
                "id": "audio_llm.studies.list",
                "method": "GET",
                "path": "/audio/llm-studies",
                "permission": "audio_llm.view",
                "description": "List LLM studies; kind=regular|cyclic|spawned"
            },
            {
                "id": "audio_llm.studies.get",
                "method": "GET",
                "path": "/audio/llm-studies/{id}",
                "permission": "audio_llm.view",
                "description": "Get study + results + progress"
            },
            {
                "id": "audio_llm.studies.create",
                "method": "POST",
                "path": "/audio/llm-studies/new",
                "permission": "audio_llm.edit",
                "description": "Create regular or cyclic study"
            },
            {
                "id": "audio_llm.studies.work",
                "method": "POST",
                "path": "/audio/llm-studies/work",
                "permission": "audio_llm.edit",
                "description": "Process queue (POST + CSRF): study_id, limit; action=process|retry|reset|summary|process_all"
            },
            {
                "id": "audio_llm.review_moderate",
                "method": "POST",
                "path": "/audio/review-moderate",
                "permission": "audio.view",
                "description": "LLM moderator assistant for pending-review queue (admin+day); returns plain-text analysis"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "audio.menu.group",
            "num": 15,
            "path": "/audio/llm-studies",
            "title": "audio_llm.menu.studies"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_records_llm_studies",
        "base_records_llm_study_results"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "staff_reports.day.after_publish",
            "audio.settings.sections",
            "audio.settings.save"
        ],
        "publish": [
            "audio_llm.cyclic.spawn_for_procedure",
            "audio_llm.study.result"
        ]
    },
    "catalog": {
        "categories": [
            "audio"
        ],
        "maturity": "beta",
        "tags": [],
        "screenshots": []
    }
}
