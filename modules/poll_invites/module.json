{
    "id": "poll_invites",
    "name": "poll_invites.module.name",
    "description": "poll_invites.module.description",
    "version": "0.2.1",
    "type": "product",
    "requires": {
        "core": ">=1.0.0",
        "polls": ">=0.1.0"
    },
    "optionalRequires": {
        "clients": ">=1.0.0",
        "bonuses": ">=1.0.0",
        "calendar": ">=1.0.0",
        "procedures": ">=1.0.0",
        "audio": ">=1.0.0",
        "bi": ">=1.0.0",
        "poll_speech": ">=0.1.0"
    },
    "provides": [
        "poll_invites.instances"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "poll_invites.view",
            "label": "poll_invites.perm.view"
        },
        {
            "id": "poll_invites.edit",
            "label": "poll_invites.perm.edit"
        },
        {
            "id": "poll_invites.delete",
            "label": "poll_invites.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/poll-invites",
            "/poll-invites/longjob",
            "/poll-invites/unviewed",
            "/poll-invites/new",
            "/poll-invites/oral-asked",
            "/poll-invites/{id}",
            "/poll-invites/{id}/edit",
            "/poll-invites/{id}/fill",
            "/poll-invites/{id}/refill",
            "/q/{code}"
        ]
    },
    "agent": {
        "docs": "docs/agents/poll_invites.md",
        "ops": [
            {
                "id": "poll_invites.longjob",
                "method": "POST",
                "path": "/poll-invites/longjob",
                "permission": "poll_invites.delete",
                "side_effect": "write",
                "assistant": false,
                "description": "LongJob tick API for filter-wide delete_unfilled: action=job_start|job_tick|job_cancel; body filters_json / job_id. Pump ticks until done."
            },
            {
                "id": "poll_invites.list",
                "method": "GET",
                "path": "/poll-invites",
                "permission": "poll_invites.view",
                "description": "List poll invites; filters: day (YYYY-MM-DD|all, default today), q, id_poll, progress (open|done|expired|unviewed|unfilled), id_operator, id_resp",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "day": {
                            "type": "string",
                            "description": "YYYY-MM-DD procedure day; omit=today; all=no day filter"
                        },
                        "q": { "type": "string" },
                        "id_poll": { "type": "integer" },
                        "progress": {
                            "type": "string",
                            "description": "open|done|expired|unviewed|unfilled"
                        },
                        "id_operator": { "type": "integer" },
                        "id_resp": { "type": "integer" }
                    }
                }
            },
            {
                "id": "poll_invites.unviewed.mark",
                "method": "POST",
                "path": "/poll-invites",
                "permission": "poll_invites.view",
                "side_effect": "write",
                "description": "Mark invites viewed (action=mark_viewed; body: id / ids[] / mark_all=1)",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "action": {
                            "type": "string",
                            "description": "mark_viewed"
                        },
                        "id": { "type": "integer" },
                        "ids": {
                            "type": "array",
                            "items": { "type": "integer" }
                        },
                        "mark_all": {
                            "type": "string",
                            "description": "1 = mark all unviewed for current user"
                        }
                    },
                    "required": ["action"]
                }
            },
            {
                "id": "poll_invites.create",
                "method": "POST",
                "path": "/poll-invites/new",
                "permission": "poll_invites.edit",
                "side_effect": "write",
                "description": "Create a poll invite"
            },
            {
                "id": "poll_invites.oral_asked",
                "method": "POST",
                "path": "/poll-invites/oral-asked",
                "permission": "poll_invites.edit",
                "side_effect": "write",
                "description": "Mark oral review asked for a procedure (creates invite with ID_PROC, empty CODE)",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "id_proc": { "type": "integer" },
                        "id_poll": { "type": "integer" },
                        "ret": { "type": "string" }
                    },
                    "required": ["id_proc"]
                }
            },
            {
                "id": "poll_invites.refill",
                "method": "POST",
                "path": "/poll-invites/{id}/refill",
                "permission": "poll_invites.edit",
                "side_effect": "write",
                "description": "Follow-up questionnaire: new invite for the same respondent with previous answers prefilled and a new public link (/q/{code}); the old invite stays as history. Emits poll_invites.refilled.",
                "parameters": {
                    "type": "object",
                    "required": ["id"],
                    "properties": {
                        "id": {"type": "integer"},
                        "expire_days": {"type": "integer", "description": "Default 14"}
                    }
                }
            },
            {
                "id": "poll_invites.public",
                "method": "GET",
                "path": "/q/{code}",
                "permission": "public",
                "assistant": false,
                "description": "Respondent channel (no login, long random code): GET → state, title, intro, questions[{qid,name,hint,multi,text,options[]}], answers; POST answers[qid]=option id (or [] for multi) + texts[qid] → {completed, missing_qid}. Personalised by PERSONAL_JSON (skip_qids, hints, vars) and {client.name}-style placeholders."
            },
            {
                "id": "poll_invites.fill",
                "method": "POST",
                "path": "/poll-invites/{id}/fill",
                "permission": "poll_invites.edit",
                "side_effect": "write",
                "description": "Save staff fill answers for an invite",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "id": { "type": "integer" }
                    },
                    "required": ["id"]
                }
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "polls.menu.group",
            "num": 20,
            "path": "/poll-invites",
            "title": "poll_invites.menu.list",
            "kind": "crud"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_poll_invites"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "core.notices.collect",
            "bi.datasets",
            "polls.settings.sections",
            "polls.settings.save"
        ],
        "publish": [
            "poll_invites.created",
            "poll_invites.answer.saved",
            "poll_invites.completed",
            "poll_invites.refilled",
            "poll_invites.public.context"
        ],
        "contracts": {
            "poll_invites.refilled": "{invite_id, from_invite_id} — follow-up invite created with prefilled answers",
            "poll_invites.public.context": "{invite, vars} — add placeholder values (e.g. company.name) for /q/{code}; return payload"
        }
    },
    "bulkActions": [
        {
            "list_id": "poll_invites",
            "action": "delete"
        }
    ],
    "catalog": {
        "categories": [
            "communications"
        ],
        "maturity": "beta",
        "tags": [],
        "screenshots": []
    },
    "setup": {
        "steps": [
            {
                "id": "config",
                "title": "poll_invites.setup.step.config",
                "description": "poll_invites.setup.step.config_help",
                "href": "/polls/settings",
                "ask_user": "poll_invites.setup.ask.config",
                "choices": [
                    {
                        "id": "open",
                        "label": "poll_invites.setup.choice.open",
                        "recommended": true
                    },
                    {
                        "id": "defer",
                        "label": "core.modules.setup.choice.defer",
                        "recommended": false
                    }
                ],
                "agent_can": []
            }
        ]
    }
}
