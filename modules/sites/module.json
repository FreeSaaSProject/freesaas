{
    "id": "sites",
    "name": "sites.module.name",
    "description": "sites.module.description",
    "version": "0.2.0",
    "type": "product",
    "runtime": "both",
    "requires": {
        "core": ">=0.3.0"
    },
    "optionalRequires": {
        "catalog": ">=0.1.0",
        "orders": ">=0.1.0",
        "clients": ">=0.1.0",
        "booking": ">=0.1.0"
    },
    "provides": [
        "sites.storefront",
        "sites.theme",
        "sites.pages",
        "sites.promopages",
        "sites.redirects",
        "sites.seo"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "sites.view",
            "label": "sites.perm.view"
        },
        {
            "id": "sites.edit",
            "label": "sites.perm.edit"
        },
        {
            "id": "sites.promopages",
            "label": "sites.perm.promopages"
        },
        {
            "id": "sites.pages",
            "label": "sites.perm.pages"
        },
        {
            "id": "sites.redirects",
            "label": "sites.perm.redirects"
        }
    ],
    "routes": {
        "pages": [
            "/sites/hosts",
            "/sites/hosts/new",
            "/sites/hosts/{id}/edit",
            "/sites/settings",
            "/sites/seo",
            "/sites/promopages",
            "/sites/promopages/new",
            "/sites/promopages/{id}/edit",
            "/sites/pages",
            "/sites/pages/new",
            "/sites/pages/{id}/edit",
            "/sites/redirects",
            "/sites/redirects/new",
            "/sites/redirects/{id}/edit",
            "/page/…",
            "/shop",
            "/shop/c/{id}",
            "/shop/{id}",
            "/cart",
            "/cart/availability",
            "/cart/checkout",
            "/promo/{code}",
            "/sitemap.xml",
            "/robots.txt"
        ]
    },
    "agent": {
        "ops": [
            {
                "id": "sites.hosts.list",
                "method": "GET",
                "path": "/sites/hosts",
                "permission": "sites.view",
                "description": "List public hosts; filters: q, enabled"
            },
            {
                "id": "sites.settings.get",
                "method": "GET",
                "path": "/sites/settings",
                "permission": "sites.view",
                "description": "Storefront settings (admin_host)"
            },
            {
                "id": "sites.settings.save",
                "method": "POST",
                "path": "/sites/settings",
                "permission": "sites.edit",
                "description": "Save admin_host"
            },
            {
                "id": "sites.promopages.list",
                "method": "GET",
                "path": "/sites/promopages",
                "permission": "sites.promopages",
                "description": "List promo pages; filters: q, enabled"
            },
            {
                "id": "sites.pages.list",
                "method": "GET",
                "path": "/sites/pages",
                "permission": "sites.pages",
                "description": "List site articles; filters: q, enabled, site_host_id"
            },
            {
                "id": "sites.redirects.list",
                "method": "GET",
                "path": "/sites/redirects",
                "permission": "sites.redirects",
                "description": "List URL redirects; filters: q, enabled, site_host_id"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "sites.menu.group",
            "num": 1,
            "path": "/sites/hosts",
            "title": "sites.menu.hosts",
            "kind": "settings"
        },
        {
            "group": "sites.menu.group",
            "num": 5,
            "path": "/sites/seo",
            "title": "sites.menu.seo",
            "kind": "settings"
        },
        {
            "group": "sites.menu.group",
            "num": 10,
            "path": "/sites/promopages",
            "title": "sites.menu.promopages",
            "kind": "crud"
        },
        {
            "group": "sites.menu.group",
            "num": 11,
            "path": "/sites/pages",
            "title": "sites.menu.pages",
            "kind": "crud"
        },
        {
            "group": "sites.menu.group",
            "num": 12,
            "path": "/sites/redirects",
            "title": "sites.menu.redirects",
            "kind": "crud"
        },
        {
            "group": "sites.menu.group",
            "num": 90,
            "path": "/sites/settings",
            "title": "sites.menu.settings",
            "kind": "settings"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_site_hosts",
        "base_promopages",
        "base_page_categories",
        "base_redirects"
    ],
    "migrators": [
        {
            "id": "phpshop_page_categories_to_base_page_categories",
            "mode": "replace",
            "source": [
                "phpshop_page_categories"
            ],
            "target": [
                "base_page_categories"
            ]
        },
        {
            "id": "fill_contacts_page_content",
            "mode": "fill",
            "source": [],
            "target": [
                "base_page_categories"
            ]
        },
        {
            "id": "fill_reviews_page_widgets",
            "mode": "fill",
            "source": [],
            "target": [
                "base_page_categories"
            ]
        }
    ],
    "hooks": {
        "subscribe": [
            "router.not_found"
        ],
        "publish": [
            "sites.request",
            "sites.page.render",
            "sites.nav",
            "sites.home",
            "sites.checkout.before",
            "sites.checkout.after",
            "sites.cart.booking"
        ]
    },
    "bulkActions": [
        {
            "list_id": "sites_hosts",
            "action": "delete"
        },
        {
            "list_id": "sites_promopages",
            "action": "delete"
        },
        {
            "list_id": "sites_pages",
            "action": "delete"
        },
        {
            "list_id": "sites_redirects",
            "action": "delete"
        }
    ],
    "catalog": {
        "categories": [
            "site"
        ],
        "maturity": "alpha",
        "tags": [
            "embed"
        ],
        "screenshots": []
    }
}
