{
    "id": "terminals",
    "name": "terminals.module.name",
    "description": "terminals.module.description",
    "version": "0.1.26",
    "type": "product",
    "runtime": "both",
    "requires": {
        "core": ">=0.3.0"
    },
    "optionalRequires": {
        "catalog": ">=0.1.0",
        "clients": ">=0.1.0",
        "booking": ">=0.1.0",
        "procedures": ">=0.1.0",
        "orders": ">=0.1.0"
    },
    "provides": [
        "terminals.registry",
        "terminals.analytics",
        "terminals.sync",
        "terminals.floor"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "terminals.view",
            "label": "terminals.perm.view"
        },
        {
            "id": "terminals.edit",
            "label": "terminals.perm.edit"
        },
        {
            "id": "terminals.sync",
            "label": "terminals.perm.sync"
        },
        {
            "id": "terminals.delete",
            "label": "terminals.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/terminals",
            "/terminals/new",
            "/terminals/{id}/edit",
            "/terminals/bracelets",
            "/terminals/bracelets/new",
            "/terminals/bracelets/{id}/edit",
            "/terminals/termloads",
            "/terminals/fullstats",
            "/terminals/fullstats/{id}/edit",
            "/terminals/settings",
            "/terminals/t/status",
            "/terminals/1c",
            "/terminals/1c/{mode}",
            "/terminals/floor",
            "/t",
            "/terminals/jobs/load",
            "/terminals/jobs/tickets"
        ]
    },
    "agent": {
        "docs": "docs/agents/terminals.md",
        "ops": [
            {
                "id": "terminals.t.get",
                "method": "GET",
                "path": "/terminals/t/status",
                "permission": "terminals.view",
                "side_effect": "read",
                "description": "Floor /t diagnose: 1C readiness, claim state, soft deps; query terminalid=",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "terminalid": {
                            "type": "integer",
                            "description": "Optional terminal id"
                        }
                    }
                }
            },
            {
                "id": "terminals.onec.diag",
                "method": "GET",
                "path": "/terminals/1c",
                "permission": "terminals.edit",
                "side_effect": "read",
                "description": "1C diagnostic console snapshot; optional path /terminals/1c/{mode} (clientByCard, price, debt, …); mutations POST sale/unsale/cardtoticket",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "mode": {
                            "type": "string",
                            "description": "Optional mode when calling /terminals/1c/{mode}"
                        },
                        "NFCUID": {
                            "type": "string"
                        },
                        "CARD": {
                            "type": "string"
                        },
                        "PHONE": {
                            "type": "string"
                        },
                        "ONECID": {
                            "type": "string"
                        }
                    }
                }
            },
            {
                "id": "terminals.floor.book",
                "method": "POST",
                "path": "/terminals/floor",
                "permission": "terminals.edit",
                "side_effect": "write",
                "assistant": false,
                "description": "Procedure-mode book/cancel: action=book|cancel, product_id, operator_id, dt_start, terminal_id, optional disable_1c",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "action": {
                            "type": "string",
                            "description": "book or cancel"
                        },
                        "product_id": {
                            "type": "integer"
                        },
                        "operator_id": {
                            "type": "integer"
                        },
                        "dt_start": {
                            "type": "integer"
                        },
                        "terminal_id": {
                            "type": "integer"
                        },
                        "procedure_id": {
                            "type": "integer"
                        },
                        "disable_1c": {
                            "type": "boolean"
                        }
                    }
                }
            },
            {
                "id": "terminals.list",
                "method": "GET",
                "path": "/terminals",
                "permission": "terminals.view",
                "description": "List terminals; filters: q, enabled"
            },
            {
                "id": "terminals.get",
                "method": "GET",
                "path": "/terminals/{id}/edit",
                "permission": "terminals.view",
                "description": "One terminal including device CODE"
            },
            {
                "id": "terminals.create",
                "method": "POST",
                "path": "/terminals/new",
                "permission": "terminals.edit",
                "description": "Create terminal"
            },
            {
                "id": "terminals.update",
                "method": "POST",
                "path": "/terminals/{id}/edit",
                "permission": "terminals.edit",
                "description": "Update terminal; empty code keeps previous"
            },
            {
                "id": "terminals.bracelets.list",
                "method": "GET",
                "path": "/terminals/bracelets",
                "permission": "terminals.view",
                "description": "List bracelets; filters: q"
            },
            {
                "id": "terminals.bracelets.get",
                "method": "GET",
                "path": "/terminals/bracelets/{id}/edit",
                "permission": "terminals.view",
                "description": "One bracelet"
            },
            {
                "id": "terminals.bracelets.create",
                "method": "POST",
                "path": "/terminals/bracelets/new",
                "permission": "terminals.edit",
                "description": "Create bracelet"
            },
            {
                "id": "terminals.bracelets.update",
                "method": "POST",
                "path": "/terminals/bracelets/{id}/edit",
                "permission": "terminals.edit",
                "description": "Update bracelet"
            },
            {
                "id": "terminals.termloads.day",
                "method": "GET",
                "path": "/terminals/termloads",
                "permission": "terminals.view",
                "side_effect": "read",
                "description": "Day headcount series; query: day=YYYY-MM-DD",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "day": {
                            "type": "string",
                            "description": "YYYY-MM-DD"
                        }
                    },
                    "required": [
                        "day"
                    ]
                }
            },
            {
                "id": "terminals.fullstats.list",
                "method": "GET",
                "path": "/terminals/fullstats",
                "permission": "terminals.view",
                "description": "Ticket visits; filters: day, from, to"
            },
            {
                "id": "terminals.fullstats.classify",
                "method": "POST",
                "path": "/terminals/fullstats/{id}/edit",
                "permission": "terminals.edit",
                "description": "Set ticket type flags; propagates by TICKET_TYPE"
            },
            {
                "id": "terminals.settings.get",
                "method": "GET",
                "path": "/terminals/settings",
                "permission": "",
                "description": "Flags + masked secrets (SUPERADMIN_ACCESS)"
            },
            {
                "id": "terminals.settings.save",
                "method": "POST",
                "path": "/terminals/settings",
                "permission": "",
                "description": "Save ini; empty secret fields keep previous (SUPERADMIN_ACCESS)"
            },
            {
                "id": "terminals.jobs.load",
                "method": "POST",
                "path": "/terminals/jobs/load",
                "permission": "",
                "assistant": false,
                "description": "Sync 1C club_workload → termloads; auth X-Terminals-Token. Also Cron job terminals.load via /cron/tick"
            },
            {
                "id": "terminals.jobs.tickets",
                "method": "POST",
                "path": "/terminals/jobs/tickets",
                "permission": "",
                "assistant": false,
                "description": "Sync 1C club_workload_detail → fullstats; auth X-Terminals-Token. Also Cron job terminals.tickets"
            }
        ]
    },
    "jobs": [
        "platform Cron::register terminals.load|tickets → /cron/tick",
        "/terminals/jobs/load",
        "/terminals/jobs/tickets"
    ],
    "menu": [
        {
            "group": "terminals.menu.group",
            "num": 10,
            "path": "/terminals",
            "title": "terminals.menu.list",
            "kind": "crud"
        },
        {
            "group": "terminals.menu.group",
            "num": 20,
            "path": "/terminals/bracelets",
            "title": "terminals.menu.bracelets",
            "kind": "crud"
        },
        {
            "group": "terminals.menu.group",
            "num": 30,
            "path": "/terminals/termloads",
            "title": "terminals.menu.termloads",
            "kind": "work"
        },
        {
            "group": "terminals.menu.group",
            "num": 40,
            "path": "/terminals/fullstats",
            "title": "terminals.menu.fullstats",
            "kind": "work"
        },
        {
            "group": "terminals.menu.group",
            "num": 50,
            "path": "/terminals/1c",
            "title": "terminals.menu.onec",
            "kind": "work"
        },
        {
            "group": "terminals.menu.group",
            "num": 90,
            "path": "/terminals/settings",
            "title": "terminals.menu.settings",
            "kind": "settings"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_terminals",
        "base_bracelets",
        "base_termloads",
        "base_fullstats",
        "base_term_orders",
        "base_terminals_activations",
        "base_client_onec_bindings",
        "base_staff_bracelets"
    ],
    "migrators": [
        {
            "id": "phpshop_shopusers_bracelets_to_base_staff_bracelets",
            "mode": "seed",
            "source": [
                "phpshop_shopusers"
            ],
            "target": [
                "base_staff_bracelets"
            ]
        }
    ],
    "hooks": {
        "subscribe": [
            "catalog.product_edit.sections",
            "catalog.product_edit.save",
            "core.user_edit.sections",
            "core.user_edit.save",
            "core.user_edit.profile",
            "calendar.timeline.enrich"
        ],
        "publish": []
    },
    "bulkActions": [
        {
            "list_id": "terminals",
            "action": "delete"
        },
        {
            "list_id": "terminals_bracelets",
            "action": "delete"
        }
    ],
    "catalog": {
        "categories": [
            "integrations"
        ],
        "maturity": "beta",
        "tags": [],
        "screenshots": []
    }
}
