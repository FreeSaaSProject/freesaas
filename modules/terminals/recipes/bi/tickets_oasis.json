{
  "v": 1,
  "id": "tickets_oasis",
  "title": "Билеты: оазис и конверсия BMSSG/BSPA",
  "requires": [
    "guests",
    "procedures"
  ],
  "queries": [
    {
      "as": "oasis_totals",
      "from": "guests",
      "where": [
        {
          "field": "is_oasis",
          "op": "=",
          "value": 1
        }
      ],
      "select": [
        {
          "agg": "count",
          "as": "oasis_guests"
        }
      ]
    },
    {
      "as": "regular_totals",
      "from": "guests",
      "where": [
        {
          "field": "is_oasis",
          "op": "!=",
          "value": 1
        }
      ],
      "select": [
        {
          "agg": "count",
          "as": "regular_guests"
        }
      ]
    },
    {
      "as": "guest_totals",
      "from": "guests",
      "select": [
        {
          "agg": "count",
          "as": "total_guests"
        }
      ]
    },
    {
      "as": "oasis_raw",
      "from": "guests",
      "where": [
        {
          "field": "is_oasis",
          "op": "=",
          "value": 1
        }
      ],
      "select": [
        {
          "field": "id",
          "as": "guest_id"
        },
        {
          "field": "dtstart",
          "as": "dtstart"
        }
      ],
      "limit": 100000
    },
    {
      "as": "spa_totals",
      "from": "procedures",
      "where": [
        {
          "field": "type",
          "op": "in",
          "value": [
            48,
            49
          ]
        },
        {
          "field": "enabled",
          "op": ">",
          "value": 0
        },
        {
          "field": "restored",
          "op": "<",
          "value": 1
        }
      ],
      "select": [
        {
          "agg": "count",
          "as": "spa_services"
        },
        {
          "agg": "count_distinct",
          "field": "id_user",
          "as": "spa_clients"
        }
      ]
    },
    {
      "as": "spa_raw",
      "from": "procedures",
      "where": [
        {
          "field": "type",
          "op": "in",
          "value": [
            48,
            49
          ]
        },
        {
          "field": "enabled",
          "op": ">",
          "value": 0
        },
        {
          "field": "restored",
          "op": "<",
          "value": 1
        }
      ],
      "select": [
        {
          "field": "id",
          "as": "proc_id"
        },
        {
          "field": "dtstart",
          "as": "dtstart"
        },
        {
          "field": "id_user",
          "as": "id_user"
        },
        {
          "field": "type",
          "as": "type"
        }
      ],
      "limit": 100000
    }
  ],
  "derive": [
    {
      "as": "oasis_key",
      "from": "oasis_totals",
      "compute": [
        {
          "as": "k",
          "expr": {
            "lit": 1
          }
        }
      ]
    },
    {
      "as": "spa_key",
      "from": "spa_totals",
      "compute": [
        {
          "as": "k",
          "expr": {
            "lit": 1
          }
        }
      ]
    },
    {
      "as": "kpi",
      "from": "oasis_key",
      "join_frame": {
        "frame": "spa_key",
        "type": "left",
        "left": "k",
        "right": "k"
      },
      "compute": [
        {
          "as": "spa_services",
          "expr": {
            "coalesce": [
              {
                "field": "spa_services"
              },
              {
                "lit": 0
              }
            ]
          }
        },
        {
          "as": "spa_clients",
          "expr": {
            "coalesce": [
              {
                "field": "spa_clients"
              },
              {
                "lit": 0
              }
            ]
          }
        },
        {
          "as": "conversion",
          "expr": {
            "round": [
              {
                "mul": [
                  {
                    "div": [
                      {
                        "field": "spa_services"
                      },
                      {
                        "nullif": [
                          {
                            "field": "oasis_guests"
                          },
                          {
                            "lit": 0
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "lit": 100
                  }
                ]
              },
              {
                "lit": 1
              }
            ]
          }
        }
      ]
    },
    {
      "as": "oasis_day",
      "from": "oasis_raw",
      "compute": [
        {
          "as": "day_start",
          "expr": {
            "day_start": [
              {
                "field": "dtstart"
              }
            ]
          }
        },
        {
          "as": "day_label",
          "expr": {
            "day_label": [
              {
                "field": "dtstart"
              }
            ]
          }
        }
      ]
    },
    {
      "as": "spa_day",
      "from": "spa_raw",
      "compute": [
        {
          "as": "day_start",
          "expr": {
            "day_start": [
              {
                "field": "dtstart"
              }
            ]
          }
        },
        {
          "as": "day_label",
          "expr": {
            "day_label": [
              {
                "field": "dtstart"
              }
            ]
          }
        }
      ]
    },
    {
      "as": "day_oasis",
      "from": "oasis_day",
      "group_by": [
        "day_start",
        "day_label"
      ],
      "aggs": [
        {
          "as": "oasis_guests",
          "op": "count"
        }
      ]
    },
    {
      "as": "day_spa",
      "from": "spa_day",
      "group_by": [
        "day_start",
        "day_label"
      ],
      "aggs": [
        {
          "as": "spa_services",
          "op": "count"
        },
        {
          "as": "spa_clients",
          "op": "count_distinct",
          "field": "id_user"
        },
        {
          "as": "bmssg",
          "op": "count_where",
          "where": {
            "eq": [
              {
                "field": "type"
              },
              {
                "lit": 48
              }
            ]
          }
        },
        {
          "as": "bspa",
          "op": "count_where",
          "where": {
            "eq": [
              {
                "field": "type"
              },
              {
                "lit": 49
              }
            ]
          }
        }
      ]
    },
    {
      "as": "day_merged",
      "from": "day_oasis",
      "join_frame": {
        "frame": "day_spa",
        "type": "left",
        "left": "day_start",
        "right": "day_start"
      },
      "compute": [
        {
          "as": "spa_services",
          "expr": {
            "coalesce": [
              {
                "field": "spa_services"
              },
              {
                "lit": 0
              }
            ]
          }
        },
        {
          "as": "spa_clients",
          "expr": {
            "coalesce": [
              {
                "field": "spa_clients"
              },
              {
                "lit": 0
              }
            ]
          }
        },
        {
          "as": "bmssg",
          "expr": {
            "coalesce": [
              {
                "field": "bmssg"
              },
              {
                "lit": 0
              }
            ]
          }
        },
        {
          "as": "bspa",
          "expr": {
            "coalesce": [
              {
                "field": "bspa"
              },
              {
                "lit": 0
              }
            ]
          }
        },
        {
          "as": "conversion",
          "expr": {
            "round": [
              {
                "mul": [
                  {
                    "div": [
                      {
                        "field": "spa_services"
                      },
                      {
                        "nullif": [
                          {
                            "field": "oasis_guests"
                          },
                          {
                            "lit": 0
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "lit": 100
                  }
                ]
              },
              {
                "lit": 1
              }
            ]
          }
        }
      ],
      "sort": [
        {
          "field": "day_start",
          "dir": "asc"
        }
      ]
    }
  ],
  "sections": [
    {
      "type": "metrics",
      "title": "За период",
      "items": [
        {
          "label": "Всего билетов",
          "from": "guest_totals",
          "field": "total_guests"
        },
        {
          "label": "Оазис",
          "from": "oasis_totals",
          "field": "oasis_guests"
        },
        {
          "label": "Обычные (не оазис)",
          "from": "regular_totals",
          "field": "regular_guests"
        },
        {
          "label": "Услуги BMSSG+BSPA (тип 48/49)",
          "from": "kpi",
          "field": "spa_services"
        },
        {
          "label": "Клиенты BMSSG+BSPA",
          "from": "kpi",
          "field": "spa_clients"
        },
        {
          "label": "Конверсия услуг/оазис, %",
          "from": "kpi",
          "field": "conversion"
        }
      ]
    },
    {
      "type": "table",
      "title": "По дням",
      "from": "day_merged",
      "columns": [
        {
          "id": "day_label",
          "label": "День"
        },
        {
          "id": "oasis_guests",
          "label": "Оазис"
        },
        {
          "id": "spa_services",
          "label": "Услуги 48/49"
        },
        {
          "id": "bmssg",
          "label": "BMSSG"
        },
        {
          "id": "bspa",
          "label": "BSPA"
        },
        {
          "id": "spa_clients",
          "label": "Клиенты"
        },
        {
          "id": "conversion",
          "label": "Конверсия %"
        }
      ]
    },
    {
      "type": "text",
      "title": "Пояснение",
      "body": "Оазис = IS_OASIS=1. Услуги — процедуры TYPE 48 (BMSSG, Баланс массажи) и 49 (BSPA, Баланс уходы), enabled, не restored. Конверсия = услуги / гости оазиса × 100 (операционный KPI по объёму, без склейки клиент↔билет)."
    }
  ]
}
