{
    "id": "workweeks",
    "name": "workweeks.module.name",
    "description": "workweeks.module.description",
    "version": "1.0.1",
    "type": "product",
    "runtime": "both",
    "requires": {
        "core": ">=1.0.0"
    },
    "optionalRequires": {
        "comments": ">=1.0.0",
        "cabinets": ">=1.0.0",
        "tables": ">=1.0.0",
        "audio": ">=1.0.0",
        "bots": ">=1.0.0",
        "assistant": ">=1.0.0",
        "bi": ">=1.0.0"
    },
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "workweeks.view",
            "label": "workweeks.perm.view"
        },
        {
            "id": "workweeks.edit",
            "label": "workweeks.perm.edit"
        },
        {
            "id": "workweeks.delete",
            "label": "workweeks.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/workweeks",
            "/workweeks/new",
            "/workweeks/{id}/edit",
            "/workweeks/nazop",
            "/workweeks/nazcab",
            "/workweeks/settings",
            "/workweeks/day/{date}"
        ]
    },
    "agent": {
        "docs": "docs/agents/workweeks.md",
        "ops": [
            {
                "id": "workweeks.nazcab",
                "method": "GET",
                "path": "/workweeks/nazcab",
                "permission": "workweeks.view",
                "description": "Nazcab: tables only for today; badges multi-day. POST table[today][opId], badge[date][opId]. Gate: tables.view and/or audio.view|badges (not EVT_ASSIGN); route workweeks.view"
            },
            {
                "id": "workweeks.nazop.get",
                "method": "GET",
                "path": "/workweeks/nazop",
                "permission": "workweeks.view",
                "description": "Nazop matrix JSON (EVT_ASSIGN). Query: day=YYYY-MM-DD|all, ops=comma ids. Returns matrix, shift_windows, available_ops. Prefer this to bulk-set price_col for many staff/days"
            },
            {
                "id": "workweeks.nazop.save",
                "method": "POST",
                "path": "/workweeks/nazop",
                "permission": "workweeks.view",
                "side_effect": "write",
                "description": "Save nazop: nazop_action=save, ops[], checked[date][opId]=1, op_price[date][opId]=PRICE_COL, mas_max[date]. New assigns: op_price → status DEFAULT_PRICE_COL → lane I",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "nazop_action": { "type": "string", "const": "save" },
                        "ops": { "type": "array", "items": { "type": "integer" } },
                        "checked": { "type": "object", "description": "checked[YYYY-MM-DD][opId]=1" },
                        "op_price": { "type": "object", "description": "op_price[YYYY-MM-DD][opId]=PRICE_COL lane id" },
                        "mas_max": { "type": "object" }
                    },
                    "required": ["nazop_action", "ops"]
                }
            },
            {
                "id": "workweeks.list",
                "method": "GET",
                "path": "/workweeks",
                "permission": "workweeks.view",
                "description": "List shift rows; filters: q (name/login), user_id, date_from, date_to. Prefer workweeks.day for one calendar day; use q to resolve staff on a date range"
            },
            {
                "id": "workweeks.get",
                "method": "GET",
                "path": "/workweeks/{id}/edit",
                "permission": "workweeks.edit",
                "description": "One shift edit payload (requires assign permission)"
            },
            {
                "id": "workweeks.create",
                "method": "POST",
                "path": "/workweeks/new",
                "permission": "workweeks.edit",
                "description": "Create shift; date, id_operator, price_col (lane id from settings), mas_max, id_table"
            },
            {
                "id": "workweeks.update",
                "method": "POST",
                "path": "/workweeks/{id}/edit",
                "permission": "workweeks.edit",
                "description": "Update shift; required id. Optional patch: date, id_operator, price_col, mas_max, id_table (omitted fields keep current row). Replace staff on a shift = update id_operator (not create+orphan)"
            },
            {
                "id": "workweeks.delete",
                "method": "POST",
                "path": "/workweeks/{id}/edit",
                "permission": "workweeks.delete",
                "side_effect": "write",
                "description": "Delete shift row; POST action=delete (required id)"
            },
            {
                "id": "workweeks.day",
                "method": "GET",
                "path": "/workweeks/day/{date}",
                "permission": "workweeks.view",
                "description": "Shifts on one calendar day (YYYY-MM-DD). Each shift has operator_name + operator_acronym (МСА/ДВМ). CALL first to resolve who works; swap/replace/assign from this roster before asking the user"
            },
            {
                "id": "workweeks.settings.get",
                "method": "GET",
                "path": "/workweeks/settings",
                "permission": "workweeks.view",
                "description": "Shift lane catalog (PRICE_COL windows) + schedule log (SUPERADMIN_ACCESS). Returns shift_windows, next_shift_id, defaults"
            },
            {
                "id": "workweeks.settings.update",
                "method": "POST",
                "path": "/workweeks/settings",
                "permission": "workweeks.view",
                "side_effect": "write",
                "description": "Save lanes: shifts[{id}][label|start|end]; shift_action=add|save; shift_delete={id}. Also news_schedule_id, log_table_changes. SUPERADMIN_ACCESS",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "shifts": {
                            "type": "object",
                            "description": "Map PRICE_COL id → {label, start HH:MM, end HH:MM}"
                        },
                        "shift_action": {
                            "type": "string",
                            "enum": ["save", "add"]
                        },
                        "shift_delete": {
                            "type": "integer",
                            "description": "Lane id to remove (keep ≥1)"
                        },
                        "news_schedule_id": { "type": "integer" },
                        "log_table_changes": { "type": "string" }
                    }
                }
            }
        ],
        "relations": [
            {
                "id": "workweeks.vacation_shifts",
                "when": ["vacations.create", "vacations.update"],
                "from": "vacations.get",
                "check": "workweeks.list",
                "args": {
                    "user_id": "{user_id}",
                    "date_from": "{dt_start|date}",
                    "date_to": "{dt_end|date}",
                    "page": "all"
                },
                "suggest": ["workweeks.delete"],
                "fields": ["date", "operator_name", "price_col"],
                "max_rows": 31,
                "hint": "workweeks.relation.vacation_shifts",
                "notice": "workweeks.relation.vacation_shifts.notice"
            },
            {
                "id": "workweeks.user_disabled_shifts",
                "when": ["core.users.update"],
                "if": { "enabled": "0" },
                "check": "workweeks.list",
                "args": { "user_id": "{id}", "date_from": "{today}", "page": "all" },
                "suggest": ["workweeks.delete"],
                "fields": ["date", "operator_name", "price_col"],
                "max_rows": 31,
                "hint": "workweeks.relation.user_disabled_shifts",
                "notice": "workweeks.relation.user_disabled_shifts.notice"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.team",
            "num": 3,
            "path": "/workweeks",
            "title": "workweeks.menu.list"
        },
        {
            "group": "core.menu.group.team",
            "num": 90,
            "kind": "settings",
            "path": "/workweeks/settings",
            "title": "workweeks.menu.settings",
            "permission": "workweeks.view",
            "capability": "SUPERADMIN_ACCESS"
        }
    ],
    "configSchema": {
        "workweeks": {
            "schedule_news_id": {
                "type": "integer",
                "default": 0
            },
            "log_table_changes": {
                "type": "string",
                "default": "1"
            },
            "shift_ids": {
                "type": "string",
                "default": ""
            },
            "shift_1_start": {
                "type": "string",
                "default": "00:00"
            },
            "shift_1_end": {
                "type": "string",
                "default": "15:30"
            },
            "shift_1_label": {
                "type": "string",
                "default": "I"
            },
            "shift_2_start": {
                "type": "string",
                "default": "15:30"
            },
            "shift_2_end": {
                "type": "string",
                "default": "23:59"
            },
            "shift_2_label": {
                "type": "string",
                "default": "II"
            },
            "shift_3_start": {
                "type": "string",
                "default": "00:00"
            },
            "shift_3_end": {
                "type": "string",
                "default": "23:59"
            },
            "shift_3_label": {
                "type": "string",
                "default": "I+II"
            },
            "shift_4_start": {
                "type": "string",
                "default": "09:30"
            },
            "shift_4_end": {
                "type": "string",
                "default": "17:00"
            },
            "shift_4_label": {
                "type": "string",
                "default": "IV"
            },
            "shift_5_start": {
                "type": "string",
                "default": "14:00"
            },
            "shift_5_end": {
                "type": "string",
                "default": "21:30"
            },
            "shift_5_label": {
                "type": "string",
                "default": "V"
            }
        }
    },
    "tables": [
        "base_workweeks"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "bots.ready",
            "assistant.write.preview",
            "assistant.system.hints",
            "bi.datasets",
            "bi.derive_steps",
            "bi.recipes"
        ],
        "publish": []
    },
    "bulkActions": [
        {
            "list_id": "workweeks",
            "action": "delete"
        }
    ],
    "catalog": {
        "categories": [
            "team"
        ],
        "maturity": "release",
        "tags": [],
        "screenshots": []
    }
}
