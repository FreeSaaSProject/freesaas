{
    "id": "workweeks",
    "name": "workweeks.module.name",
    "description": "workweeks.module.description",
    "version": "0.2.2",
    "type": "product",
    "runtime": "both",
    "requires": {
        "core": ">=0.3.0"
    },
    "optionalRequires": {
        "comments": ">=0.1.0",
        "cabinets": ">=0.1.0",
        "tables": ">=0.1.0",
        "bots": ">=0.1.0"
    },
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "workweeks.view",
            "label": "workweeks.perm.view"
        },
        {
            "id": "workweeks.edit",
            "label": "workweeks.perm.edit"
        }
    ],
    "routes": {
        "pages": [
            "/workweeks",
            "/workweeks/new",
            "/workweeks/{id}/edit",
            "/workweeks/nazop",
            "/workweeks/settings",
            "/workweeks/day/{date}"
        ]
    },
    "agent": {
        "docs": "docs/agents/workweeks.md",
        "ops": [
            {
                "id": "workweeks.list",
                "method": "GET",
                "path": "/workweeks",
                "permission": "workweeks.view",
                "description": "List shift rows; filters: q, user_id, date_from, date_to"
            },
            {
                "id": "workweeks.get",
                "method": "GET",
                "path": "/workweeks/{id}/edit",
                "permission": "workweeks.edit",
                "description": "One shift edit payload (requires assign permission)"
            },
            {
                "id": "workweeks.create",
                "method": "POST",
                "path": "/workweeks/new",
                "permission": "workweeks.edit",
                "description": "Create shift; date, id_operator, price_col, mas_max, id_table"
            },
            {
                "id": "workweeks.update",
                "method": "POST",
                "path": "/workweeks/{id}/edit",
                "permission": "workweeks.edit",
                "description": "Update shift row"
            },
            {
                "id": "workweeks.day",
                "method": "GET",
                "path": "/workweeks/day/{date}",
                "permission": "workweeks.view",
                "description": "Shifts on one calendar day (YYYY-MM-DD)"
            },
            {
                "id": "workweeks.settings.get",
                "method": "GET",
                "path": "/workweeks/settings",
                "permission": "workweeks.view",
                "description": "Workweeks settings (superadmin capability on route)"
            },
            {
                "id": "workweeks.settings.update",
                "method": "POST",
                "path": "/workweeks/settings",
                "permission": "workweeks.view",
                "description": "Save shift windows (PRICE_COL 1–5) and schedule news id (superadmin capability on route)"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.team",
            "num": 3,
            "path": "/workweeks",
            "title": "workweeks.menu.list"
        },
        {
            "group": "core.menu.group.team",
            "num": 90,
            "kind": "settings",
            "path": "/workweeks/settings",
            "title": "workweeks.menu.settings",
            "permission": "workweeks.view",
            "capability": "SUPERADMIN_ACCESS"
        }
    ],
    "configSchema": {
        "workweeks": {
            "schedule_news_id": {
                "type": "integer",
                "default": 0
            },
            "shift_1_start": {
                "type": "string",
                "default": "00:00"
            },
            "shift_1_end": {
                "type": "string",
                "default": "15:30"
            },
            "shift_1_label": {
                "type": "string",
                "default": "I"
            },
            "shift_2_start": {
                "type": "string",
                "default": "15:30"
            },
            "shift_2_end": {
                "type": "string",
                "default": "23:59"
            },
            "shift_2_label": {
                "type": "string",
                "default": "II"
            },
            "shift_3_start": {
                "type": "string",
                "default": "00:00"
            },
            "shift_3_end": {
                "type": "string",
                "default": "23:59"
            },
            "shift_3_label": {
                "type": "string",
                "default": "I+II"
            },
            "shift_4_start": {
                "type": "string",
                "default": "09:30"
            },
            "shift_4_end": {
                "type": "string",
                "default": "17:00"
            },
            "shift_4_label": {
                "type": "string",
                "default": "IV"
            },
            "shift_5_start": {
                "type": "string",
                "default": "14:00"
            },
            "shift_5_end": {
                "type": "string",
                "default": "21:30"
            },
            "shift_5_label": {
                "type": "string",
                "default": "V"
            }
        }
    },
    "tables": [
        "base_workweeks"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [],
        "publish": []
    },
    "bulkActions": [
        {
            "list_id": "workweeks",
            "action": "delete"
        }
    ],
    "catalog": {
        "categories": [
            "team"
        ],
        "maturity": "beta",
        "tags": [],
        "screenshots": []
    }
}
