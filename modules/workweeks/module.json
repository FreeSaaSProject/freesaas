{
    "id": "workweeks",
    "name": "workweeks.module.name",
    "version": "0.2.0",
    "type": "product",
    "requires": {
        "core": ">=0.3.0"
    },
    "optionalRequires": {
        "comments": ">=0.1.0",
        "cabinets": ">=0.1.0",
        "tables": ">=0.1.0"
    },
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "workweeks.view",
            "label": "workweeks.perm.view"
        },
        {
            "id": "workweeks.edit",
            "label": "workweeks.perm.edit"
        }
    ],
    "routes": {
        "pages": [
            "/workweeks",
            "/workweeks/new",
            "/workweeks/{id}/edit",
            "/workweeks/nazop",
            "/workweeks/settings",
            "/workweeks/day/{date}"
        ]
    },
    "agent": {
        "ops": [
            {
                "id": "workweeks.list",
                "method": "GET",
                "path": "/workweeks",
                "permission": "workweeks.view",
                "description": "List shift rows; filters: q, user_id, date_from, date_to"
            },
            {
                "id": "workweeks.get",
                "method": "GET",
                "path": "/workweeks/{id}/edit",
                "permission": "workweeks.edit",
                "description": "One shift edit payload (requires assign permission)"
            },
            {
                "id": "workweeks.create",
                "method": "POST",
                "path": "/workweeks/new",
                "permission": "workweeks.edit",
                "description": "Create shift; date, id_operator, price_col, mas_max, id_table"
            },
            {
                "id": "workweeks.update",
                "method": "POST",
                "path": "/workweeks/{id}/edit",
                "permission": "workweeks.edit",
                "description": "Update shift row"
            },
            {
                "id": "workweeks.day",
                "method": "GET",
                "path": "/workweeks/day/{date}",
                "permission": "workweeks.view",
                "description": "Shifts on one calendar day (YYYY-MM-DD)"
            },
            {
                "id": "workweeks.settings.get",
                "method": "GET",
                "path": "/workweeks/settings",
                "permission": "workweeks.view",
                "description": "Workweeks settings (superadmin capability on route)"
            },
            {
                "id": "workweeks.settings.update",
                "method": "POST",
                "path": "/workweeks/settings",
                "permission": "workweeks.view",
                "description": "Save schedule news id for shift logging (superadmin capability on route)"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.team",
            "num": 3,
            "path": "/workweeks",
            "title": "workweeks.menu.list"
        },
        {
            "group": "core.menu.group.team",
            "num": 90,
            "kind": "settings",
            "path": "/workweeks/settings",
            "title": "workweeks.menu.settings",
            "permission": "workweeks.view",
            "capability": "SUPERADMIN_ACCESS"
        }
    ],
    "configSchema": {
        "workweeks": {
            "schedule_news_id": {
                "type": "integer",
                "default": 0
            }
        }
    },
    "tables": [
        "base_workweeks"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [],
        "publish": []
    },
    "bulkActions": [
        {
            "list_id": "workweeks",
            "action": "delete"
        }
    ]
}
