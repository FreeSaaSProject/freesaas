{
    "id": "suppliers",
    "name": "suppliers.module.name",
    "description": "suppliers.module.description",
    "version": "0.1.1",
    "type": "product",
    "requires": {
        "core": ">=0.3.0"
    },
    "optionalRequires": [],
    "provides": [
        "suppliers.list"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "suppliers.view",
            "label": "suppliers.perm.view"
        },
        {
            "id": "suppliers.edit",
            "label": "suppliers.perm.edit"
        }
    ],
    "routes": {
        "pages": [
            "/suppliers",
            "/suppliers/new",
            "/suppliers/{id}/edit"
        ]
    },
    "agent": {
        "ops": [
            {
                "id": "suppliers.list",
                "method": "GET",
                "path": "/suppliers",
                "permission": "suppliers.view",
                "description": "List suppliers; filters: q, enabled. Try q in Cyrillic and Latin (озон/ozon/OZON)."
            },
            {
                "id": "suppliers.get",
                "method": "GET",
                "path": "/suppliers/{id}/edit",
                "permission": "suppliers.edit",
                "description": "One supplier edit payload"
            },
            {
                "id": "suppliers.create",
                "method": "POST",
                "path": "/suppliers/new",
                "permission": "suppliers.edit",
                "description": "Create supplier"
            },
            {
                "id": "suppliers.update",
                "method": "POST",
                "path": "/suppliers/{id}/edit",
                "permission": "suppliers.edit",
                "description": "Update supplier"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.dictionaries",
            "num": 3,
            "path": "/suppliers",
            "title": "suppliers.menu.list"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_suppliers"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [],
        "publish": []
    },
    "bulkActions": [
        {
            "list_id": "suppliers",
            "action": "delete"
        }
    ],
    "catalog": {
        "categories": [
            "dictionaries"
        ],
        "maturity": "beta",
        "tags": [],
        "screenshots": []
    }
}
