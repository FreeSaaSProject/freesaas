{
    "id": "audio_pipeline",
    "name": "audio_pipeline.module.name",
    "description": "audio_pipeline.module.description",
    "version": "1.0.11",
    "type": "product",
    "requires": {
        "core": ">=1.0.0",
        "asr": ">=1.0.0",
        "audio": ">=1.0.0",
        "audio_dicts": ">=1.0.0"
    },
    "optionalRequires": {
        "procedures": ">=1.0.0"
    },
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "audio_pipeline.view",
            "label": "audio_pipeline.perm.view"
        }
    ],
    "routes": {
        "pages": [
            "/audio/asr/claim",
            "/audio/asr/result",
            "/audio/asr/chunk-claim",
            "/audio/asr/chunk-result",
            "/audio/jobs/ingest",
            "/audio/jobs/ingest/run",
            "/audio/jobs/stem",
            "/audio/jobs/stem/run",
            "/audio/jobs/collect",
            "/agent/audio_pipeline/day-diag",
            "/agent/audio_pipeline/day-records",
            "/agent/audio_pipeline/record",
            "/agent/audio_pipeline/collections",
            "/agent/audio_pipeline/collection",
            "/agent/audio_pipeline/instances",
            "/agent/audio_pipeline/day-reparse",
            "/agent/audio_pipeline/backfill-playtime"
        ]
    },
    "agent": {
        "docs": "docs/agents/audio_pipeline.md",
        "ops": [
            {
                "id": "audio_pipeline.day_diag",
                "method": "GET",
                "path": "/agent/audio_pipeline/day-diag",
                "permission": "public",
                "assistant": false,
                "description": "Agent-token diagnose: records/instances/collections for admin+date; script fingerprint (see audio-scripts-debug.md)"
            },
            {
                "id": "audio_pipeline.day_records",
                "method": "GET",
                "path": "/agent/audio_pipeline/day-records",
                "permission": "public",
                "assistant": false,
                "description": "Agent-token: cabin records for admin+date; optional transcription=1"
            },
            {
                "id": "audio_pipeline.record_get",
                "method": "GET",
                "path": "/agent/audio_pipeline/record",
                "permission": "public",
                "assistant": false,
                "description": "Agent-token: one record + transcription + instances; query id="
            },
            {
                "id": "audio_pipeline.collections_list",
                "method": "GET",
                "path": "/agent/audio_pipeline/collections",
                "permission": "public",
                "assistant": false,
                "description": "Agent-token: script collections for admin+date; optional script="
            },
            {
                "id": "audio_pipeline.collection_get",
                "method": "GET",
                "path": "/agent/audio_pipeline/collection",
                "permission": "public",
                "assistant": false,
                "description": "Agent-token: one collection + collections_datas hits; query id="
            },
            {
                "id": "audio_pipeline.instances_list",
                "method": "GET",
                "path": "/agent/audio_pipeline/instances",
                "permission": "public",
                "assistant": false,
                "description": "Agent-token: key instances (вхождения) for admin+date; optional record=, key=; includes by_key"
            },
            {
                "id": "audio_pipeline.day_reparse",
                "method": "POST",
                "path": "/agent/audio_pipeline/day-reparse",
                "permission": "public",
                "assistant": false,
                "side_effect": "write",
                "description": "Agent-token: reset+stem+collect for admin+date; body confirm=1"
            },
            {
                "id": "audio_pipeline.backfill_playtime",
                "method": "POST",
                "path": "/agent/audio_pipeline/backfill-playtime",
                "permission": "public",
                "assistant": false,
                "side_effect": "write",
                "description": "Agent-token: backfill PLAYTIME=0 from transcript cue end; body date=, admin=, dry_run=1|0, confirm=1 when writing"
            },
            {
                "id": "audio_pipeline.asr.claim",
                "method": "GET",
                "path": "/audio/asr/claim",
                "permission": "audio_pipeline.view",
                "assistant": false,
                "description": "Whisper worker: claim next file (X-Audio-Token); ?format=json for envelope"
            },
            {
                "id": "audio_pipeline.asr.result",
                "method": "POST",
                "path": "/audio/asr/result",
                "permission": "audio_pipeline.view",
                "assistant": false,
                "description": "Whisper worker: post ASR result for file_name"
            },
            {
                "id": "audio_pipeline.asr.chunk_claim",
                "method": "GET",
                "path": "/audio/asr/chunk-claim",
                "permission": "audio_pipeline.view",
                "assistant": false,
                "description": "Chunk ASR worker: claim next chunk"
            },
            {
                "id": "audio_pipeline.asr.chunk_result",
                "method": "POST",
                "path": "/audio/asr/chunk-result",
                "permission": "audio_pipeline.view",
                "assistant": false,
                "description": "Chunk ASR worker: post chunk result"
            },
            {
                "id": "audio_pipeline.jobs.ingest",
                "method": "GET",
                "path": "/audio/jobs/ingest",
                "permission": "audio_pipeline.view",
                "assistant": false,
                "description": "Enqueue inbox ingest (HTTP 202). Auth: ?token= or X-Audio-Token. Cron drain: audio_pipeline.ingest every 5m + ingest_nightly 02:00. Sync: /audio/jobs/ingest/run"
            },
            {
                "id": "audio_pipeline.jobs.ingest_run",
                "method": "GET",
                "path": "/audio/jobs/ingest/run",
                "permission": "audio_pipeline.view",
                "assistant": false,
                "description": "Sync inbox ingest (blocking). Optional importBrokenDate=1"
            },
            {
                "id": "audio_pipeline.jobs.stem",
                "method": "POST",
                "path": "/audio/jobs/stem",
                "permission": "audio_pipeline.view",
                "assistant": false,
                "description": "Enqueue stem/day (HTTP 202, day=YYYY-MM-DD). Cron: audio_pipeline.stem every 5m + stem_nightly. Sync/reset/score: /audio/jobs/stem/run"
            },
            {
                "id": "audio_pipeline.jobs.stem_run",
                "method": "POST",
                "path": "/audio/jobs/stem/run",
                "permission": "audio_pipeline.view",
                "assistant": false,
                "description": "Sync stem/collect/publish (blocking); reset=1, score=1"
            },
            {
                "id": "audio_pipeline.jobs.collect",
                "method": "POST",
                "path": "/audio/jobs/collect",
                "permission": "audio_pipeline.view",
                "assistant": false,
                "description": "Cron script collection job (X-Audio-Token); optional full=1"
            }
        ]
    },
    "jobs": [
        "GET|POST /audio/jobs/ingest",
        "GET|POST /audio/jobs/ingest/run",
        "GET|POST /audio/jobs/stem",
        "GET|POST /audio/jobs/stem/run",
        "GET|POST /audio/jobs/collect"
    ],
    "menu": [],
    "configSchema": [],
    "tables": [
        "base_records_instances",
        "base_records_collections",
        "base_records_collections_datas",
        "base_records_stem_word_cache",
        "base_records_stem_key_cache",
        "base_records_coverage_profiles"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "audio_dicts.changed",
            "audio.settings.sections",
            "audio.settings.save"
        ],
        "publish": [
            "audio_pipeline.collect.after_admin"
        ]
    },
    "catalog": {
        "categories": [
            "audio"
        ],
        "maturity": "release",
        "tags": [],
        "screenshots": []
    },
    "setup": {
        "steps": [
            {
                "id": "ready",
                "title": "audio_pipeline.setup.step.ready",
                "description": "audio_pipeline.setup.step.ready_help",
                "href": "/audio_pipeline",
                "ask_user": "audio_pipeline.setup.ask.ready",
                "choices": [
                    {
                        "id": "open",
                        "label": "audio_pipeline.setup.choice.open",
                        "recommended": true
                    },
                    {
                        "id": "defer",
                        "label": "core.modules.setup.choice.defer",
                        "recommended": false
                    }
                ],
                "agent_can": [
                    "mark_done"
                ]
            }
        ]
    }
}
