{
    "id": "assistant",
    "name": "assistant.module.name",
    "description": "assistant.module.description",
    "version": "1.0.1",
    "type": "product",
    "requires": {
        "core": ">=1.0.0",
        "llm": ">=1.0.0"
    },
    "optionalRequires": {
        "bots": ">=1.0.0",
        "procedures": ">=1.0.0",
        "staff_reports": ">=1.0.0",
        "audio_reports": ">=1.0.0",
        "terminals": ">=1.0.0",
        "updates": ">=1.0.0"
    },
    "provides": [
        "assistant.harness"
    ],
    "migrations": "migrations/",
    "permissions": [],
    "routes": {
        "pages": [
            "/assistant",
            "/assistant/chat",
            "/assistant/confirm",
            "/assistant/clear",
            "/assistant/feedback",
            "/assistant/prefs",
            "/assistant/fab/hide",
            "/assistant/eval"
        ]
    },
    "agent": {
        "docs": "docs/agents/assistant.md",
        "ops": [
            {
                "id": "assistant.chat",
                "method": "POST",
                "path": "/assistant/chat",
                "side_effect": "read",
                "assistant": false,
                "description": "Run assistant harness; body: message (preferred) or messages[] (role/content); shared per-user history. Available to every signed-in staff user."
            },
            {
                "id": "assistant.confirm",
                "method": "POST",
                "path": "/assistant/confirm",
                "side_effect": "write",
                "assistant": false,
                "description": "Confirm or cancel a pending write tool; body: token, action=confirm|cancel"
            },
            {
                "id": "assistant.clear",
                "method": "POST",
                "path": "/assistant/clear",
                "side_effect": "write",
                "assistant": false,
                "description": "Clear shared dialog history and cancel pending confirms for the current user"
            },
            {
                "id": "assistant.feedback",
                "method": "POST",
                "path": "/assistant/feedback",
                "side_effect": "write",
                "assistant": false,
                "description": "Rate an assistant reply; body: rating=good|bad, reasons[], comment, messages[] (context). Stored under var/assistant/feedback/"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "llm.menu.group",
            "num": 10,
            "path": "/assistant",
            "title": "assistant.menu.chat"
        },
        {
            "group": "llm.menu.group",
            "kind": "settings",
            "num": 15,
            "path": "/assistant/prefs",
            "title": "assistant.menu.prefs"
        },
        {
            "group": "llm.menu.group",
            "kind": "settings",
            "num": 20,
            "path": "/assistant/eval",
            "title": "assistant.menu.eval",
            "capability": "SUPERADMIN_ACCESS"
        }
    ],
    "tables": [
        "base_assistant_pending",
        "base_assistant_dialog"
    ],
    "migrators": [],
    "configSchema": {
        "assistant": {
            "name": {
                "type": "string",
                "default": "Макс"
            }
        }
    },
    "hooks": {
        "subscribe": [
            "bots.ready",
            "core.dashboard.command_html",
            "core.menu.items",
            "core.settings.sections",
            "core.settings.save",
            "core.layout.gate"
        ],
        "publish": [
            "bots.send",
            "assistant.write.preview",
            "assistant.system.hints"
        ]
    },
    "catalog": {
        "categories": [
            "integrations"
        ],
        "maturity": "release",
        "tags": [],
        "screenshots": []
    }
}
