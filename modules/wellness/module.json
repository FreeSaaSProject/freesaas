{
    "id": "wellness",
    "name": "wellness.module.name",
    "description": "wellness.module.description",
    "version": "0.2.19",
    "type": "product",
    "requires": {
        "core": ">=0.3.0"
    },
    "optionalRequires": {
        "asr": ">=0.1.0",
        "bots": ">=0.1.0"
    },
    "provides": [
        "wellness.calendar"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "wellness.view",
            "label": "wellness.perm.view"
        },
        {
            "id": "wellness.edit",
            "label": "wellness.perm.edit"
        },
        {
            "id": "wellness.delete",
            "label": "wellness.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/wellness",
            "/wellness/calendar",
            "/wellness/food-diary",
            "/wellness/food-diary/new",
            "/wellness/food-diary/{id}/edit",
            "/wellness/foods",
            "/wellness/foods/new",
            "/wellness/foods/{id}/edit",
            "/wellness/workouts",
            "/wellness/workouts/new",
            "/wellness/workouts/{id}/edit",
            "/wellness/weight",
            "/wellness/weight/new",
            "/wellness/weight/{id}/edit",
            "/wellness/targets",
            "/wellness/targets/new",
            "/wellness/targets/{id}/edit",
            "/wellness/health-diary",
            "/wellness/health-diary/new",
            "/wellness/health-diary/{id}/edit",
            "/wellness/doctor-rx",
            "/wellness/doctor-rx/new",
            "/wellness/doctor-rx/{id}/edit",
            "/wellness/medicines",
            "/wellness/medicines/new",
            "/wellness/medicines/{id}/edit",
            "/wellness/symptoms",
            "/wellness/symptoms/new",
            "/wellness/symptoms/{id}/edit"
        ]
    },
    "agent": {
        "docs": "docs/agents/wellness.md",
        "ops": [
            {
                "id": "wellness.calendar.month",
                "method": "GET",
                "path": "/wellness/calendar",
                "permission": "wellness.view",
                "side_effect": "read",
                "description": "Current-user month overview: eaten/burned kcal series, weight, day markers",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "year": {
                            "type": "integer",
                            "description": "Calendar year"
                        },
                        "month": {
                            "type": "integer",
                            "description": "Month 1-12"
                        }
                    },
                    "additionalProperties": true
                }
            },
            {
                "id": "wellness.food_diary.list",
                "method": "GET",
                "path": "/wellness",
                "permission": "wellness.view",
                "description": "List own food diary for a day (default today); morning→evening; meals grouped by >2h gaps (breakfast…snacks) with per-meal weight/kcal totals; also workouts/health/target",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "date": {
                            "type": "string",
                            "description": "Day Y-m-d"
                        },
                        "q": {
                            "type": "string",
                            "description": "Search query"
                        }
                    },
                    "additionalProperties": true
                }
            },
            {
                "id": "wellness.food_diary.get",
                "method": "GET",
                "path": "/wellness/food-diary/{id}/edit",
                "permission": "wellness.edit",
                "description": "Get one own food diary entry",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "integer",
                            "description": "Record id (path)"
                        }
                    },
                    "additionalProperties": true,
                    "required": [
                        "id"
                    ]
                }
            },
            {
                "id": "wellness.food_diary.create",
                "method": "POST",
                "path": "/wellness/food-diary/new",
                "permission": "wellness.edit",
                "description": "Log one food diary entry NOW (food_id + weight grams). First wellness.foods.list(q=…). For several foods call this tool once per item in the same step. UI Confirm buttons appear after the call.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "food_id": {
                            "type": "integer",
                            "description": "Own food catalog id from wellness.foods.list"
                        },
                        "weight": {
                            "type": "number",
                            "description": "Grams eaten"
                        },
                        "dt": {
                            "type": "string",
                            "description": "Optional date/time; default now"
                        }
                    },
                    "additionalProperties": true,
                    "required": [
                        "food_id",
                        "weight"
                    ]
                }
            },
            {
                "id": "wellness.food_diary.update",
                "method": "POST",
                "path": "/wellness/food-diary/{id}/edit",
                "permission": "wellness.edit",
                "description": "Update own food diary entry",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "integer",
                            "description": "Record id (path)"
                        },
                        "food_id": {
                            "type": "integer"
                        },
                        "weight": {
                            "type": "number"
                        },
                        "dt": {
                            "type": "string",
                            "description": "Date/time (Y-m-d or Y-m-d H:i:s or datetime-local)"
                        }
                    },
                    "additionalProperties": true,
                    "required": [
                        "id",
                        "food_id",
                        "weight"
                    ]
                }
            },
            {
                "id": "wellness.foods.list",
                "method": "GET",
                "path": "/wellness/foods",
                "permission": "wellness.view",
                "description": "Search/list the current user's private food catalog (name match via q). Call this before wellness.foods.create to reuse an existing food when possible; returns id, name, ccals/carbs/proteins/fats per 100g",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "q": {
                            "type": "string",
                            "description": "Food name fragment to search (e.g. apple, гречка)"
                        }
                    },
                    "additionalProperties": true
                }
            },
            {
                "id": "wellness.foods.get",
                "method": "GET",
                "path": "/wellness/foods/{id}/edit",
                "permission": "wellness.edit",
                "description": "Get one own food",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "integer",
                            "description": "Record id (path)"
                        }
                    },
                    "additionalProperties": true,
                    "required": [
                        "id"
                    ]
                }
            },
