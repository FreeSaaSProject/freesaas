                "method": "POST",
                "path": "/wellness/foods/new",
                "permission": "wellness.edit",
                "description": "Create a new private food only if wellness.foods.list found no suitable match; nutrition values are per 100g",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "ccals": {
                            "type": "integer"
                        },
