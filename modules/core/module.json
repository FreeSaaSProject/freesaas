{
    "id": "core",
    "name": "core.module.name",
    "version": "0.3.0",
    "type": "platform",
    "requires": {},
    "optionalRequires": {
        "bots": ">=0.1.0"
    },
    "provides": [
        "core.auth",
        "core.modules",
        "core.dashboard",
        "core.news",
        "core.users",
        "core.statuses",
        "core.settings"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "core.home",
            "label": "core.perm.home"
        },
        {
            "id": "core.modules",
            "label": "core.perm.modules"
        },
        {
            "id": "core.db",
            "label": "core.perm.db"
        },
        {
            "id": "core.users",
            "label": "core.perm.users"
        },
        {
            "id": "core.statuses",
            "label": "core.perm.statuses"
        },
        {
            "id": "core.news",
            "label": "core.perm.news"
        },
        {
            "id": "core.settings",
            "label": "core.perm.settings"
        }
    ],
    "routes": {
        "pages": [
            "/",
            "/dashboard",
            "/login",
            "/locale",
            "/logout",
            "/modules",
            "/db",
            "/users",
            "/users/new",
            "/users/{id}",
            "/users/{id}/edit",
            "/statuses",
            "/statuses/new",
            "/statuses/{id}/edit",
            "/news",
            "/news/new",
            "/news/{id}",
            "/news/{id}/edit",
            "/settings",
            "/health",
            "/health/detail",
            "/agent",
            "/agent/bootstrap",
            "/agent/system/status",
            "/agent/modules",
            "/agent/modules/{id}",
            "/agent/modules/{id}/enable",
            "/agent/modules/{id}/disable",
            "/agent/modules/{id}/validate",
            "/agent/validate",
            "/agent/db",
            "/agent/db/migrate",
            "/agent/db/migrate/run",
            "/agent/db/dump",
            "/agent/db/dumps",
            "/agent/db/dump/file",
            "/agent/db/restore",
            "/agent/db/dump/delete",
            "/agent/db/check",
            "/agent/db/repair",
            "/agent/db/optimize",
            "/agent/locale",
            "/agent/locale/validate",
            "/agent/health",
            "/agent/i18n"
        ]
    },
    "agent": {
        "ops": [
            {
                "id": "core.users.list",
                "method": "GET",
                "path": "/users",
                "permission": "core.users",
                "description": "List staff users; filters: q, enabled, status_id",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "q": { "type": "string" },
                        "enabled": { "type": "string", "description": "1 active, 0 disabled, empty=all" },
                        "status_id": { "type": "integer", "description": "Filter by role ID_STATUS" }
                    }
                }
            },
            {
                "id": "core.users.get",
                "method": "GET",
                "path": "/users/{id}",
                "permission": "core.users",
                "description": "Staff card with permissions map (password omitted)"
            },
            {
                "id": "core.users.get_edit",
                "method": "GET",
                "path": "/users/{id}/edit",
                "permission": "core.users",
                "description": "Edit payload + permission_groups, admin_statuses, partner_statuses; optional copyFrom=userId"
            },
            {
                "id": "core.users.copy_sources",
                "method": "GET",
                "path": "/users/new",
                "permission": "core.users",
                "side_effect": "read",
                "description": "List non-superadmin staff templates for copyFrom (copy_users). Use before clone/create. Superadmin roles are omitted."
            },
            {
                "id": "core.users.create",
                "method": "POST",
                "path": "/users/new",
                "permission": "core.users",
                "side_effect": "write",
                "description": "Create staff user without password. Required: name. Prefer tel (login auto from phone). Optional copyFrom=template userId (non-superadmin only). Server hashes a random password; agents never send/receive passwords.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "name": { "type": "string", "description": "Full name" },
                        "tel": { "type": "string", "description": "Phone; used as login when login omitted" },
                        "mail": { "type": "string" },
                        "login": { "type": "string", "description": "Optional; default from tel digits" },
                        "ID_STATUS": { "type": "integer", "description": "Role id" },
                        "ID_STATUS2": { "type": "integer" },
                        "enabled": { "type": "string" },
                        "copyFrom": { "type": "integer", "description": "Non-superadmin template user id" },
                        "NOT_IN_TEAM": { "type": "string" },
                        "ASSIST_TEAM": { "type": "string" }
                    },
                    "required": ["name"]
                }
            },
            {
                "id": "core.users.clone",
                "method": "POST",
                "path": "/users/new",
                "permission": "core.users",
                "side_effect": "write",
                "description": "Clone a non-superadmin staff template (copyFrom required): role, flags, permissions. Required: name, copyFrom. Prefer tel. No password in or out. Same handler as create.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "copyFrom": { "type": "integer", "description": "Source staff id (not superadmin)" },
                        "name": { "type": "string" },
                        "tel": { "type": "string" },
                        "mail": { "type": "string" },
                        "login": { "type": "string" },
                        "enabled": { "type": "string", "description": "Default 1" }
                    },
                    "required": ["copyFrom", "name"]
                }
            },
            {
                "id": "core.users.update",
                "method": "POST",
                "path": "/users/{id}/edit",
                "permission": "core.users",
                "side_effect": "write",
                "description": "Update staff user; permissions[key]=1/0; enabled=1/0 to enable/disable. Agent/JSON cannot change password (ignored)."
            },
            {
                "id": "core.statuses.list",
                "method": "GET",
                "path": "/statuses",
                "permission": "core.statuses",
                "description": "List staff roles (base_admin_statuses) with capability flags"
            },
            {
                "id": "core.statuses.get",
                "method": "GET",
                "path": "/statuses/{id}/edit",
                "permission": "core.statuses",
                "description": "One role + editable field groups"
            },
            {
                "id": "core.statuses.create",
                "method": "POST",
                "path": "/statuses/new",
                "permission": "core.statuses",
                "side_effect": "write",
                "description": "Create staff role/status"
            },
            {
                "id": "core.statuses.update",
                "method": "POST",
                "path": "/statuses/{id}/edit",
                "permission": "core.statuses",
                "side_effect": "write",
                "description": "Update staff role/status flags"
            },
            {
                "id": "core.db.status",
                "method": "GET",
                "path": "/db",
                "permission": "core.db",
                "description": "DB hub status: schema setup, owned tables, dumps (?format=json)",
                "assistant": false
            },
            {
                "id": "core.db.run_schema",
                "method": "POST",
                "path": "/db",
                "permission": "core.db",
                "description": "Apply all pending schema migrations (POST action=schema&format=json)",
                "assistant": false
            },
            {
                "id": "core.db.run_data",
                "method": "POST",
                "path": "/db",
                "permission": "core.db",
                "description": "Run data migrators replace mode (POST action=data&format=json; optional)",
                "assistant": false
            },
            {
                "id": "core.db.dump",
                "method": "POST",
                "path": "/db",
                "permission": "core.db",
                "description": "Dump owned tables (POST action=db_dump&format=json)",
                "assistant": false
            },
            {
                "id": "core.db.restore",
                "method": "POST",
                "path": "/db",
                "permission": "core.db",
                "description": "Restore dump file (POST action=db_restore&file=…&format=json; owned allow-list in normal mode)",
                "assistant": false
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "core.menu.group.desktop",
            "num": 1,
            "path": "/",
            "title": "core.menu.home"
        },
        {
            "group": "core.menu.group.desktop",
            "num": 2,
            "path": "/news?type=2",
            "title": "core.menu.news"
        },
        {
            "group": "core.menu.group.team",
            "num": 1,
            "path": "/users",
            "title": "core.menu.users"
        },
        {
            "group": "core.menu.group.team",
            "kind": "crud",
            "num": 2,
            "path": "/statuses",
            "title": "core.menu.statuses"
        },
        {
            "group": "core.menu.group.system",
            "num": 1,
            "path": "/settings",
            "title": "core.menu.settings"
        },
        {
            "group": "core.menu.group.system",
            "num": 2,
            "path": "/modules",
            "title": "core.menu.modules"
        },
        {
            "group": "core.menu.group.system",
            "kind": "settings",
            "num": 3,
            "path": "/db",
            "title": "core.menu.db"
        }
    ],
    "configSchema": {
        "app": {
            "name": {
                "type": "string",
                "default": "FreeSaaS"
            },
            "instance": {
                "type": "string",
                "default": ""
            },
            "locale": {
                "type": "string",
                "default": "ru"
            }
        }
    },
    "tables": [
        "base_users",
        "base_system",
        "base_modules",
        "base_schema_migrations",
        "base_news",
        "base_news_statuses",
        "base_news_logs",
        "base_admin_statuses",
        "base_views",
        "base_likes",
        "base_user_prefs"
    ],
    "migrators": [
        {
            "id": "phpshop_users_to_base_users",
            "mode": "replace",
            "source": [
                "phpshop_users"
            ],
            "target": [
                "base_users"
            ]
        },
        {
            "id": "phpshop_system_to_base_system",
            "mode": "replace",
            "source": [
                "phpshop_system"
            ],
            "target": [
                "base_system"
            ]
        }
    ],
    "hooks": {
        "subscribe": [
            "comments.form.ticket_controls",
            "comments.prepare_add"
        ],
        "publish": [
            "core.auth.after_login",
            "core.auth.before_logout",
            "core.dashboard.catalog",
            "core.dashboard.widgets",
            "core.notices.collect",
            "core.layout.gate",
            "core.news_item.handle_post",
            "core.news_item.meta",
            "core.news_item.section",
            "core.user_edit.sections",
            "core.user_edit.save",
            "core.user_edit.profile",
            "core.users.list",
            "core.settings.sections",
            "core.settings.save",
            "core.bulk.check_item",
            "comments.counts"
        ]
    }
}
