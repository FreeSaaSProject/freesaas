{
    "id": "core",
    "name": "core.module.name",
    "description": "core.module.description",
    "version": "0.3.89",
    "type": "platform",
    "requires": [],
    "optionalRequires": {
        "bots": ">=0.1.0",
        "contracts": ">=0.1.0",
        "gcal": ">=0.1.0",
        "stocks": ">=0.1.0",
        "assistant": ">=0.1.0"
    },
    "provides": [
        "core.auth",
        "core.modules",
        "core.dashboard",
        "core.news",
        "core.users",
        "core.statuses",
        "core.settings"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "core.home",
            "label": "core.perm.home"
        },
        {
            "id": "core.modules",
            "label": "core.perm.modules"
        },
        {
            "id": "core.db",
            "label": "core.perm.db"
        },
        {
            "id": "core.users",
            "label": "core.perm.users"
        },
        {
            "id": "core.statuses",
            "label": "core.perm.statuses"
        },
        {
            "id": "core.news",
            "label": "core.perm.news"
        },
        {
            "id": "core.news_statuses",
            "label": "core.perm.news_statuses"
        },
        {
            "id": "core.settings",
            "label": "core.perm.settings"
        },
        {
            "id": "core.users.delete",
            "label": "core.perm.users_delete"
        },
        {
            "id": "core.statuses.delete",
            "label": "core.perm.statuses_delete"
        },
        {
            "id": "core.news.delete",
            "label": "core.perm.news_delete"
        },
        {
            "id": "core.news_statuses.delete",
            "label": "core.perm.news_statuses_delete"
        }
    ],
    "routes": {
        "pages": [
            "/",
            "/splash/ack",
            "/dashboard",
            "/likes/mark-viewed",
            "/login",
            "/login/t/{token}",
            "/locale",
            "/logout",
            "/modules",
            "/modules/{id}",
            "/db",
            "/users",
            "/users/new",
            "/users/{id}",
            "/users/{id}/edit",
            "/statuses",
            "/statuses/new",
            "/statuses/{id}/edit",
            "/news",
            "/news/new",
            "/news/{id}",
            "/news/{id}/edit",
            "/news-statuses",
            "/news-statuses/new",
            "/news-statuses/{id}/edit",
            "/settings",
            "/health",
            "/health/detail",
            "/doctor",
            "/help",
            "/help/{id}",
            "/agent",
            "/agent/bootstrap",
            "/agent/rescue",
            "/agent/system/status",
            "/agent/modules",
            "/agent/modules/{id}",
            "/agent/modules/{id}/enable",
            "/agent/modules/{id}/install",
            "/agent/modules/{id}/uninstall",
            "/agent/modules/{id}/disable",
            "/agent/modules/{id}/validate",
            "/agent/validate",
            "/agent/db",
            "/agent/db/migrate",
            "/agent/db/migrate/run",
            "/agent/db/dump",
            "/agent/db/dumps",
            "/agent/db/dump/file",
            "/agent/db/restore",
            "/agent/db/dump/delete",
            "/agent/db/check",
            "/agent/db/repair",
            "/agent/db/optimize",
            "/agent/locale",
            "/agent/locale/validate",
            "/agent/health",
            "/agent/doctor",
            "/agent/i18n",
            "/agent/update",
            "/agent/update/check",
            "/agent/update/apply",
            "/core/jobs/habits-reminders",
            "/cron",
            "/cron/tick",
            "/cron/status"
        ]
    },
    "agent": {
        "docs": "docs/agents/core.md",
        "ops": [
            {
                "id": "core.cron.status",
                "method": "GET",
                "path": "/cron/status",
                "permission": "",
                "side_effect": "read",
                "assistant": false,
                "description": "Cron registry + recent runs + stale_hint. Auth: X-FreeSaaS-Agent-Token."
            },
            {
                "id": "core.cron.tick",
                "method": "POST",
                "path": "/cron/tick",
                "permission": "",
                "side_effect": "write",
                "assistant": false,
                "description": "Platform cron tick: run due Cron::register jobs. Auth: X-FreeSaaS-Agent-Token. Optional job=id, force=1. Prefer this over per-module worker curls."
            },
            {
                "id": "core.cron.ui",
                "method": "GET",
                "path": "/cron",
                "permission": "",
                "side_effect": "read",
                "assistant": false,
                "description": "Cron UI/journal JSON (session + SUPERADMIN_ACCESS). Prefer GET /cron/status with agent_token when no session."
            },
            {
                "id": "core.jobs.habits_reminders",
                "method": "POST",
                "path": "/core/jobs/habits-reminders",
                "permission": "",
                "side_effect": "write",
                "assistant": false,
                "description": "Enqueue due my_tasks habit reminders (also via /cron/tick job habits.reminders). Auth: X-FreeSaaS-Agent-Token. Optional simulate=1. Drain via bots.sends_drain / cron tick."
            },
            {
                "id": "core.modules.list",
                "method": "GET",
                "path": "/modules",
                "permission": "core.modules",
                "side_effect": "read",
                "description": "Installed modules catalog + available[] (remote, not on disk). Filters: q, category, tag, status (incl. available), maturity",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "q": {
                            "type": "string"
                        },
                        "category": {
                            "type": "string",
                            "description": "Match modules that include this category"
                        },
                        "tag": {
                            "type": "string"
                        },
                        "status": {
                            "type": "string",
                            "enum": [
                                "enabled",
                                "disabled",
                                "blocked",
                                "available"
                            ]
                        },
                        "maturity": {
                            "type": "string",
                            "enum": [
                                "alpha",
                                "beta",
                                "release"
                            ]
                        }
                    }
                }
            },
            {
                "id": "core.modules.install",
                "method": "POST",
                "path": "/modules",
                "permission": "core.modules",
                "capability": "SUPERADMIN_ACCESS",
                "side_effect": "write",
                "description": "POST action=install&module=id — download remote module via UpdateEngine (not on disk yet). Stays disabled; then enable.",
                "parameters": {
                    "type": "object",
                    "required": [
                        "module"
                    ],
                    "properties": {
                        "action": {
                            "type": "string",
                            "const": "install"
                        },
                        "module": {
                            "type": "string",
                            "description": "Module id from available[]"
                        }
                    }
                }
            },
            {
                "id": "core.modules.uninstall",
                "method": "POST",
                "path": "/modules",
                "permission": "core.modules",
                "capability": "SUPERADMIN_ACCESS",
                "side_effect": "write",
                "description": "POST action=uninstall&module=id&confirm_uninstall=1 — dump owned tables, DROP them, clear ledger, disable. leave_tables refused. Code stays on disk.",
                "parameters": {
                    "type": "object",
                    "required": [
                        "module",
                        "confirm_uninstall"
                    ],
                    "properties": {
                        "action": {
                            "type": "string",
                            "const": "uninstall"
                        },
                        "module": {
                            "type": "string"
                        },
                        "confirm_uninstall": {
                            "type": "boolean",
                            "description": "Must be true"
                        }
                    }
                }
            },
            {
                "id": "core.modules.get",
                "method": "GET",
                "path": "/modules/{id}",
                "permission": "core.modules",
                "side_effect": "read",
                "description": "One module: catalog blurbs, maturity, deps, provides, screenshots, agent_ops (MCP tool names for that module)",
                "parameters": {
                    "type": "object",
                    "required": [
                        "id"
                    ],
                    "properties": {
                        "id": {
                            "type": "string",
                            "description": "Module id, e.g. banks"
                        }
                    }
                }
            },
            {
                "id": "core.health.detail",
                "method": "GET",
                "path": "/health/detail",
                "permission": "core.modules",
                "side_effect": "read",
                "description": "Detailed health report (read-only). Optional query: module=id. MCP tool core__health__detail.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "module": {
                            "type": "string",
                            "description": "Optional module id filter"
                        }
                    }
                }
            },
            {
                "id": "core.doctor",
                "method": "GET",
                "path": "/doctor",
                "permission": "core.modules",
                "side_effect": "read",
                "description": "Orchestrated diagnose (config/DB/migrate/validate/health/locale) with error_codes + issue_body. Read-only; enable/migrate stay on agent_token. MCP: core__doctor.",
                "parameters": {
                    "type": "object",
                    "properties": []
                }
            },
            {
                "id": "core.help.search",
                "method": "GET",
                "path": "/help",
                "permission": "core.home",
                "side_effect": "read",
                "description": "How-to help index from module runbooks (docs/agents via agent.docs). Filters: q, module. Permission-filtered. Then call core.help.get.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "q": {
                            "type": "string",
                            "description": "Search query (module id, UI terms, headings)"
                        },
                        "module": {
                            "type": "string",
                            "description": "Optional exact module id filter"
                        }
                    }
                }
            },
            {
                "id": "core.help.get",
                "method": "GET",
                "path": "/help/{id}",
                "permission": "core.home",
                "side_effect": "read",
                "description": "How-to runbook markdown for a module (Human UI + ops notes). Path id=module. Optional section=human|all, max_chars. Prefer for «how do I…» before inventing steps.",
                "parameters": {
                    "type": "object",
                    "required": [
                        "id"
                    ],
                    "properties": {
                        "id": {
                            "type": "string",
                            "description": "Module id, e.g. certificates"
                        },
                        "section": {
                            "type": "string",
                            "enum": [
                                "all",
                                "human"
                            ],
                            "description": "human = ## Human UI only when present"
                        },
                        "max_chars": {
                            "type": "integer",
                            "description": "Truncate markdown body (default 16000)"
                        }
                    }
                }
            },
            {
                "id": "core.users.list",
                "method": "GET",
                "path": "/users",
                "permission": "core.users",
                "description": "List staff users; filters: q, enabled, status_id",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "q": {
                            "type": "string"
                        },
                        "enabled": {
                            "type": "string",
                            "description": "1 active, 0 disabled, empty=all"
                        },
                        "status_id": {
                            "type": "integer",
                            "description": "Filter by role ID_STATUS"
                        }
                    }
                }
            },
            {
                "id": "core.users.get",
                "method": "GET",
                "path": "/users/{id}",
                "permission": "core.users",
                "description": "Staff card with permissions map (password omitted)"
            },
            {
                "id": "core.users.get_edit",
                "method": "GET",
                "path": "/users/{id}/edit",
                "permission": "core.users",
                "description": "Edit payload + permission_groups, admin_statuses, partner_statuses; optional copyFrom=userId"
            },
            {
                "id": "core.users.copy_sources",
                "method": "GET",
                "path": "/users/new",
                "permission": "core.users",
                "side_effect": "read",
                "description": "List non-superadmin staff templates for copyFrom (copy_users). Use before clone/create. Superadmin roles are omitted."
            },
            {
                "id": "core.users.create",
                "method": "POST",
                "path": "/users/new",
                "permission": "core.users",
                "side_effect": "write",
                "description": "Create staff user without password. Required: name. Optional login (wins over tel); if login empty, login is derived from tel digits. Optional copyFrom=template userId (non-superadmin only). Server hashes a random password; agents never send/receive passwords.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string",
                            "description": "Full name"
                        },
                        "tel": {
                            "type": "string",
                            "description": "Phone; used as login only when login is empty/unusable"
                        },
                        "mail": {
                            "type": "string"
                        },
                        "login": {
                            "type": "string",
                            "description": "Optional explicit login (wins over tel digits when set)"
                        },
                        "ID_STATUS": {
                            "type": "integer",
                            "description": "Role id"
                        },
                        "ID_STATUS2": {
                            "type": "integer"
                        },
                        "enabled": {
                            "type": "string"
                        },
                        "copyFrom": {
                            "type": "integer",
                            "description": "Non-superadmin template user id"
                        },
                        "NOT_IN_TEAM": {
                            "type": "string"
                        },
                        "ASSIST_TEAM": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "name"
                    ]
                }
            },
            {
                "id": "core.users.clone",
                "method": "POST",
                "path": "/users/new",
                "permission": "core.users",
                "side_effect": "write",
                "description": "Clone a non-superadmin staff template (copyFrom required): role, flags, permissions. Required: name, copyFrom. Prefer tel. No password in or out. Same handler as create.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "copyFrom": {
                            "type": "integer",
                            "description": "Source staff id (not superadmin)"
                        },
                        "name": {
                            "type": "string"
                        },
                        "tel": {
                            "type": "string"
                        },
                        "mail": {
                            "type": "string"
                        },
                        "login": {
                            "type": "string"
                        },
                        "enabled": {
                            "type": "string",
                            "description": "Default 1"
                        }
                    },
                    "required": [
                        "copyFrom",
                        "name"
                    ]
                }
            },
            {
                "id": "core.users.update",
                "method": "POST",
                "path": "/users/{id}/edit",
                "permission": "core.users",
                "side_effect": "write",
                "description": "Update staff user; permissions[key]=1/0; enabled=1/0 to enable/disable. Agent/JSON cannot change password (ignored)."
            },
            {
                "id": "core.statuses.list",
                "method": "GET",
                "path": "/statuses",
                "permission": "core.statuses",
                "description": "List staff roles (base_admin_statuses) with capability flags"
            },
            {
                "id": "core.statuses.get",
                "method": "GET",
                "path": "/statuses/{id}/edit",
                "permission": "core.statuses",
                "description": "One role + editable field groups"
            },
            {
                "id": "core.statuses.create",
                "method": "POST",
                "path": "/statuses/new",
                "permission": "core.statuses",
                "side_effect": "write",
                "description": "Create staff role/status"
            },
            {
                "id": "core.statuses.update",
                "method": "POST",
                "path": "/statuses/{id}/edit",
                "permission": "core.statuses",
                "side_effect": "write",
                "description": "Update staff role/status flags"
            },
            {
                "id": "core.db.status",
                "method": "GET",
                "path": "/db",
                "permission": "core.db",
                "description": "DB hub status: schema setup, owned tables, dumps (?format=json)",
                "assistant": false
            },
            {
                "id": "core.db.run_schema",
                "method": "POST",
                "path": "/db",
                "permission": "core.db",
                "description": "Apply all pending schema migrations (POST action=schema&format=json)",
                "assistant": false
            },
            {
                "id": "core.db.run_data",
                "method": "POST",
                "path": "/db",
                "permission": "core.db",
                "description": "Run data migrators replace mode (POST action=data&format=json; optional)",
                "assistant": false
            },
            {
                "id": "core.db.dump",
                "method": "POST",
                "path": "/db",
                "permission": "core.db",
                "description": "Dump owned tables (POST action=db_dump&format=json)",
                "assistant": false
            },
            {
                "id": "core.db.restore",
                "method": "POST",
                "path": "/db",
                "permission": "core.db",
                "description": "Restore dump file (POST action=db_restore&file=…&format=json; owned allow-list in normal mode)",
                "assistant": false
            },
            {
                "id": "core.db.upload",
                "method": "POST",
                "path": "/db",
                "permission": "core.db",
                "description": "Upload .sql/.sql.gz into var/db_dumps/ (multipart field dump, action=db_upload; does not restore)",
                "assistant": false
            },
            {
                "id": "core.news_statuses.list",
                "method": "GET",
                "path": "/news-statuses",
                "permission": "core.news_statuses",
                "description": "List ticket/news workflow statuses (base_news_statuses): name, type, deadline_policy (optional|required|forbidden for GCal), color, usage count. Not staff ACL /statuses."
            },
            {
                "id": "core.news_statuses.get",
                "method": "GET",
                "path": "/news-statuses/{id}/edit",
                "permission": "core.news_statuses",
                "description": "One news status + usage count + deadline_policies"
            },
            {
                "id": "core.news_statuses.create",
                "method": "POST",
                "path": "/news-statuses/new",
                "permission": "core.news_statuses",
                "side_effect": "write",
                "description": "Create news status. Fields: NAME, TYPE (default 2), DEADLINE_POLICY, COLOR; optional ID for fixed primary key",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "NAME": {
                            "type": "string"
                        },
                        "TYPE": {
                            "type": "integer",
                            "description": "Usually 2 (tickets)"
                        },
                        "DEADLINE_POLICY": {
                            "type": "string",
                            "description": "optional|required|forbidden"
                        },
                        "COLOR": {
                            "type": "string",
                            "description": "#hex or named color"
                        },
                        "ID": {
                            "type": "integer",
                            "description": "Optional fixed primary key"
                        }
                    },
                    "required": [
                        "NAME"
                    ]
                }
            },
            {
                "id": "core.news_statuses.update",
                "method": "POST",
                "path": "/news-statuses/{id}/edit",
                "permission": "core.news_statuses",
                "side_effect": "write",
                "description": "Update news status (NAME/TYPE/DEADLINE_POLICY/COLOR) or action=delete when unused",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "action": {
                            "type": "string",
                            "description": "save (default) | delete"
                        },
                        "NAME": {
                            "type": "string"
                        },
                        "TYPE": {
                            "type": "integer"
                        },
                        "DEADLINE_POLICY": {
                            "type": "string"
                        },
                        "COLOR": {
                            "type": "string"
                        }
                    }
                }
            },
            {
                "id": "core.news.list",
                "method": "GET",
                "path": "/news",
                "permission": "core.news",
                "description": "List news/tickets/DMs (access-filtered). Items include gcal_linked and checklist_progress{done,total,pct} when a checklist exists. Query: type=1|2|3|4, pid=folder, q, status, unread=1, unsigned=1, sort/dir/page",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "integer",
                            "description": "1 articles, 2 tickets, 3 DMs, 4 favorites"
                        },
                        "pid": {
                            "type": "integer",
                            "description": "Folder id; omit for root"
                        },
                        "q": {
                            "type": "string"
                        },
                        "status": {
                            "type": "integer",
                            "description": "Ticket status filter (type=2)"
                        },
                        "unread": {
                            "type": "integer",
                            "description": "1 = flat unread leaves"
                        },
                        "unsigned": {
                            "type": "integer",
                            "description": "1 = flat items needing signature"
                        }
                    }
                }
            },
            {
                "id": "core.news.get",
                "method": "GET",
                "path": "/news/{id}",
                "permission": "core.news",
                "description": "News item JSON: item (incl. comment_purge_limit), checklist[], checklist_progress{done,total,pct}, gcal_linked (TYPE=2), paged comments (text + text_display for habit markers), versions, needs_sign, users_resp. Folders → is_folder+list_path. Comments default: top-level, limit=20, excerpt=500, order=desc; drill comments_pid; page comments_offset; skip comments=0; one row comments_id; full text comments_excerpt=0; omit body body=0.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "comments": {
                            "type": "integer",
                            "description": "0 = omit comments list (count still in comment_count)"
                        },
                        "comments_limit": {
                            "type": "integer",
                            "description": "Page size 1–100, default 20"
                        },
                        "comments_offset": {
                            "type": "integer"
                        },
                        "comments_pid": {
                            "type": "integer",
                            "description": "0 = roots; >0 = direct replies under that comment"
                        },
                        "comments_id": {
                            "type": "integer",
                            "description": "Fetch one comment by id"
                        },
                        "comments_order": {
                            "type": "string",
                            "description": "asc|desc (default desc for roots, asc for replies)"
                        },
                        "comments_excerpt": {
                            "type": "integer",
                            "description": "Max chars per text; 0 = full; default 500"
                        },
                        "body": {
                            "type": "integer",
                            "description": "0 = omit item.body"
                        }
                    }
                }
            },
            {
                "id": "core.news.get_edit",
                "method": "GET",
                "path": "/news/{id}/edit",
                "permission": "core.news",
                "description": "Edit payload + folder options, staff/partner groups for ACCESS_*; fields hint includes SIGN_REQ, COMMENT_PURGE_LIMIT, IGNORE_FOLDER"
            },
            {
                "id": "core.news.create",
                "method": "POST",
                "path": "/news/new",
                "permission": "core.news",
                "side_effect": "write",
                "description": "Create article/ticket/DM/folder. Fields: NAME, SHORT, BIG, TYPE, PID, HAS_CHILDREN, IGNORE_FOLDER, SIGN_REQ, COMMENT_PURGE_LIMIT (0=off; hard-delete oldest over limit), ACCESS_GROUP[], ACCESS_GROUP2[], ACCESS_USER[], STATUS/ID_CURATOR/users_resp/DT_DEADLINE for tickets",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "NAME": {
                            "type": "string"
                        },
                        "TYPE": {
                            "type": "integer"
                        },
                        "BIG": {
                            "type": "string"
                        },
                        "PID": {
                            "type": "integer"
                        },
                        "HAS_CHILDREN": {
                            "type": "integer",
                            "description": "1 = folder (no status/curator/SIGN_REQ)"
                        },
                        "IGNORE_FOLDER": {
                            "type": "integer",
                            "description": "1 = archive folder"
                        },
                        "SIGN_REQ": {
                            "type": "integer",
                            "description": "1 = require acknowledgment comment"
                        },
                        "COMMENT_PURGE_LIMIT": {
                            "type": "integer",
                            "description": "0=off; max comments kept (auto hard-delete oldest regular)"
                        },
                        "ACCESS_GROUP": {
                            "description": "status id[] or #id# list"
                        },
                        "ACCESS_USER": {
                            "description": "user id[]; required for TYPE=3"
                        }
                    },
                    "required": [
                        "NAME"
                    ]
                }
            },
            {
                "id": "core.news.update",
                "method": "POST",
                "path": "/news/{id}/edit",
                "permission": "core.news",
                "side_effect": "write",
                "description": "Update news/folder; keep_signs=1 preserves views/signs when body changes. COMMENT_PURGE_LIMIT (0=off) triggers immediate purge if already over. Folders cannot unset HAS_CHILDREN while children exist.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "NAME": {
                            "type": "string"
                        },
                        "SHORT": {
                            "type": "string"
                        },
                        "BIG": {
                            "type": "string"
                        },
                        "COMMENT_PURGE_LIMIT": {
                            "type": "integer",
                            "description": "0=off; max comments kept"
                        },
                        "SIGN_REQ": {
                            "type": "integer"
                        },
                        "keep_signs": {
                            "type": "integer",
                            "description": "1 = keep views/signs on body change"
                        },
                        "STATUS": {
                            "type": "integer"
                        },
                        "ID_CURATOR": {
                            "type": "integer"
                        },
                        "DT_DEADLINE": {
                            "type": "string",
                            "description": "Y-m-d or empty"
                        },
                        "HAS_CHILDREN": {
                            "type": "integer"
                        },
                        "IGNORE_FOLDER": {
                            "type": "integer"
                        }
                    }
                }
            },
            {
                "id": "core.news.act",
                "method": "POST",
                "path": "/news/{id}",
                "permission": "core.news",
                "side_effect": "write",
                "description": "News item actions. Comments: comment (optional ticket fields; if COMMENT_PURGE_LIMIT set, oldest regular comments may be hard-deleted after add), edit_comment, hide/show/delete_comment. Checklist: checklist_add/toggle/rename/delete/sort_done. Also like, favorite, delete, restore_version.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "action": {
                            "type": "string",
                            "description": "comment|edit_comment|hide_comment|show_comment|delete_comment|checklist_add|checklist_toggle|checklist_rename|checklist_delete|checklist_sort_done|like|favorite|delete|restore_version|color_comment"
                        },
                        "title": {
                            "type": "string",
                            "description": "Checklist item title (add/rename); multiline paste ok for add"
                        },
                        "item_id": {
                            "type": "integer",
                            "description": "Checklist item id"
                        },
                        "done_position": {
                            "type": "string",
                            "description": "checklist_sort_done: top|bottom"
                        },
                        "text": {
                            "type": "string",
                            "description": "Body for comment or edit_comment"
                        },
                        "comment_id": {
                            "type": "integer",
                            "description": "Target comment for edit/hide/show/delete"
                        },
                        "new_sign": {
                            "type": "integer",
                            "description": "1 = acknowledge SIGN_REQ with this comment"
                        },
                        "reply_pid": {
                            "type": "integer",
                            "description": "Parent comment id when replying"
                        },
                        "new_status": {
                            "type": "integer",
                            "description": "Ticket status id; -1 = no change"
                        },
                        "ticket_deadline": {
                            "type": "string",
                            "description": "YYYY-MM-DD ticket deadline"
                        },
                        "id_curator": {
                            "type": "integer",
                            "description": "Ticket curator user id; 0 = clear"
                        },
                        "users_resp": {
                            "description": "Assignee user id[] when users_resp_present=1"
                        },
                        "users_resp_present": {
                            "type": "integer",
                            "description": "1 = apply users_resp (empty clears assignees)"
                        },
                        "price_offer": {
                            "type": "integer",
                            "description": "Contract offer price (comment add/edit)"
                        },
                        "offer_deadline": {
                            "type": "string",
                            "description": "YYYY-MM-DD offer deadline"
                        },
                        "log_id": {
                            "type": "integer",
                            "description": "Version id for restore_version"
                        }
                    },
                    "required": [
                        "action"
                    ]
                }
            },
            {
                "id": "core.settings.get",
                "method": "GET",
                "path": "/settings",
                "permission": "core.settings",
                "side_effect": "read",
                "description": "System settings: company, timezone (IANA), full timezones[] list, has_logo, agent_token_configured (token value not returned). Stored in cfg/config.ini as app.timezone."
            },
            {
                "id": "core.settings.save",
                "method": "POST",
                "path": "/settings",
                "permission": "core.settings",
                "side_effect": "write",
                "description": "Save system settings. JSON may send only changed fields (timezone and/or company); omitted fields stay unchanged. timezone must be a PHP IANA id from GET timezones[]. Applies PHP + MySQL session TZ immediately. Logo upload is UI-only.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "timezone": {
                            "type": "string",
                            "description": "IANA timezone id, e.g. Europe/Berlin, America/New_York, Asia/Tokyo, UTC"
                        },
                        "company": {
                            "type": "string",
                            "description": "Company display name (tab title fallback when no logo)"
                        }
                    }
                }
            }
        ]
    },
