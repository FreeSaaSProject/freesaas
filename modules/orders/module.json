{
    "id": "orders",
    "name": "orders.module.name",
    "description": "orders.module.description",
    "version": "1.0.2",
    "type": "product",
    "runtime": "both",
    "requires": {
        "core": ">=1.0.0",
        "clients": ">=1.0.0"
    },
    "optionalRequires": {
        "catalog": ">=1.0.0",
        "procedures": ">=1.0.0",
        "sites": ">=1.0.0",
        "booking": ">=1.0.0",
        "bots": ">=1.0.0"
    },
    "provides": [
        "orders.list",
        "orders.for_day",
        "orders.create"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "orders.view",
            "label": "orders.perm.view"
        },
        {
            "id": "orders.edit",
            "label": "orders.perm.edit"
        },
        {
            "id": "orders.delete",
            "label": "orders.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/orders",
            "/orders/{id}",
            "/orders/{id}/edit",
            "/orders/settings"
        ]
    },
    "agent": {
        "docs": "docs/agents/orders.md",
        "ops": [
            {
                "id": "orders.list",
                "method": "GET",
                "path": "/orders",
                "permission": "orders.view",
                "description": "List website orders; filters: q, status, id_user, id_promocode, free_ticket, staff (assigned master id), date_from/date_to (visit date, inclusive), active=1 (skip cancelled/complete/deleted), page=all. Items include dt_event_date/dt_event_time"
            },
            {
                "id": "orders.get",
                "method": "GET",
                "path": "/orders/{id}",
                "permission": "orders.view",
                "description": "One order with decoded cart lines and linked procedure summary if any"
            },
            {
                "id": "orders.get_edit",
                "method": "GET",
                "path": "/orders/{id}/edit",
                "permission": "orders.edit",
                "description": "Order edit payload with staff options and status choices"
            },
            {
                "id": "orders.update",
                "method": "POST",
                "path": "/orders/{id}/edit",
                "permission": "orders.edit",
                "description": "Update order (patch): required id; send only changed fields — omitted status, cart, sums, client, date keep stored values. Reassign master = {id, id_cosmetolog} (alias staff). Other fields: status, dt_event (Y-m-d H:i), id_user, phone, mail, comment, summ, summ_real, id_promocode, text_promocode, free_ticket, cart_id[]/cart_price[]",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "integer"
                        },
                        "id_cosmetolog": {
                            "type": "integer",
                            "description": "Assigned master (staff user id)"
                        },
                        "status": {
                            "type": "string"
                        },
                        "dt_event": {
                            "type": "string",
                            "description": "Y-m-d H:i"
                        },
                        "comment": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "id"
                    ]
                }
            },
            {
                "id": "orders.delete",
                "method": "POST",
                "path": "/orders/{id}/edit",
                "permission": "orders.delete",
                "side_effect": "write",
                "description": "Delete order; POST action=delete if not linked via ID_EVENT_USE"
            }
        ],
        "relations": [
            {
                "id": "orders.vacation_orders",
                "when": [
                    "vacations.create",
                    "vacations.update"
                ],
                "from": "vacations.get",
                "check": "orders.list",
                "args": {
                    "staff": "{user_id}",
                    "date_from": "{dt_start|date}",
                    "date_to": "{dt_end|date}",
                    "active": "1",
                    "page": "all"
                },
                "suggest": [
                    "orders.update"
                ],
                "fields": [
                    "dt_event_date",
                    "dt_event_time",
                    "client_name",
                    "phone",
                    "status",
                    "summ_real"
                ],
                "hint": "orders.relation.absence_orders",
                "notice": "orders.relation.absence_orders.notice"
            },
            {
                "id": "orders.shift_removed_orders",
                "when": [
                    "workweeks.delete"
                ],
                "from": "workweeks.get",
                "check": "orders.list",
                "args": {
                    "staff": "{from.id_operator}",
                    "date_from": "{from.date}",
                    "date_to": "{from.date}",
                    "active": "1",
                    "page": "all"
                },
                "suggest": [
                    "orders.update"
                ],
                "fields": [
                    "dt_event_date",
                    "dt_event_time",
                    "client_name",
                    "phone",
                    "status",
                    "summ_real"
                ],
                "hint": "orders.relation.absence_orders",
                "notice": "orders.relation.absence_orders.notice"
            },
            {
                "id": "orders.shift_reassigned_orders",
                "when": [
                    "workweeks.update"
                ],
                "if": {
                    "id_operator": "changed"
                },
                "from": "workweeks.get",
                "check": "orders.list",
                "args": {
                    "staff": "{from.id_operator}",
                    "date_from": "{from.date}",
                    "date_to": "{from.date}",
                    "active": "1",
                    "page": "all"
                },
                "suggest": [
                    "orders.update"
                ],
                "fields": [
                    "dt_event_date",
                    "dt_event_time",
                    "client_name",
                    "phone",
                    "status",
                    "summ_real"
                ],
                "hint": "orders.relation.shift_reassigned_orders",
                "notice": "orders.relation.shift_reassigned_orders.notice"
            },
            {
                "id": "orders.user_disabled_orders",
                "when": [
                    "core.users.update"
                ],
                "if": {
                    "enabled": "0"
                },
                "check": "orders.list",
                "args": {
                    "staff": "{id}",
                    "date_from": "{today}",
                    "active": "1",
                    "page": "all"
                },
                "suggest": [
                    "orders.update"
                ],
                "fields": [
                    "dt_event_date",
                    "dt_event_time",
                    "client_name",
                    "phone",
                    "status",
                    "summ_real"
                ],
                "hint": "orders.relation.absence_orders",
                "notice": "orders.relation.absence_orders.notice"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "calendar.menu.group",
            "num": 25,
            "kind": "work",
            "path": "/orders",
            "title": "orders.menu.list",
            "permission": "orders.view"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_orders"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "core.notices.collect",
            "core.bulk.check_item",
            "core.dashboard.catalog",
            "core.dashboard.widgets",
            "calendar.day.stats",
            "calendar.settings.sections",
            "calendar.settings.save",
            "orders.client.arrived"
        ],
        "publish": [
            "orders.created",
            "orders.cancelled",
            "orders.completed",
            "orders.client.arrived",
            "orders.sources"
        ]
    },
    "catalog": {
        "categories": [
            "booking",
            "site"
        ],
        "maturity": "release",
        "tags": [],
        "screenshots": []
    },
    "setup": {
        "steps": [
            {
                "id": "config",
                "title": "orders.setup.step.config",
                "description": "orders.setup.step.config_help",
                "href": "/orders/settings",
                "ask_user": "orders.setup.ask.config",
                "choices": [
                    {
                        "id": "open",
                        "label": "orders.setup.choice.open",
                        "recommended": true
                    },
                    {
                        "id": "defer",
                        "label": "core.modules.setup.choice.defer",
                        "recommended": false
                    }
                ],
                "agent_can": []
            }
        ]
    }
}
