{
    "id": "orders",
    "name": "orders.module.name",
    "version": "0.1.0",
    "type": "product",
    "requires": {
        "core": ">=0.3.0",
        "clients": ">=0.1.0"
    },
    "optionalRequires": {
        "catalog": ">=0.1.0",
        "procedures": ">=0.1.0"
    },
    "provides": [
        "orders.list",
        "orders.for_day"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "orders.view",
            "label": "orders.perm.view"
        },
        {
            "id": "orders.edit",
            "label": "orders.perm.edit"
        }
    ],
    "routes": {
        "pages": [
            "/orders",
            "/orders/{id}",
            "/orders/{id}/edit"
        ]
    },
    "agent": {
        "ops": [
            {
                "id": "orders.list",
                "method": "GET",
                "path": "/orders",
                "permission": "orders.view",
                "description": "List website orders; filters: q, status, id_user, id_promocode, free_ticket"
            },
            {
                "id": "orders.get",
                "method": "GET",
                "path": "/orders/{id}",
                "permission": "orders.view",
                "description": "One order with decoded cart lines and linked procedure summary if any"
            },
            {
                "id": "orders.get_edit",
                "method": "GET",
                "path": "/orders/{id}/edit",
                "permission": "orders.edit",
                "description": "Order edit payload with staff options and status choices"
            },
            {
                "id": "orders.update",
                "method": "POST",
                "path": "/orders/{id}/edit",
                "permission": "orders.edit",
                "description": "Update order status, cosmetologist, comment, mail, free_ticket"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "likespa.menu.group",
            "num": 20,
            "path": "/orders",
            "title": "orders.menu.list"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_orders"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "core.notices.collect",
            "core.bulk.check_item",
            "core.dashboard.catalog",
            "core.dashboard.widgets",
            "calendar.day.stats"
        ],
        "publish": []
    },
    "catalog": {
        "categories": [
            "site",
            "crm"
        ],
        "maturity": "beta",
        "tags": [],
        "screenshots": []
    }
}
