            "/laundry/settings",
            "/laundry/moves",
            "/laundry/shipments",
            "/laundry/ship",
            "/laundry/accept",
            "/laundry/inventory"
        ]
    },
    "agent": {
        "docs": "docs/agents/laundry.md",
        "ops": [
            {
                "id": "laundry.moves.list",
                "method": "GET",
                "path": "/laundry/moves",
                "permission": "laundry.view",
                "description": "List laundry moves; balances matrix"
            },
            {
                "id": "laundry.shipments.list",
                "method": "GET",
                "path": "/laundry/shipments",
                "permission": "laundry.view",
                "description": "List shipments (open/partial/closed)"
            },
            {
                "id": "laundry.ship.create",
                "method": "POST",
                "path": "/laundry/ship",
                "permission": "laundry.ship",
                "description": "Create outbound shipment with lines"
            },
            {
                "id": "laundry.accept.create",
                "method": "POST",
                "path": "/laundry/accept",
                "permission": "laundry.ship",
                "description": "Accept return against open shipment lines"
            },
            {
                "id": "laundry.inventory.apply",
                "method": "POST",
                "path": "/laundry/inventory",
                "permission": "laundry.edit",
                "description": "Set absolute stock per account×type (opening or recount)"
            }
        ]
    },
