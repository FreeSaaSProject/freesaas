{
    "id": "video",
    "name": "video.module.name",
    "description": "video.module.description",
    "version": "0.1.2",
    "type": "product",
    "requires": {
        "core": ">=1.0.0"
    },
    "optionalRequires": {
        "bots": ">=1.0.0",
        "video_label": ">=0.1.0"
    },
    "provides": [
        "video.jobs",
        "video.cameras"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "video.view",
            "label": "video.perm.view"
        },
        {
            "id": "video.edit",
            "label": "video.perm.edit"
        },
        {
            "id": "video.delete",
            "label": "video.perm.delete"
        }
    ],
    "routes": {
        "pages": [
            "/video",
            "/video/status",
            "/video/cameras",
            "/video/cameras/new",
            "/video/cameras/{id}/edit",
            "/video/cameras/{id}/live",
            "/video/models",
            "/video/alerts",
            "/video/media",
            "/video/settings",
            "/video/worker/hello",
            "/video/worker/claim",
            "/video/worker/result",
            "/video/worker/file",
            "/video/worker/frame"
        ]
    },
    "agent": {
        "docs": "docs/agents/video.md",
        "ops": [
            {
                "id": "video.status",
                "method": "GET",
                "path": "/video/status",
                "permission": "video.view",
                "side_effect": "read",
                "description": "Diagnose: workers online, token masked, cameras/models, pending jobs, issues[], agent_next[]"
            },
            {
                "id": "video.dashboard",
                "method": "GET",
                "path": "/video",
                "permission": "video.view",
                "side_effect": "read",
                "description": "Dashboard: workers, cameras (no RTSP), jobs, alerts, storage_bytes"
            },
            {
                "id": "video.cameras.list",
                "method": "GET",
                "path": "/video/cameras",
                "permission": "video.view",
                "side_effect": "read",
                "description": "List cameras (publicView: rtsp_hint only, no credentials)"
            },
            {
                "id": "video.cameras.get",
                "method": "GET",
                "path": "/video/cameras/{id}/edit",
                "permission": "video.edit",
                "side_effect": "read",
                "description": "Camera edit payload including RTSP_URL (edit only)"
            },
            {
                "id": "video.cameras.create",
                "method": "POST",
                "path": "/video/cameras/new",
                "permission": "video.edit",
                "side_effect": "write",
                "description": "Create camera; fields: name, rtsp_url, mode, model_id, enabled, conf_threshold, iou_threshold, interval_sec, crop_height_pct, rotate_deg, dataset_project_id",
                "parameters": {
                    "type": "object",
                    "required": ["name", "rtsp_url"],
                    "properties": {
                        "name": { "type": "string" },
                        "rtsp_url": { "type": "string" },
                        "mode": { "type": "string", "description": "monitoring|dataset" },
                        "model_id": { "type": "integer" },
                        "enabled": { "type": "boolean" },
                        "conf_threshold": { "type": "number" },
                        "iou_threshold": { "type": "number" },
                        "interval_sec": { "type": "integer" }
                    }
                }
            },
            {
                "id": "video.cameras.update",
                "method": "POST",
                "path": "/video/cameras/{id}/edit",
                "permission": "video.edit",
                "side_effect": "write",
                "description": "Update camera (same fields as create)"
            },
            {
                "id": "video.cameras.delete",
                "method": "POST",
                "path": "/video/cameras/{id}/edit",
                "permission": "video.delete",
                "side_effect": "write",
                "description": "Delete camera; POST action=delete"
            },
            {
                "id": "video.cameras.enqueue_monitor",
                "method": "POST",
                "path": "/video/cameras",
                "permission": "video.view",
                "side_effect": "write",
                "description": "Enqueue monitor_tick for camera; POST action=enqueue_monitor&id=",
                "parameters": {
                    "type": "object",
                    "required": ["id"],
                    "properties": {
                        "action": { "type": "string", "const": "enqueue_monitor" },
                        "id": { "type": "integer" }
                    }
                }
            },
            {
                "id": "video.cameras.enqueue_ondemand",
                "method": "POST",
                "path": "/video/cameras",
                "permission": "video.view",
                "side_effect": "write",
                "description": "Enqueue on_demand infer; POST action=enqueue_ondemand&id=",
                "parameters": {
                    "type": "object",
                    "required": ["id"],
                    "properties": {
                        "action": { "type": "string", "const": "enqueue_ondemand" },
                        "id": { "type": "integer" }
                    }
                }
            },
            {
                "id": "video.cameras.live",
                "method": "GET",
                "path": "/video/cameras/{id}/live",
                "permission": "video.view",
                "side_effect": "read",
                "description": "Latest annotated/frame URLs + detections (no RTSP)"
            },
            {
                "id": "video.models.list",
                "method": "GET",
                "path": "/video/models",
                "permission": "video.edit",
                "side_effect": "read",
                "description": "List registered YOLO models + label projects for train"
            },
            {
                "id": "video.models.register",
                "method": "POST",
                "path": "/video/models",
                "permission": "video.edit",
                "side_effect": "write",
                "description": "Register model; action=save name= weights_path= (path on Mac worker) classes= notes=",
                "parameters": {
                    "type": "object",
                    "required": ["name", "weights_path"],
                    "properties": {
                        "action": { "type": "string", "const": "save" },
                        "name": { "type": "string" },
                        "weights_path": { "type": "string" },
                        "classes": { "type": "string", "description": "Newline or comma separated" },
                        "notes": { "type": "string" }
                    }
                }
            },
            {
                "id": "video.models.delete",
                "method": "POST",
                "path": "/video/models",
                "permission": "video.edit",
                "side_effect": "write",
                "description": "Delete model; action=delete&id="
            },
            {
                "id": "video.models.train",
                "method": "POST",
                "path": "/video/models",
                "permission": "video.edit",
                "side_effect": "write",
                "description": "Enqueue train; action=enqueue_train project_id= base_weights= model_name= epochs= imgsz= (ships export zip to worker)",
                "parameters": {
                    "type": "object",
                    "required": ["project_id"],
                    "properties": {
                        "action": { "type": "string", "const": "enqueue_train" },
                        "project_id": { "type": "integer" },
                        "base_weights": { "type": "string" },
                        "model_name": { "type": "string" },
                        "epochs": { "type": "integer" },
                        "imgsz": { "type": "integer" }
                    }
                }
            },
            {
                "id": "video.alerts.list",
                "method": "GET",
                "path": "/video/alerts",
                "permission": "video.view",
                "side_effect": "read",
                "description": "Alert journal; optional camera_id="
            },
            {
                "id": "video.settings.get",
                "method": "GET",
                "path": "/video/settings",
                "permission": "SUPERADMIN_ACCESS",
                "side_effect": "read",
                "description": "Worker token (masked) + retention; auto-generates token once (director)"
            },
            {
                "id": "video.settings.save",
                "method": "POST",
                "path": "/video/settings",
                "permission": "SUPERADMIN_ACCESS",
                "side_effect": "write",
                "description": "Save retention/token; regenerate_token=1 returns new_token once",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "regenerate_token": { "type": "boolean" },
                        "worker_token": { "type": "string" },
                        "retention_days": { "type": "integer" },
                        "max_storage_mb": { "type": "integer" },
                        "keep_alert_media": { "type": "boolean" },
                        "latest_frame_ring": { "type": "integer" },
                        "purge_mode": { "type": "string", "description": "default|alerts_only" }
                    }
                }
            },
            {
                "id": "video.settings.purge",
                "method": "POST",
                "path": "/video/settings",
                "permission": "SUPERADMIN_ACCESS",
                "side_effect": "write",
                "description": "Run retention purge now; POST run_purge=1"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "video.menu.group",
            "num": 1,
            "path": "/video",
            "title": "video.menu.dashboard",
            "kind": "work"
        },
        {
            "group": "video.menu.group",
            "num": 2,
            "path": "/video/cameras",
            "title": "video.menu.cameras",
            "kind": "work"
        },
        {
            "group": "video.menu.group",
            "num": 3,
            "path": "/video/alerts",
            "title": "video.menu.alerts",
            "kind": "work"
        },
        {
            "group": "video.menu.group",
            "num": 4,
            "path": "/video/models",
            "title": "video.menu.models",
            "kind": "crud"
        },
        {
            "group": "video.menu.group",
            "num": 90,
            "path": "/video/settings",
            "title": "video.menu.settings",
            "kind": "settings"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_video_workers",
        "base_video_models",
        "base_video_cameras",
        "base_video_jobs",
        "base_video_alerts",
        "base_video_detections"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [],
        "publish": [
            "video.alert.created"
        ]
    },
    "catalog": {
        "categories": [
            "integrations"
        ],
        "maturity": "alpha",
        "tags": [
            "integration",
            "jobs"
        ],
        "screenshots": []
    }
}
