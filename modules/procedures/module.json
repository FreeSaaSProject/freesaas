{
    "id": "procedures",
    "name": "procedures.module.name",
    "description": "procedures.module.description",
    "version": "0.1.17",
    "type": "product",
    "runtime": "both",
    "requires": {
        "core": ">=0.3.0",
        "clients": ">=0.1.0",
        "catalog": ">=0.1.0"
    },
    "optionalRequires": {
        "tables": ">=0.1.0",
        "bots": ">=0.1.0",
        "procents": ">=0.1.0",
        "workweeks": ">=0.1.0"
    },
    "provides": [
        "procedures.list",
        "procedures.types"
    ],
    "migrations": "migrations/",
    "permissions": [
        {
            "id": "procedures.view",
            "label": "procedures.perm.view"
        },
        {
            "id": "procedures.edit",
            "label": "procedures.perm.edit"
        },
        {
            "id": "procedures.types",
            "label": "procedures.perm.types"
        },
        {
            "id": "procedures.delete",
            "label": "procedures.perm.delete"
        },
        {
            "id": "procedures.types.delete",
            "label": "procedures.perm.types_delete"
        }
    ],
    "routes": {
        "pages": [
            "/procedures",
            "/procedures/day-stats",
            "/procedures/new",
            "/procedures/{id}",
            "/procedures/{id}/edit",
            "/procedure-types",
            "/procedure-types/new",
            "/procedure-types/{id}/edit"
        ]
    },
    "agent": {
        "docs": "docs/agents/procedures.md",
        "ops": [
            {
                "id": "procedures.list",
                "method": "GET",
                "path": "/procedures",
                "permission": "procedures.view",
                "side_effect": "read",
                "description": "List procedures journal; filters: q, enabled, restored, type, date_from, date_to, id_user, id_good, id_admin, id_operator"
            },
            {
                "id": "procedures.get_edit",
                "method": "GET",
                "path": "/procedures/{id}/edit",
                "permission": "procedures.edit",
                "side_effect": "read",
                "description": "Procedure edit payload + procedure_types/staff dictionaries; new at /procedures/new"
            },
            {
                "id": "procedures.create",
                "method": "POST",
                "path": "/procedures/new",
                "permission": "procedures.edit",
                "side_effect": "write",
                "description": "Create procedure journal row; returns {ok,id,item}"
            },
            {
                "id": "procedures.update",
                "method": "POST",
                "path": "/procedures/{id}/edit",
                "permission": "procedures.edit",
                "side_effect": "write",
                "description": "Update procedure journal row; returns {ok,id,item}"
            },
            {
                "id": "procedures.types.list",
                "method": "GET",
                "path": "/procedure-types",
                "permission": "procedures.types",
                "side_effect": "read",
                "description": "List procedure types (base_procedure_types)"
            },
            {
                "id": "procedures.types.get_edit",
                "method": "GET",
                "path": "/procedure-types/{id}/edit",
                "permission": "procedures.types",
                "side_effect": "read",
                "description": "Procedure type edit payload; new at /procedure-types/new"
            },
            {
                "id": "procedures.types.create",
                "method": "POST",
                "path": "/procedure-types/new",
                "permission": "procedures.types",
                "side_effect": "write",
                "description": "Create procedure type; returns {ok,id,item}. Form: type (required), subtype, descr, bonus_procent, multiwork, photo_req, is_medical, parallels, bonus_procent_out, site_amo_show, cons_req_amo",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "description": "Type name"
                        },
                        "subtype": {
                            "type": "integer"
                        },
                        "descr": {
                            "type": "string"
                        },
                        "bonus_procent": {
                            "type": "number"
                        },
                        "parallels": {
                            "type": "integer"
                        },
                        "multiwork": {
                            "type": "string",
                            "description": "1 to enable"
                        },
                        "photo_req": {
                            "type": "string"
                        },
                        "is_medical": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "type"
                    ]
                }
            },
            {
                "id": "procedures.types.update",
                "method": "POST",
                "path": "/procedure-types/{id}/edit",
                "permission": "procedures.types",
                "side_effect": "write",
                "description": "Update procedure type; returns {ok,id,item}"
            },
            {
                "id": "procedures.day_stats",
                "method": "GET",
                "path": "/procedures/day-stats",
                "permission": "procedures.view",
                "side_effect": "read",
                "description": "Day procedure revenue and operator stats; query day=YYYY-MM-DD, optional staff=userId",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "day": {
                            "type": "string",
                            "description": "YYYY-MM-DD"
                        },
                        "staff": {
                            "type": "integer",
                            "description": "Optional staff user id filter"
                        }
                    },
                    "required": [
                        "day"
                    ]
                }
            },
            {
                "id": "procedures.delete",
                "method": "POST",
                "path": "/procedures/{id}/edit",
                "permission": "procedures.delete",
                "side_effect": "write",
                "description": "Delete procedure journal row; POST action=delete"
            }
        ]
    },
    "jobs": [],
    "menu": [
        {
            "group": "procedures.menu.group",
            "num": 1,
            "path": "/procedures",
            "title": "procedures.menu.list"
        },
        {
            "group": "procedures.menu.group",
            "kind": "crud",
            "num": 1,
            "path": "/procedure-types",
            "title": "procedures.menu.types"
        }
    ],
    "configSchema": [],
    "tables": [
        "base_procedure_types",
        "base_procedures",
        "base_procedure_restores"
    ],
    "migrators": [],
    "hooks": {
        "subscribe": [
            "core.bulk.check_item",
            "calendar.day.stats",
            "core.user_edit.sections",
            "core.user_edit.save"
        ],
        "publish": [
            "bots.send",
            "procedures.list.row"
        ]
    },
    "bulkActions": [
        {
            "list_id": "procedures",
            "action": "delete"
        },
        {
            "list_id": "procedures",
            "action": "set_admin"
        },
        {
            "list_id": "procedure_types",
            "action": "delete"
        }
    ],
    "catalog": {
        "categories": [
            "wellness"
        ],
        "maturity": "beta",
        "tags": [],
        "screenshots": []
    }
}
