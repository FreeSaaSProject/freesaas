{
  "v": 1,
  "id": "doctor_avg_check",
  "title": "Doctor average check",
  "requires": ["procedures"],
  "queries": [
    {
      "as": "procs_raw",
      "from": "procedures",
      "where": [
        {"field": "summ", "op": ">", "value": 0},
        {"field": "enabled", "op": ">", "value": 0}
      ],
      "select": [
        {"field": "id", "as": "proc_id"},
        {"field": "id_operator", "as": "id_operator"},
        {"field": "id_user", "as": "id_user"},
        {"field": "summ", "as": "summ"}
      ],
      "limit": 100000
    }
  ],
  "derive": [
    {
      "as": "by_op",
      "from": "procs_raw",
      "group_by": ["id_operator"],
      "aggs": [
        {"op": "count", "field": "proc_id", "as": "procs"},
        {"op": "sum", "field": "summ", "as": "revenue"},
        {"op": "avg", "field": "summ", "as": "avg_check"},
        {"op": "count_distinct", "field": "id_user", "as": "guests"}
      ]
    }
  ],
  "sections": [
    {
      "type": "table",
      "title": "Average check by specialist",
      "from": "by_op",
      "columns": [
        {"id": "id_operator", "label": "Operator", "format": "user_badge"},
        {"id": "procs", "label": "Procedures"},
        {"id": "guests", "label": "Guests"},
        {"id": "revenue", "label": "Revenue"},
        {"id": "avg_check", "label": "Avg check"}
      ]
    }
  ]
}
