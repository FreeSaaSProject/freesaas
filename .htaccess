Options -Indexes
DirectorySlash Off
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass Authorization to PHP (CGI/Apache often drops it otherwise).
  RewriteCond %{HTTP:Authorization} .
  RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Allow static assets shipped inside modules (css/js/images/fonts only).
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^modules/[^/]+/assets/.+\.(css|js|png|jpe?g|gif|svg|webp|woff2?)$ - [L]

  # /modules collides with the on-disk modules/ directory (Apache 403 with -Indexes).
  # Always send it (and anything under it) to the front controller; never serve PHP from there.
  RewriteRule ^modules/?$ index.php [L,QSA]
  RewriteRule ^modules/ index.php [L,QSA]

  # Block direct web access to internals
  RewriteRule ^(app|cfg|bin|docs)/ - [F,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>
