Options -Indexes
DirectorySlash Off
# Worker frame uploads (base64 JSON) can exceed default tiny SSL/body caps.
LimitRequestBody 16777216
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass Authorization to PHP (CGI/Apache often drops it otherwise).
  RewriteCond %{HTTP:Authorization} .
  RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Shared-tree storefront hosts (ISPmanager often has no vhost SetEnv).
  # Admin: freesaas.likespa.ru (and www) stay unset → index.php.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(?:likespa\.ru|balance-spa\.ru)\.?$ [NC]
  RewriteRule ^ - [E=FREESAAS_FRONT:site]

  # `/` is a real directory — rewrite !-d does not run; DirectoryIndex may be wrong
  # (ISPmanager often puts site.php first on every WWW). Force front controller by role.
  RewriteCond %{ENV:FREESAAS_FRONT} ^site$ [NC]
  RewriteRule ^$ site.php [L,QSA]
  RewriteCond %{ENV:FREESAAS_FRONT} !^site$ [NC]
  RewriteRule ^$ index.php [L,QSA]

  # Allow static assets shipped inside modules (css/js/images/fonts only).
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^modules/[^/]+/assets/.+\.(css|js|png|jpe?g|gif|svg|webp|woff2?|ttf|otf|eot)$ - [L]

  # Storefront themes (themes/<id>/assets/…). Fonts: woff/woff2/ttf/otf/eot.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^themes/[^/]+/assets/.+\.(css|js|png|jpe?g|gif|svg|webp|woff2?|ttf|otf|eot)$ - [L]

  # /modules collides with the on-disk modules/ directory (Apache 403 with -Indexes).
  # Always send it (and anything under it) to the front controller; never serve PHP from there.
  RewriteCond %{ENV:FREESAAS_FRONT} ^site$ [NC]
  RewriteRule ^modules/?$ site.php [L,QSA]
  RewriteCond %{ENV:FREESAAS_FRONT} ^site$ [NC]
  RewriteRule ^modules/ site.php [L,QSA]
  RewriteCond %{ENV:FREESAAS_FRONT} !^site$ [NC]
  RewriteRule ^modules/?$ index.php [L,QSA]
  RewriteCond %{ENV:FREESAAS_FRONT} !^site$ [NC]
  RewriteRule ^modules/ index.php [L,QSA]

  # Block direct web access to internals (themes PHP/layouts stay private).
  # var/ holds sessions, dumps, job locks — must not be HTTP-readable.
  # .git/ — clone deploys must not expose the repo over HTTP.
  RewriteRule ^(app|cfg|bin|docs|var|log)/ - [F,L]
  RewriteRule ^\.git(/|$) - [F,L]
  RewriteRule ^themes/[^/]+/(layouts|views|partials)/ - [F,L]

  # Legacy 1C proxy PATH_INFO (/api1c.php/client_by_card) → front controller.
  # Exact /api1c.php is also covered (no on-disk stub). Keep ahead of !-f catch-all.
  RewriteCond %{ENV:FREESAAS_FRONT} ^site$ [NC]
  RewriteRule ^api1c\.php(?:/.*)?$ site.php [L,QSA]
  RewriteCond %{ENV:FREESAAS_FRONT} !^site$ [NC]
  RewriteRule ^api1c\.php(?:/.*)?$ index.php [L,QSA]

  # Front controller: default index.php (admin).
  # Storefront: FREESAAS_FRONT=site from Host rule above, or vhost SetEnv / htaccess.storefront.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{ENV:FREESAAS_FRONT} ^site$ [NC]
  RewriteRule ^ site.php [L,QSA]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>
